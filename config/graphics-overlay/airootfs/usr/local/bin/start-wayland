#!/usr/bin/env bash
set -Eeuo pipefail

if (( EUID == 0 )) || [[ "$(id -un)" != seyrix ]]; then
  echo "Start Wayland from the unprivileged seyrix console account." >&2
  exit 2
fi

if [[ "$(tty 2>/dev/null || true)" != /dev/tty1 ]]; then
  echo "Start Wayland from local console tty1." >&2
  exit 2
fi

if ! systemctl is-active --quiet systemd-logind; then
  echo "systemd-logind is not active; refusing direct device access." >&2
  exit 1
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export WAYLAND_DISPLAY="wayland-seyrix"
export LIBSEAT_BACKEND=logind
export LIBGL_ALWAYS_SOFTWARE=1

socket_path="${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}"
gl_log="/tmp/seyrix-weston-gl.log"
pixman_log="/tmp/seyrix-weston-pixman.log"
status_file="/tmp/seyrix-weston-status.txt"
ready_file="${XDG_RUNTIME_DIR}/seyrix-wayland-ready"
compositor_pid=""

select_drm_device() {
  local sys_card card driver_path driver
  for sys_card in /sys/class/drm/card[0-9]*; do
    [[ -e "$sys_card" ]] || continue
    card="/dev/dri/${sys_card##*/}"
    [[ -c "$card" ]] || continue
    driver_path="$(readlink -f "$sys_card/device/driver" 2>/dev/null || true)"
    driver="${driver_path##*/}"
    case "$driver" in
      simpledrm|simple-framebuffer) continue ;;
    esac
    printf '%s\n' "$card"
    return 0
  done

  for card in /dev/dri/card[0-9]*; do
    if [[ -c "$card" ]]; then
      printf '%s\n' "$card"
      return 0
    fi
  done
  return 1
}

drm_device="$(select_drm_device)" || {
  echo "No DRM/KMS card device is available; refusing to start a headless session." >&2
  exit 1
}

stop_compositor() {
  rm -f "$ready_file"
  if [[ -n "$compositor_pid" ]] && kill -0 "$compositor_pid" 2>/dev/null; then
    kill -TERM "$compositor_pid" 2>/dev/null || true
    wait "$compositor_pid" || true
  fi
}
trap stop_compositor EXIT INT TERM

start_compositor() {
  local renderer="$1"
  local log_file="$2"
  rm -f "$socket_path"
  weston \
    --backend=drm \
    --drm-device="${drm_device##*/}" \
    --renderer="$renderer" \
    --socket="$WAYLAND_DISPLAY" \
    --idle-time=0 \
    --log="$log_file" &
  compositor_pid=$!

  for _ in $(seq 1 80); do
    if [[ -S "$socket_path" ]]; then
      printf 'device=%s\nrenderer=%s\nlog=%s\n' "$drm_device" "$renderer" "$log_file" > "$status_file"
      return 0
    fi
    if ! kill -0 "$compositor_pid" 2>/dev/null; then
      wait "$compositor_pid" || true
      compositor_pid=""
      return 1
    fi
    sleep 0.25
  done

  kill -TERM "$compositor_pid" 2>/dev/null || true
  wait "$compositor_pid" || true
  compositor_pid=""
  return 1
}

if ! start_compositor gl "$gl_log"; then
  echo "Mesa GL renderer unavailable; starting Weston Pixman software renderer."
  if ! start_compositor pixman "$pixman_log"; then
    echo "Weston DRM backend could not start. Logs: $gl_log and $pixman_log" >&2
    exit 1
  fi
fi

weston-terminal &
terminal_pid=$!
touch "$ready_file"
wait "$terminal_pid"
