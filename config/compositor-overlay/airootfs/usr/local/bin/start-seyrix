#!/usr/bin/env bash
set -Eeuo pipefail

if (( EUID == 0 )) || [[ "$(id -un)" != seyrix ]]; then
  echo "Start Seyrix from the unprivileged seyrix console account." >&2
  exit 2
fi

if [[ "$(tty 2>/dev/null || true)" != /dev/tty1 ]]; then
  echo "Start Seyrix from local console tty1." >&2
  exit 2
fi

if ! systemctl is-active --quiet systemd-logind; then
  echo "systemd-logind is not active; refusing direct device access." >&2
  exit 1
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ ! -d "$XDG_RUNTIME_DIR" || ! -O "$XDG_RUNTIME_DIR" ]]; then
  echo "XDG_RUNTIME_DIR is missing or owned by another user." >&2
  exit 1
fi

if ! command -v flock >/dev/null 2>&1; then
  echo "flock is unavailable; refusing to start an unguarded Seyrix session." >&2
  exit 1
fi

if [[ ! -x /usr/bin/seyrix-compositor || ! -x /usr/bin/weston-terminal ||
		! -x /usr/bin/seyrix-shell ]]; then
  echo "Seyrix compositor, panel, or weston-terminal is missing from this image." >&2
  exit 1
fi

unset WAYLAND_DISPLAY
export LIBSEAT_BACKEND=logind
export LIBGL_ALWAYS_SOFTWARE=1
export WLR_RENDERER_ALLOW_SOFTWARE=1
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Seyrix

exec > >(tee /tmp/seyrix-compositor.log) 2>&1
if flock --nonblock --conflict-exit-code 75 --close \
		"$XDG_RUNTIME_DIR/seyrix-session.lock" /usr/bin/seyrix-compositor; then
	exit 0
else
	status=$?
	if (( status == 75 )); then
		echo "A Seyrix session already owns this user runtime directory." >&2
	fi
	exit "$status"
fi
