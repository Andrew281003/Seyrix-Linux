+		"SEYRIX_SETTINGS_TRACE monotonic_ns=%llu pid=%ld event=%s page=%s selected=%s mapped=%d\n",
+		(unsigned long long)monotonic_ns, (long)getpid(), event,
+		page != NULL ? page : "none",
+		selected != NULL ? selected : "none",
+		widget != NULL && gtk_widget_get_mapped(widget));
+	fflush(stderr);
