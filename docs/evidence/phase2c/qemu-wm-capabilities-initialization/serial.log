  printf 'KERNEL='; uname -r
  printf 'ROOT_FS='; findmnt -n -o FSTYPE /
  printf 'PID1='; ps -p 1 -o comm= | tr -d ' '
  printf 'SYSTEMD='; systemctl is-system-running
  printf 'LOGIND='; systemctl is-active systemd-logind
  printf 'NETWORKD='; systemctl is-active systemd-networkd
  printf 'RESOLVED='; systemctl is-active systemd-resolved
  printf 'MEM_TOTAL_KB='; awk '/MemTotal/ {print $2}' /proc/meminfo
  printf 'MEM_AVAILABLE_KB='; awk '/MemAvailable/ {print $2}' /proc/meminfo
  printf 'RUNNING_SERVICES='; systemctl list-units --type=service --state=running --no-legend | wc -l
  printf 'PACKAGE_COUNT='; pacman --config /dev/null -Q | wc -l
  printf 'GRAPHICS_USER_UID='; id -u seyrix
  printf 'GRAPHICS_USER_GROUPS='; id -nG seyrix
  printf 'GPU_MODULES='; lsmod | grep -E 'virtio_gpu|virtio_pci' || true
  printf 'DRM_DEVICE='; ls -l /dev/dri/card* 2>&1
  printf 'DRM_DRIVER_LINKS_BEGIN\n'
  for sys_card in /sys/class/drm/card[0-9]*; do
    if [[ -e "$sys_card/device/driver" ]]; then printf '%s=' "${sys_card##*/}"; readlink -f "$sys_card/device/driver"; fi
  done
  printf 'DRM_DRIVER_LINKS_END\n'
  printf 'PCI_INVENTORY_BEGIN\n'; lspci -nn
