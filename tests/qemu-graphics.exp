				set target_recovery_popup [run_serial_capture $target_recovery_popup_command {SETTINGS_RECOVERY_POPUP_READY=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+) XDGSURFACE=([0-9]+) XDGPOPUP=([0-9]+) SURFACE=([0-9]+)} {SETTINGS_RECOVERY_POPUP_READY=failed} "wait for the compact GTK category popup to configure and commit" 20]
