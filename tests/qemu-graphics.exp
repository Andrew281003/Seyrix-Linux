			qmp_key_chord $qmp {ctrl} a
			qmp_key_chord $qmp {} backspace
			after 1000
			set settings_page_helper [file join [file dirname [file normalize [info script]]] qemu-settings-page-check.py]
			set previous_page_screenshot [file normalize [file join $run_dir phase2d3b-search-no-match.ppm]]
			set page_current_screenshot [file normalize [file join $run_dir phase2d3b-page-current.ppm]]
			qmp_hmp $qmp "screendump $page_current_screenshot"
			if {[catch {set search_clear_diff [exec python3 $settings_page_helper $previous_page_screenshot $page_current_screenshot $output_width]} search_clear_error]} {
				puts stderr "The Settings search filter did not visibly clear before category navigation. $search_clear_error"
				puts "PHASE2D3B_SEARCH_CLEAR=INCOMPLETE"
				exit 1
			}
			puts "PHASE2D3B_SEARCH_CLEAR=passed $search_clear_diff"
			set settings_stable_geometry_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); previous=; stable=0; rect=; for n in $(seq 1 100); do geometry=$(grep -E "GEOMETRY_EVIDENCE event=(map|commit|state) pid=$pid " /tmp/seyrix-compositor.log | tail -n 1); rect=$(sed -nE 's/.* x=(-?[0-9]+) y=(-?[0-9]+) width=([0-9]+) height=([0-9]+).*/\1,\2,\3,\4/p' <<< "$geometry"); if [[ -n "$rect" && "$rect" == "$previous" ]]; then stable=$((stable + 1)); else stable=0; fi; if (( stable >= 20 )); then printf 'PHASE2D3B_STABLE_SETTINGS_GEOMETRY=%s\n' "$rect"; break; fi; previous=$rect; sleep 0.25; done; if (( stable >= 20 )); then echo PHASE2D3B_STABLE_SETTINGS_GEOMETRY=ready; else echo PHASE2D3B_STABLE_SETTINGS_GEOMETRY=unstable; fi}
			set settings_stable_geometry [run_serial_capture $settings_stable_geometry_command {PHASE2D3B_STABLE_SETTINGS_GEOMETRY=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)} {PHASE2D3B_STABLE_SETTINGS_GEOMETRY=missing} "wait for the responsive Settings window to settle before choosing category input" 30]
			if {[lindex $settings_stable_geometry 0] ne "pass"} {
				puts stderr "The Settings window did not reach stable geometry before category navigation."
