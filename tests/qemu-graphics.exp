#!/usr/bin/expect -f

if {$argc < 4} {
    puts stderr {Usage: qemu-graphics.exp run-dir monitor-port qemu [qemu arguments...]}
    exit 2
}

set run_dir [lindex $argv 0]
set monitor_port [lindex $argv 1]
set qemu [lindex $argv 2]
set qemu_args [lrange $argv 3 end]
if {![info exists env(SEYRIX_QEMU_LOCK_HELD)] ||
		$env(SEYRIX_QEMU_LOCK_HELD) ne "1"} {
	puts stderr "QEMU graphics tests must run through qemu-graphics.sh so the ownership lock is held."
	exit 2
}
set qemu_identity ""
for {set index 0} {$index + 1 < [llength $qemu_args]} {incr index} {
	if {[lindex $qemu_args $index] eq "-name"} {
		set qemu_identity [lindex $qemu_args [expr {$index + 1}]]
		break
	}
}
if {$qemu_identity eq ""} {
	puts stderr "QEMU arguments have no run-specific -name identity."
	exit 2
}
set qemu_pid -1
set qemu_spawn_id -1
set acceptance_failures 0
set last_serial_check_result incomplete
set serial_log "$run_dir/serial.log"
set timeout 360
set phase2b 0
set phase2c 0
set sanitizers_enabled 0
set renderer_request ""
set egl_lifecycle_control 0
if {[info exists env(SEYRIX_QEMU_WORKFLOW)] &&
		($env(SEYRIX_QEMU_WORKFLOW) eq "phase2b" ||
		$env(SEYRIX_QEMU_WORKFLOW) eq "phase2c")} {
	set phase2b 1
}
if {[info exists env(SEYRIX_QEMU_WORKFLOW)] &&
		$env(SEYRIX_QEMU_WORKFLOW) eq "phase2c"} {
	set phase2c 1
}
if {[info exists env(SEYRIX_QEMU_SANITIZERS)] &&
		$env(SEYRIX_QEMU_SANITIZERS) eq "1"} {
	set sanitizers_enabled 1
}
if {[info exists env(SEYRIX_QEMU_RENDERER)]} {
	set renderer_request $env(SEYRIX_QEMU_RENDERER)
}
if {[info exists env(SEYRIX_QEMU_EGL_LIFECYCLE_CONTROL)] &&
		$env(SEYRIX_QEMU_EGL_LIFECYCLE_CONTROL) eq "1"} {
	set egl_lifecycle_control 1
}

proc qemu_cmdline {pid} {
	set path "/proc/$pid/cmdline"
	if {![file readable $path]} {
		return ""
	}
	if {[catch {set channel [open $path r]}]} {
		return ""
	}
	fconfigure $channel -translation binary -encoding binary
	set command_line [read $channel]
	close $channel
	return $command_line
}

proc qemu_is_owned {pid} {
	global qemu_identity
	set command_line [qemu_cmdline $pid]
	return [expr {$command_line ne "" &&
		[string first $qemu_identity $command_line] >= 0}]
}

proc cleanup_owned_qemu {reason} {
	global qemu_pid qemu_spawn_id run_dir qemu_identity
	if {$qemu_pid <= 0} {
		return
	}
	if {![qemu_is_owned $qemu_pid]} {
		if {$qemu_spawn_id ne -1} {catch {wait -i $qemu_spawn_id}}
		return
	}
	set command_line [qemu_cmdline $qemu_pid]
	if {[catch {set channel [open "$run_dir/qemu-process-before-cleanup.txt" w]}]} {
		set channel ""
	}
	if {$channel ne ""} {
		set printable [string map [list "\x00" " "] $command_line]
		puts $channel "Cleanup reason: $reason"
		puts $channel "QEMU PID: $qemu_pid"
		puts $channel "Expected run identity: $qemu_identity"
		puts $channel "Command line: $printable"
		catch {puts $channel [exec ps -p $qemu_pid -o pid=,ppid=,stat=,etimes=,comm=]}
		close $channel
	}
	puts stderr "Stopping QEMU owned by this run: PID $qemu_pid ($reason)."
	if {[catch {exec kill -TERM $qemu_pid} kill_error]} {
		puts stderr "Could not send SIGTERM to owned QEMU PID $qemu_pid: $kill_error"
		return
	}
	for {set attempt 0} {$attempt < 20} {incr attempt} {
		after 250
		if {![qemu_is_owned $qemu_pid]} {
			if {$qemu_spawn_id ne -1} {catch {wait -i $qemu_spawn_id}}
			return
		}
	}
	if {[qemu_is_owned $qemu_pid]} {
		puts stderr "Owned QEMU PID $qemu_pid did not stop within 5 seconds; sending SIGKILL after identity recheck."
		if {[catch {exec kill -KILL $qemu_pid} kill_error]} {
			puts stderr "Could not send SIGKILL to owned QEMU PID $qemu_pid: $kill_error"
		}
	}
	for {set attempt 0} {$attempt < 8} {incr attempt} {
		after 250
		if {![qemu_is_owned $qemu_pid]} {
			break
		}
	}
	if {$qemu_spawn_id ne -1} {
		catch {wait -i $qemu_spawn_id}
	}
}

rename exit expect_exit
proc exit {{status 0}} {
	global qemu_pid
	if {$status != 0 && $qemu_pid > 0} {
		cleanup_owned_qemu "test-exit-$status"
	}
	expect_exit $status
}
trap {cleanup_owned_qemu "SIGINT"; expect_exit 130} SIGINT
trap {cleanup_owned_qemu "SIGTERM"; expect_exit 143} SIGTERM
trap {cleanup_owned_qemu "SIGHUP"; expect_exit 129} SIGHUP
log_file -noappend $serial_log
log_user 1
set boot_started [clock milliseconds]

proc qmp_reply {channel} {
    while {[gets $channel line] >= 0} {
        if {[string first {"return"} $line] >= 0 || [string first {"error"} $line] >= 0} {
            if {[string first {"error"} $line] >= 0} {
                error "QMP error: $line"
            }
            return $line
        }
    }
    error "QMP connection closed before reply."
}

proc qmp_exec {channel json} {
    puts $channel $json
    flush $channel
    return [qmp_reply $channel]
}

proc qmp_hmp {channel command} {
    set escaped [string map [list "\\" "\\\\" "\"" "\\\""] $command]
    return [qmp_exec $channel "{\"execute\":\"human-monitor-command\",\"arguments\":{\"command-line\":\"$escaped\"}}"]
}

proc keycode_for {character} {
    set shift 0
    if {[regexp {^[A-Z]$} $character]} {
        set character [string tolower $character]
        set shift 1
    }
    if {[regexp {^[a-z0-9]$} $character]} {
        return [list $character $shift]
    }
    switch -- $character {
        " " { return [list "spc" 0] }
        "/" { return [list "slash" 0] }
        "-" { return [list "minus" 0] }
        "_" { return [list "minus" 1] }
        "=" { return [list "equal" 0] }
        "." { return [list "dot" 0] }
        "\n" { return [list "ret" 0] }
        default { error "Unsupported QEMU key character: $character" }
    }
}

proc qmp_type {channel value} {
    foreach character [split $value ""] {
        lassign [keycode_for $character] code shift
        if {$shift} {
            qmp_key_transition $channel shift 1
            after 40
        }
        set down_event [format {{"execute":"input-send-event","arguments":{"events":[{"type":"key","data":{"down":true,"key":{"type":"qcode","data":"%s"}}}]}}} $code]
        qmp_exec $channel $down_event
        after 60
        set up_event [format {{"execute":"input-send-event","arguments":{"events":[{"type":"key","data":{"down":false,"key":{"type":"qcode","data":"%s"}}}]}}} $code]
        qmp_exec $channel $up_event
        if {$shift} {
            after 40
            qmp_key_transition $channel shift 0
        }
        after 60
    }
}

proc qmp_mouse_move {channel x y} {
    set json [format {{"execute":"input-send-event","arguments":{"events":[{"type":"abs","data":{"axis":"x","value":%s}},{"type":"abs","data":{"axis":"y","value":%s}}]}}} $x $y]
    return [qmp_exec $channel $json]
}

proc qmp_mouse_click {channel} {
    qmp_exec $channel {{"execute":"input-send-event","arguments":{"events":[{"type":"btn","data":{"down":true,"button":"left"}}]}}}
    after 100
    qmp_exec $channel {{"execute":"input-send-event","arguments":{"events":[{"type":"btn","data":{"down":false,"button":"left"}}]}}}
}

proc qmp_key_transition {channel key down} {
    set state "false"
    if {$down} {
        set state "true"
    }
    set json [format {{"execute":"input-send-event","arguments":{"events":[{"type":"key","data":{"down":%s,"key":{"type":"qcode","data":"%s"}}}]}}} $state $key]
    return [qmp_exec $channel $json]
}

proc qmp_key_chord {channel modifiers key} {
    foreach modifier $modifiers {
        qmp_key_transition $channel $modifier 1
        after 80
    }
    qmp_key_transition $channel $key 1
    after 100
    qmp_key_transition $channel $key 0
    after 80
    foreach modifier [lreverse $modifiers] {
        qmp_key_transition $channel $modifier 0
        after 80
    }
}

proc qmp_mouse_button {channel button down} {
    set state "false"
    if {$down} {
        set state "true"
    }
    set json [format {{"execute":"input-send-event","arguments":{"events":[{"type":"btn","data":{"down":%s,"button":"%s"}}]}}} $state $button]
    return [qmp_exec $channel $json]
}

proc qmp_mouse_drag {channel x1 y1 x2 y2 button} {
    qmp_mouse_move $channel $x1 $y1
    after 100
    qmp_mouse_button $channel $button 1
    after 100
    qmp_mouse_move $channel $x2 $y2
    after 250
    qmp_mouse_button $channel $button 0
    after 100
}

proc install_guest_helper {helper_path} {
    global qemu_spawn_id timeout
    set saved_timeout $timeout
    set timeout 30
    set channel [open $helper_path r]
    set helper_source [read $channel]
    close $channel
    set helper_source [string map [list "\r" ""] $helper_source]
    send -i $qemu_spawn_id -- "cat > /tmp/seyrix-qemu-guest-helper.sh <<'SEYRIX_GUEST_HELPER_EOF'\r"
    set helper_payload [string map [list "\n" "\r"] $helper_source]
    send -i $qemu_spawn_id -- $helper_payload
    send -i $qemu_spawn_id -- "\rSEYRIX_GUEST_HELPER_EOF\rif chmod +x /tmp/seyrix-qemu-guest-helper.sh && bash -n /tmp/seyrix-qemu-guest-helper.sh; then echo QEMU_GUEST_HELPER=installed; else echo QEMU_GUEST_HELPER=failed; fi\r"
    expect -i $qemu_spawn_id \
        -re {QEMU_GUEST_HELPER=installed} {} \
        -re {QEMU_GUEST_HELPER=failed} {
            set timeout $saved_timeout
            puts stderr "The QEMU guest helper failed its shell syntax check."
            exit 1
        } \
        timeout {
            set timeout $saved_timeout
            puts stderr "Timed out installing the QEMU guest helper."
            exit 1
        } \
        eof {
            puts stderr "QEMU exited while installing the guest helper."
            exit 1
        }
    set timeout $saved_timeout
}

proc run_serial_capture {command success_pattern failure_pattern description stage_timeout} {
    global qemu_spawn_id timeout expect_out
    set saved_timeout $timeout
    set timeout $stage_timeout
    set started_ms [clock milliseconds]
    set timestamp [clock format [clock seconds] -gmt 1 -format {%Y-%m-%dT%H:%M:%SZ}]
    puts "STAGE_BEGIN name={$description} utc=$timestamp timeout_s=$timeout"
    send -i $qemu_spawn_id -- "$command\r"
    set result incomplete
    set captured {}
    expect -i $qemu_spawn_id \
        -re $success_pattern {
            set result pass
            for {set index 1} {$index < 20} {incr index} {
                if {[info exists expect_out($index,string)]} {
                    lappend captured $expect_out($index,string)
                }
            }
        } \
        -re $failure_pattern {set result fail} \
        timeout {set result incomplete} \
        eof {
            puts stderr "STAGE_RESULT name={$description} result=INCOMPLETE reason=qemu-eof"
            puts stderr "QEMU exited during $description."
            exit 1
        }
    set duration_ms [expr {[clock milliseconds] - $started_ms}]
    if {$result eq "pass"} {
        puts "STAGE_RESULT name={$description} result=PASS duration_ms=$duration_ms"
    } elseif {$result eq "fail"} {
        puts stderr "STAGE_RESULT name={$description} result=FAIL duration_ms=$duration_ms"
        incr ::acceptance_failures
    } else {
        puts stderr "STAGE_RESULT name={$description} result=INCOMPLETE reason=timeout duration_ms=$duration_ms timeout_s=$timeout"
        incr ::acceptance_failures
    }
    set timeout $saved_timeout
    return [list $result {*}$captured]
}

proc run_serial_check {command success_pattern failure_pattern description {stage_timeout ""}} {
    global qemu_spawn_id timeout acceptance_failures last_serial_check_result
    set saved_timeout $timeout
    if {$stage_timeout ne ""} {
        set timeout $stage_timeout
    }
    set started_ms [clock milliseconds]
    set timestamp [clock format [clock seconds] -gmt 1 -format {%Y-%m-%dT%H:%M:%SZ}]
    puts "STAGE_BEGIN name={$description} utc=$timestamp timeout_s=$timeout"
    send -i $qemu_spawn_id -- "$command\r"
    expect -i $qemu_spawn_id \
        -re $success_pattern {
            set last_serial_check_result pass
            set duration_ms [expr {[clock milliseconds] - $started_ms}]
            puts "STAGE_RESULT name={$description} result=PASS duration_ms=$duration_ms"
        } \
        -re $failure_pattern {
            set last_serial_check_result fail
            set duration_ms [expr {[clock milliseconds] - $started_ms}]
            puts stderr "STAGE_RESULT name={$description} result=FAIL duration_ms=$duration_ms"
            puts stderr "$description failed."
            incr acceptance_failures
        } \
        timeout {
            set last_serial_check_result incomplete
            set duration_ms [expr {[clock milliseconds] - $started_ms}]
            puts stderr "STAGE_RESULT name={$description} result=INCOMPLETE reason=timeout duration_ms=$duration_ms timeout_s=$timeout"
            puts stderr "Timed out: $description."
            incr acceptance_failures
        } \
        eof {
            puts stderr "STAGE_RESULT name={$description} result=INCOMPLETE reason=qemu-eof"
            puts stderr "QEMU exited: $description."
            exit 1
        }
    set timeout $saved_timeout
}

spawn -noecho $qemu {*}$qemu_args
set qemu_spawn_id $spawn_id
set qemu_pid [exp_pid -i $qemu_spawn_id]
set pid_channel [open "$run_dir/qemu.pid" w]
puts $pid_channel $qemu_pid
close $pid_channel
puts "QEMU_PID=$qemu_pid"
set qmp ""
set qmp_error ""
for {set attempt 0} {$attempt < 40 && $qmp eq ""} {incr attempt} {
    if {[catch {set qmp [socket 127.0.0.1 $monitor_port]} qmp_error]} {
        set qmp ""
        after 250
    }
}
if {$qmp eq ""} {
    puts stderr "Could not connect to QMP on localhost port $monitor_port: $qmp_error"
    exit 1
}
fconfigure $qmp -buffering line -blocking 1
set greeting [gets $qmp]
if {[string first {"QMP"} $greeting] < 0} {
    puts stderr "Unexpected QMP greeting: $greeting"
    exit 1
}
qmp_exec $qmp {{"execute":"qmp_capabilities"}}
puts "QMP_CONNECTED=passed"
set pci_info [qmp_hmp $qmp "info pci"]
puts "QEMU_PCI_INVENTORY=$pci_info"

expect {
    -re {seyrix-dev login:} {
        set login_ms [expr {[clock milliseconds] - $boot_started}]
        puts "BOOT_TO_LOGIN_MS=$login_ms"
    }
    timeout {
        puts stderr "Timed out waiting for the Seyrix serial login prompt."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the Seyrix serial login prompt."
        exit 1
    }
}
puts "SERIAL_LOGIN_PROMPT=passed"

send -- "root\r"
puts "SERIAL_ROOT_LOGIN_SENT=passed"
expect {
    -re {Password:} {
        send -- "\r"
        exp_continue
    }
    -re {root@seyrix-dev[^\r\n]*# ?$} {}
    timeout {
        puts stderr "Timed out waiting for the live root shell."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the live root shell appeared."
        exit 1
    }
}
puts "SERIAL_ROOT_SHELL=passed"

send -- "stty -echo; export PS1='SEYRIX-ROOT# '\r"
expect {
    -re {SEYRIX-ROOT#} {}
    timeout {
        puts stderr "Timed out setting up the serial test shell."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the serial test shell was ready."
        exit 1
    }
}

set baseline_command {
  printf 'SEYRIX_GRAPHICS_CHECK_BEGIN\n'
  printf 'LOGIN_USER='; id -un
  printf 'KERNEL='; uname -r
  printf 'ROOT_FS='; findmnt -n -o FSTYPE /
  printf 'PID1='; ps -p 1 -o comm= | tr -d ' '
  printf 'SYSTEMD='; systemctl is-system-running
  printf 'LOGIND='; systemctl is-active systemd-logind
  printf 'NETWORKD='; systemctl is-active systemd-networkd
  printf 'RESOLVED='; systemctl is-active systemd-resolved
  printf 'MEM_TOTAL_KB='; awk '/MemTotal/ {print $2}' /proc/meminfo
  printf 'MEM_AVAILABLE_KB='; awk '/MemAvailable/ {print $2}' /proc/meminfo
  printf 'RUNNING_SERVICES='; systemctl list-units --type=service --state=running --no-legend | wc -l
  printf 'PACKAGE_COUNT='; pacman --config /dev/null -Q | wc -l
  printf 'GRAPHICS_USER_UID='; id -u seyrix
  printf 'GRAPHICS_USER_GROUPS='; id -nG seyrix
  printf 'GPU_MODULES='; lsmod | grep -E 'virtio_gpu|virtio_pci' || true
  printf 'DRM_DEVICE='; ls -l /dev/dri/card* 2>&1
  printf 'DRM_DRIVER_LINKS_BEGIN\n'
  for sys_card in /sys/class/drm/card[0-9]*; do
    if [[ -e "$sys_card/device/driver" ]]; then printf '%s=' "${sys_card##*/}"; readlink -f "$sys_card/device/driver"; fi
  done
  printf 'DRM_DRIVER_LINKS_END\n'
  printf 'PCI_INVENTORY_BEGIN\n'; lspci -nn
  printf 'PCI_INVENTORY_END\n'
  printf 'PCI_GPU='; lspci -nn | grep -Ei 'VGA|Display|3D' | head -1
  printf 'INPUT_DEVICE_HANDLERS_BEGIN\n'; grep -E '^N: Name=|^H: Handlers=' /proc/bus/input/devices
  printf 'INPUT_DEVICE_HANDLERS_END\n'
  printf 'INPUT_EVENT_COUNT='; find /dev/input -maxdepth 1 -type c -name 'event*' 2>/dev/null | wc -l
  if find /dev/input -maxdepth 1 -type c -name 'event*' 2>/dev/null | grep -q .; then echo INPUT_DEVICE_CHECK=passed; else echo INPUT_DEVICE_CHECK=failed; fi
  if compgen -G '/dev/dri/card[0-9]*' >/dev/null && lsmod | grep -q '^virtio_gpu '; then echo GRAPHICS_DEVICE_CHECK=passed; else echo GRAPHICS_DEVICE_CHECK=failed; fi
  printf 'SEYRIX_GRAPHICS_CHECK_END\n'
}
send -- "$baseline_command\r"
foreach {label pattern} {
    login_user {LOGIN_USER=root}
    kernel {KERNEL=[0-9]+\.[0-9]+}
    root_fs {ROOT_FS=overlay}
    pid1 {PID1=systemd}
    systemd {SYSTEMD=running}
    logind {LOGIND=active}
    networkd {NETWORKD=active}
    resolved {RESOLVED=active}
    memory {MEM_TOTAL_KB=[1-9][0-9]+}
    services {RUNNING_SERVICES=[1-9][0-9]*}
    packages {PACKAGE_COUNT=[1-9][0-9]*}
    graphics_user {GRAPHICS_USER_UID=[1-9][0-9]*}
    drm_device {DRM_DEVICE=.*}
    pci_inventory {PCI_INVENTORY_END}
    pci_gpu {PCI_GPU=.*}
    input_events {INPUT_EVENT_COUNT=[0-9]+}
} {
    expect {
        -re $pattern {}
        timeout {
            puts stderr "Missing graphics boot verification output for $label."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before graphics boot verification for $label."
            exit 1
        }
    }
}
expect {
    -re {INPUT_DEVICE_CHECK=passed} {}
    -re {INPUT_DEVICE_CHECK=failed} {
        puts stderr "The guest did not expose input event devices. See INPUT_EVENT_COUNT in test.log."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for the guest input device check."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the guest input device check."
        exit 1
    }
}
expect {
    -re {GRAPHICS_DEVICE_CHECK=passed} {}
    -re {GRAPHICS_DEVICE_CHECK=failed} {
        puts stderr "The guest did not expose a virtio DRM device. See PCI_INVENTORY and DRM_DEVICE in test.log."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for the guest DRM device check."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the guest DRM device check."
        exit 1
    }
}
expect {
    -re {SEYRIX_GRAPHICS_CHECK_END} {}
    timeout {
        puts stderr "Timed out waiting for the guest graphics diagnostics to finish."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before graphics diagnostics finished."
        exit 1
    }
}

qmp_hmp $qmp "screendump $run_dir/tty1-login-screen.ppm"
qmp_type $qmp "\n"
set tty_ready_command {for n in $(seq 1 20); do test -f /home/seyrix/.tty1-ready && break; sleep 1; done; printf 'TTY1_MARKER='; test -f /home/seyrix/.tty1-ready && echo present || echo missing; printf 'TTY1_SESSION_INFO='; cat /home/seyrix/.tty1-session-info 2>/dev/null || echo missing; printf 'TTY1_GETTY_ACTIVE='; systemctl is-active getty@tty1; printf 'TTY1_GETTY_EXEC='; systemctl show -p ExecStart getty@tty1; printf 'SEYRIX_PROCESSES='; pgrep -a -u 1000 || true; printf 'TTY1_GETTY_STATUS_BEGIN\n'; systemctl status getty@tty1 --no-pager --full || true; printf 'TTY1_GETTY_STATUS_END\n'; printf 'TTY1_JOURNAL_BEGIN\n'; journalctl -b -u getty@tty1 --no-pager -n 30; printf 'TTY1_JOURNAL_END\n'; printf 'LOGINCTL_SESSIONS_BEGIN\n'; loginctl list-sessions --no-legend; printf 'LOGINCTL_SESSIONS_END\n'; if test -f /home/seyrix/.tty1-ready; then echo TTY1_DEV_SESSION_READY=passed; else echo TTY1_DEV_SESSION_READY=failed; fi}
send -- "$tty_ready_command\r"
expect {
    -re {TTY1_DEV_SESSION_READY=passed} {}
    -re {TTY1_DEV_SESSION_READY=failed} {
        puts stderr "The development-only tty1 login did not become ready. See TTY1_GETTY and SEYRIX_PROCESSES in test.log."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for the development-only tty1 login."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the tty1 login became ready."
        exit 1
    }
}

set input_monitor_command {mouse_event="$(awk '/^N: Name="QEMU QEMU USB Tablet"/ { found=1; next } found && /^H: Handlers=/ { if (match($0, /event[0-9]+/)) { print substr($0, RSTART, RLENGTH); exit } }' /proc/bus/input/devices)"; if [[ -z "$mouse_event" ]]; then echo MOUSE_MONITOR_STARTED=failed; else nohup timeout 120s evtest "/dev/input/$mouse_event" >/tmp/seyrix-evtest-mouse.log 2>&1 </dev/null & echo MOUSE_MONITOR_STARTED=passed; fi}
send -- "$input_monitor_command\r"
expect {
    -re {MOUSE_MONITOR_STARTED=passed} {}
    -re {MOUSE_MONITOR_STARTED=failed} {
        puts stderr "Could not find the QEMU USB tablet event device for evtest."
        exit 1
    }
    timeout {
        puts stderr "Could not start the evtest mouse event recorder."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the libinput input-event recorder started."
        exit 1
    }
}

set tty_switch_command {printf 'TTY_BEFORE_SWITCH='; cat /sys/class/tty/tty0/active; chvt 1; sleep 1; printf 'TTY_ACTIVE_AFTER_SWITCH='; cat /sys/class/tty/tty0/active; printf '\n'}
send -- "$tty_switch_command\r"
expect {
    -re {TTY_ACTIVE_AFTER_SWITCH=tty1} {}
    timeout {
        puts stderr "Could not switch the active virtual terminal to Seyrix tty1."
        exit 1
    }
    eof {
        puts stderr "QEMU exited while switching to Seyrix tty1."
        exit 1
    }
}
if {$phase2b} {
    qmp_hmp $qmp "screendump $run_dir/tty1-before-seyrix.ppm"
    if {$phase2c} {
        set wm_config_home "/tmp/seyrix-wm-config-$qemu_identity"
        set wm_probe_config_command "mkdir -p $wm_config_home/seyrix && chmod 755 $wm_config_home $wm_config_home/seyrix && printf 'version=1\\ndefault_mode=hybrid\\napp_id.7365797269782e706861736532632d70726f6265=floating\\n' > $wm_config_home/seyrix/window-management.conf && chmod 644 $wm_config_home/seyrix/window-management.conf && chown 1000:1000 $wm_config_home $wm_config_home/seyrix $wm_config_home/seyrix/window-management.conf && echo WM_TEST_CONFIG=ready"
        run_serial_check $wm_probe_config_command {WM_TEST_CONFIG=ready} {WM_TEST_CONFIG=failed} "prepare explicit floating rule for the Phase 2C state-cycle probe" 20
    }
    set compositor_launch_command "start-seyrix"
    if {$sanitizers_enabled} {
        set compositor_launch_command "ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1 start-seyrix"
    }
    if {$phase2c} {
        set compositor_launch_command "XDG_CONFIG_HOME=$wm_config_home $compositor_launch_command"
    }
    if {$renderer_request ne ""} {
        set compositor_launch_command "WLR_RENDERER=$renderer_request $compositor_launch_command"
    }
    qmp_type $qmp $compositor_launch_command
    set compositor_command_started [clock milliseconds]
    qmp_key_transition $qmp ret 1
    after 80
    qmp_key_transition $qmp ret 0
    after 2000
    qmp_hmp $qmp "screendump $run_dir/tty1-after-seyrix-command.ppm"

    set compositor_ready_command {for n in $(seq 1 60); do if pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null && grep -q 'SEYRIX_COMPOSITOR_READY=1' /tmp/seyrix-compositor.log 2>/dev/null && grep -q 'Window mapped:' /tmp/seyrix-compositor.log 2>/dev/null; then break; fi; sleep 1; done; if pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null && grep -q 'SEYRIX_COMPOSITOR_READY=1' /tmp/seyrix-compositor.log 2>/dev/null && grep -q 'Window mapped:' /tmp/seyrix-compositor.log 2>/dev/null && pgrep -u 1000 -x weston-terminal >/dev/null && find /run/user/1000 -maxdepth 1 -type s -name 'wayland-*' -print -quit | grep -q .; then echo COMPOSITOR_READY=passed; else echo COMPOSITOR_READY=failed; fi; printf 'COMPOSITOR_LOG_BEGIN\n'; cat /tmp/seyrix-compositor.log 2>/dev/null || true; printf 'COMPOSITOR_LOG_END\n'; printf 'WLROOTS_PACKAGE='; pacman -Q wlroots0.20; printf 'COMPOSITOR_PROCESSES='; pgrep -a -u 1000 -f '^/usr/bin/seyrix-compositor$' || true; printf 'COMPOSITOR_RSS_KB='; compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1); if [[ -n "$compositor_pid" ]]; then awk '/VmRSS:/ {print $2}' "/proc/$compositor_pid/status"; else echo unavailable; fi; printf 'TERMINAL_PROCESSES='; pgrep -a -u 1000 -x weston-terminal || true}
    send -- "$compositor_ready_command\r"
    set compositor_ready 0
    expect {
        -re {COMPOSITOR_READY=passed} {
            set compositor_ready 1
        }
        -re {COMPOSITOR_READY=failed} {set compositor_ready 0}
        timeout {
            puts stderr "Timed out waiting for Seyrix compositor startup."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before the Seyrix compositor became ready."
            exit 1
        }
    }
    expect {
        -re {COMPOSITOR_LOG_END} {}
        timeout {
            puts stderr "Timed out collecting Seyrix compositor startup diagnostics."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before compositor diagnostics were collected."
            exit 1
        }
    }
    if {!$compositor_ready} {
        puts stderr "Seyrix compositor did not start or create a Wayland socket."
        exit 1
    }
    if {$phase2c} {
        set guest_helper [file join [file dirname [file normalize [info script]]] qemu-guest-helper.sh]
        install_guest_helper $guest_helper
        set run_identity_path "/tmp/seyrix-qemu-test-run-id-$qemu_identity"
		set run_identity_command "touch $run_identity_path; if test -e $run_identity_path; then echo QEMU_TEST_RUN_ID=passed; else echo QEMU_TEST_RUN_ID=failed; fi"
        run_serial_check $run_identity_command \
			{QEMU_TEST_RUN_ID=passed} \
            {QEMU_TEST_RUN_ID=failed} "record current QEMU test identity" 10
    }
    set compositor_startup_ms [expr {[clock milliseconds] - $compositor_command_started}]
    puts "COMPOSITOR_STARTUP_MS=$compositor_startup_ms"
    puts "APPLICATION_LAUNCH=passed"
    set graphics_ms [expr {[clock milliseconds] - $boot_started}]
    puts "GRAPHICAL_BOOT_MS=$graphics_ms"

    if {$phase2c && [info exists env(SEYRIX_QEMU_WORKSPACE_ONLY)] &&
            $env(SEYRIX_QEMU_WORKSPACE_ONLY) eq "1"} {
        set timeout 240
        qmp_type $qmp "mkdir -p /tmp/seyrix-ws-first\ncd /tmp/seyrix-ws-first\n"
        set ws_first_ready {for n in $(seq 1 15); do test -d /tmp/seyrix-ws-first && break; sleep 1; done; if test -d /tmp/seyrix-ws-first; then echo WORKSPACE_FIRST_WINDOW_MARKER=passed; else echo WORKSPACE_FIRST_WINDOW_MARKER=failed; fi}
        run_serial_check $ws_first_ready {WORKSPACE_FIRST_WINDOW_MARKER=passed} {WORKSPACE_FIRST_WINDOW_MARKER=failed} "initial workspace terminal command marker" 20
		set wm_default_hybrid {if grep -Fq 'Window-management default mode: hybrid' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot startup 1; then echo WM_DEFAULT_HYBRID=passed; else echo WM_DEFAULT_HYBRID=failed; fi}
		run_serial_check $wm_default_hybrid {WM_DEFAULT_HYBRID=passed} {WM_DEFAULT_HYBRID=failed} "Hybrid default and initial tiled surface geometry" 25

        qmp_key_chord $qmp {meta_l} ret
        set ws_second_spawn {for n in $(seq 1 180); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); if [[ "$count" -ge 2 && "$mapped" -ge 2 ]]; then break; fi; sleep 1; done; count=$(pgrep -u 1000 -x weston-terminal | wc -l); mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); printf 'WORKSPACE_SECOND_TERMINAL_COUNT=%s\nWORKSPACE_SECOND_MAPPED_COUNT=%s\n' "$count" "$mapped"; if [[ "$count" -ge 2 && "$mapped" -ge 2 ]]; then echo WORKSPACE_SECOND_WINDOW_READY=passed; else echo WORKSPACE_SECOND_WINDOW_READY=failed; fi}
        run_serial_check $ws_second_spawn {WORKSPACE_SECOND_WINDOW_READY=passed} {WORKSPACE_SECOND_WINDOW_READY=failed} "second workspace-one terminal process and toplevel map readiness" 190
        qmp_type $qmp "mkdir -p /tmp/seyrix-ws-second\ncd /tmp/seyrix-ws-second\n"
        set ws_second_ready {for n in $(seq 1 20); do test -d /tmp/seyrix-ws-second && break; sleep 1; done; count=$(pgrep -u 1000 -x weston-terminal | wc -l); mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); printf 'WORKSPACE_TERMINAL_COUNT_AFTER_MARKER=%s\nWORKSPACE_MAPPED_COUNT_AFTER_MARKER=%s\n' "$count" "$mapped"; if test -d /tmp/seyrix-ws-second && [[ "$count" -eq 2 && "$mapped" -ge 2 ]]; then echo WORKSPACE_SECOND_WINDOW_MARKER=passed; else echo WORKSPACE_SECOND_WINDOW_MARKER=failed; printf 'WORKSPACE_TERMINAL_DIAGNOSTICS_BEGIN\n'; pgrep -a -u 1000 -x weston-terminal || true; grep -E 'Started weston-terminal|Window mapped:|Super\+Return could not start|GEOMETRY_EVIDENCE' /tmp/seyrix-compositor.log | tail -n 12; printf 'WORKSPACE_TERMINAL_DIAGNOSTICS_END\n'; fi}
        run_serial_check $ws_second_ready {WORKSPACE_SECOND_WINDOW_MARKER=passed} {WORKSPACE_SECOND_WINDOW_MARKER=failed} "second workspace-one terminal command marker after mapped readiness" 25
		set wm_pair_tiling {bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot pair 2 1 && echo WM_AUTOMATIC_TILING=passed || echo WM_AUTOMATIC_TILING=failed}
		run_serial_check $wm_pair_tiling {WM_AUTOMATIC_TILING=passed} {WM_AUTOMATIC_TILING=failed} "two-client non-overlapping tiled geometry" 25

		qmp_key_chord $qmp {meta_l ctrl} right
		set wm_ratio_check {if grep -q 'Workspace split ratio adjusted to' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot ratio 2 1 && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-identity pair ratio && bash /tmp/seyrix-qemu-guest-helper.sh wm-geometry-changed pair ratio; then echo WM_SPLIT_RATIO=passed; else echo WM_SPLIT_RATIO=failed; fi}
		run_serial_check $wm_ratio_check {WM_SPLIT_RATIO=passed} {WM_SPLIT_RATIO=failed} "keyboard split-ratio adjustment changes committed client geometry" 30

		qmp_key_chord $qmp {meta_l} f
		qmp_type $qmp "touch /tmp/seyrix-wm-floating-focus\n"
		set wm_mixed_check {if grep -Fq 'Focused window classification changed to floating' /tmp/seyrix-compositor.log && test -f /tmp/seyrix-wm-floating-focus && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot mixed 2 0 visible && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-identity ratio mixed; then echo WM_HYBRID_MIXED=passed; else echo WM_HYBRID_MIXED=failed; fi}
		run_serial_check $wm_mixed_check {WM_HYBRID_MIXED=passed} {WM_HYBRID_MIXED=failed} "floating classification retains keyboard focus and window identity" 30

		qmp_key_chord $qmp {meta_l} f
		set wm_retile_check {if grep -Fq 'Focused window classification changed to tiled' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot retiled 2 1 && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-identity ratio retiled && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-geometry ratio retiled; then echo WM_DETERMINISTIC_REINSERT=passed; else echo WM_DETERMINISTIC_REINSERT=failed; fi}
		run_serial_check $wm_retile_check {WM_DETERMINISTIC_REINSERT=passed} {WM_DETERMINISTIC_REINSERT=failed} "floating-to-tiled reinsertion restores deterministic split geometry" 30

		qmp_key_chord $qmp {meta_l shift} t
		set wm_tiling_mode_check {if grep -Fq 'Workspace 1 layout mode changed to tiling' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot automatic 2 1 && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-identity retiled automatic; then echo WM_AUTOMATIC_MODE=passed; else echo WM_AUTOMATIC_MODE=failed; fi}
		run_serial_check $wm_tiling_mode_check {WM_AUTOMATIC_MODE=passed} {WM_AUTOMATIC_MODE=failed} "automatic-tiling mode switch retains windows" 30
		qmp_key_chord $qmp {meta_l} ret
		set wm_third_spawn {for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -eq 3 ]]; then break; fi; sleep 1; done; if [[ "$count" -eq 3 ]]; then echo WM_THIRD_WINDOW_READY=passed; else echo WM_THIRD_WINDOW_READY=failed; pgrep -a -u 1000 -x weston-terminal || true; fi}
		run_serial_check $wm_third_spawn {WM_THIRD_WINDOW_READY=passed} {WM_THIRD_WINDOW_READY=failed} "third automatic-tiling client process" 35
		set wm_three_tiled {if bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot automatic-three 3 1; then echo WM_THREE_TILED=passed; else echo WM_THREE_TILED=failed; fi}
		run_serial_check $wm_three_tiled {WM_THREE_TILED=passed} {WM_THREE_TILED=failed} "three simultaneous automatic tiles have bounded non-overlapping geometry" 30
		qmp_hmp $qmp "screendump $run_dir/seyrix-three-tiled.ppm"
		qmp_key_chord $qmp {meta_l} q
		set wm_third_close {for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -eq 2 ]]; then break; fi; sleep 1; done; if [[ "$count" -eq 2 ]]; then echo WM_THIRD_WINDOW_CLOSED=passed; else echo WM_THIRD_WINDOW_CLOSED=failed; pgrep -a -u 1000 -x weston-terminal || true; fi}
		run_serial_check $wm_third_close {WM_THIRD_WINDOW_CLOSED=passed} {WM_THIRD_WINDOW_CLOSED=failed} "remove the third automatic tile cleanly" 35
		qmp_key_chord $qmp {meta_l shift} f
		set wm_float_mode_check {if grep -Fq 'Workspace 1 layout mode changed to floating' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot floating 2 0 visible && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-identity automatic floating; then echo WM_FLOATING_MODE=passed; else echo WM_FLOATING_MODE=failed; fi}
		run_serial_check $wm_float_mode_check {WM_FLOATING_MODE=passed} {WM_FLOATING_MODE=failed} "floating mode retains application and surface identity" 30
		qmp_key_chord $qmp {meta_l shift} h
		set wm_hybrid_restore {if grep -Fq 'Workspace 1 layout mode changed to hybrid' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot hybrid 2 1 && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-identity retiled hybrid && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-geometry retiled hybrid; then echo WM_HYBRID_RESTORE=passed; else echo WM_HYBRID_RESTORE=failed; fi}
		run_serial_check $wm_hybrid_restore {WM_HYBRID_RESTORE=passed} {WM_HYBRID_RESTORE=failed} "Hybrid mode restores tile geometry without recreating surfaces" 30
		proc run_wm_state_cycle {qmp app_id label {managed_restore 0}} {
			set log_path "/tmp/seyrix-wm-state-$label.log"
			set probe_command "SEYRIX_PROBE_LOG=$log_path seyrix-protocol-probe --state-cycle"
			if {$managed_restore} {
				append probe_command " --allow-managed-restore"
			}
			append probe_command " --app-id $app_id\n"
			qmp_type $qmp $probe_command
			set state_check "for n in \$(seq 1 20); do if grep -Fq 'STATE_CYCLE=passed' '$log_path'; then break; fi; sleep 1; done; if grep -Fq 'STATE_CYCLE=passed' '$log_path' && grep -Fq 'RESTORE_GEOMETRY=passed' '$log_path' && grep -Fq 'RESTORE_AFTER_FULLSCREEN=passed' '$log_path' && grep -Fq 'Window state requested: app_id=$app_id maximized=1 fullscreen=0' /tmp/seyrix-compositor.log && grep -Fq 'Window state requested: app_id=$app_id maximized=0 fullscreen=1' /tmp/seyrix-compositor.log; then echo WM_STATE_$label=passed; else echo WM_STATE_$label=failed; cat '$log_path' 2>/dev/null || true; grep -F 'Window state requested: app_id=$app_id' /tmp/seyrix-compositor.log | tail -n 8; fi"
			set state_pass "WM_STATE_$label=passed"
			set state_fail "WM_STATE_$label=failed"
			run_serial_check $state_check [list $state_pass] [list $state_fail] "maximize and fullscreen protocol cycle: $label" 30
		}
		run_wm_state_cycle $qmp seyrix.wm.hybrid-tiled HYBRID_TILED 1
		qmp_key_chord $qmp {meta_l shift} t
		run_wm_state_cycle $qmp seyrix.phase2c-probe TILING_MODE 1
		qmp_key_chord $qmp {meta_l shift} f
		run_wm_state_cycle $qmp seyrix.wm.floating-mode-tiled FLOATING_MODE
		run_wm_state_cycle $qmp seyrix.phase2c-probe HYBRID_FLOATING
		qmp_key_chord $qmp {meta_l shift} h

		qmp_key_chord $qmp {meta_l shift} f
		set wm_workspace1_float {if grep -Fq 'Workspace 1 layout mode changed to floating' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot workspace1-float 2 0 visible; then echo WM_WORKSPACE1_FLOATING=passed; else echo WM_WORKSPACE1_FLOATING=failed; fi}
		run_serial_check $wm_workspace1_float {WM_WORKSPACE1_FLOATING=passed} {WM_WORKSPACE1_FLOATING=failed} "set workspace one layout mode" 30
		qmp_key_chord $qmp {meta_l} right
		qmp_key_chord $qmp {meta_l shift} t
		set wm_workspace2_tiling {if grep -Fq 'Workspace 2 layout mode changed to tiling' /tmp/seyrix-compositor.log; then echo WM_WORKSPACE2_TILING=passed; else echo WM_WORKSPACE2_TILING=failed; fi}
		run_serial_check $wm_workspace2_tiling {WM_WORKSPACE2_TILING=passed} {WM_WORKSPACE2_TILING=failed} "set workspace two layout mode" 20
		qmp_key_chord $qmp {meta_l} left
		set wm_workspace1_restore {if bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot workspace1-return 2 0 visible && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-identity workspace1-float workspace1-return && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-geometry workspace1-float workspace1-return; then echo WM_WORKSPACE_MODE_INDEPENDENCE=passed; else echo WM_WORKSPACE_MODE_INDEPENDENCE=failed; fi}
		run_serial_check $wm_workspace1_restore {WM_WORKSPACE_MODE_INDEPENDENCE=passed} {WM_WORKSPACE_MODE_INDEPENDENCE=failed} "workspace one floating state survives workspace two tiling mode" 30
		qmp_key_chord $qmp {meta_l shift} h
		qmp_key_chord $qmp {meta_l} right
		qmp_key_chord $qmp {meta_l} left
        qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-1.ppm"

        qmp_key_chord $qmp {meta_l} right
        after 350
        qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-2-empty.ppm"
        qmp_type $qmp "touch /tmp/seyrix-hidden-workspace-input\n"
        after 300
        set ws_hidden_input {count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ ! -e /tmp/seyrix-hidden-workspace-input && "$count" -eq 2 ]]; then echo WORKSPACE_HIDDEN_INPUT=passed; else echo WORKSPACE_HIDDEN_INPUT=failed; fi}
        run_serial_check $ws_hidden_input {WORKSPACE_HIDDEN_INPUT=passed} {WORKSPACE_HIDDEN_INPUT=failed} "input isolation while workspace one is hidden"

        qmp_key_chord $qmp {meta_l} ret
        set ws_third_spawn {for n in $(seq 1 180); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); if [[ "$count" -ge 3 && "$mapped" -ge 3 ]]; then break; fi; sleep 1; done; count=$(pgrep -u 1000 -x weston-terminal | wc -l); mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); printf 'WORKSPACE_THIRD_TERMINAL_COUNT=%s\nWORKSPACE_THIRD_MAPPED_COUNT=%s\n' "$count" "$mapped"; if [[ "$count" -ge 3 && "$mapped" -ge 3 ]]; then echo WORKSPACE_THIRD_WINDOW_READY=passed; else echo WORKSPACE_THIRD_WINDOW_READY=failed; fi}
        run_serial_check $ws_third_spawn {WORKSPACE_THIRD_WINDOW_READY=passed} {WORKSPACE_THIRD_WINDOW_READY=failed} "third terminal process and toplevel map readiness" 190
        qmp_type $qmp "mkdir -p /tmp/seyrix-ws-third\ncd /tmp/seyrix-ws-third\n"
        set ws_third_ready {for n in $(seq 1 20); do test -d /tmp/seyrix-ws-third && break; sleep 1; done; count=$(pgrep -u 1000 -x weston-terminal | wc -l); mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); if test -d /tmp/seyrix-ws-third && [[ "$count" -eq 3 && "$mapped" -ge 3 ]]; then echo WORKSPACE_THIRD_WINDOW_MARKER=passed; else echo WORKSPACE_THIRD_WINDOW_MARKER=failed; printf 'WORKSPACE_THIRD_DIAGNOSTICS_BEGIN\n'; pgrep -a -u 1000 -x weston-terminal || true; grep -E 'Started weston-terminal|Window mapped:|GEOMETRY_EVIDENCE' /tmp/seyrix-compositor.log | tail -n 12; printf 'WORKSPACE_THIRD_DIAGNOSTICS_END\n'; fi}
        run_serial_check $ws_third_ready {WORKSPACE_THIRD_WINDOW_MARKER=passed} {WORKSPACE_THIRD_WINDOW_MARKER=failed} "third terminal command marker after mapped readiness" 25
        qmp_type $qmp "touch /tmp/seyrix-ws2-active\n"
        after 300
        set ws_second_active {if test -f /tmp/seyrix-ws2-active && [[ "$(pgrep -u 1000 -x weston-terminal | wc -l)" -eq 3 ]]; then echo WORKSPACE_APP_PERSISTENCE=passed; else echo WORKSPACE_APP_PERSISTENCE=failed; fi}
        run_serial_check $ws_second_active {WORKSPACE_APP_PERSISTENCE=passed} {WORKSPACE_APP_PERSISTENCE=failed} "application remains interactive on workspace two"

        qmp_key_chord $qmp {meta_l} left
        after 350
        qmp_type $qmp "touch seyrix-focus-restored\n"
        after 300
        set ws_focus_restore {if test -f /tmp/seyrix-ws-second/seyrix-focus-restored && test ! -e /tmp/seyrix-ws-first/seyrix-focus-restored; then echo WORKSPACE_FOCUS_RESTORE=passed; else echo WORKSPACE_FOCUS_RESTORE=failed; fi}
        run_serial_check $ws_focus_restore {WORKSPACE_FOCUS_RESTORE=passed} {WORKSPACE_FOCUS_RESTORE=failed} "per-workspace focus restoration"

        qmp_key_chord $qmp {meta_l shift} right
        after 350
        set ws_move_right {count=$(pgrep -u 1000 -x weston-terminal | wc -l); if grep -q 'Moved focused window to workspace 2' /tmp/seyrix-compositor.log && [[ "$count" -eq 3 ]]; then echo WORKSPACE_MOVE_RIGHT=passed; else echo WORKSPACE_MOVE_RIGHT=failed; fi}
        run_serial_check $ws_move_right {WORKSPACE_MOVE_RIGHT=passed} {WORKSPACE_MOVE_RIGHT=failed} "moving a focused window to workspace two"
        qmp_key_chord $qmp {meta_l} right
        after 350
        qmp_key_chord $qmp {meta_l} q
        after 500
        set ws_close_other {if [[ "$(pgrep -u 1000 -x weston-terminal | wc -l)" -eq 2 ]]; then echo WORKSPACE_CLOSE_OTHER=passed; else echo WORKSPACE_CLOSE_OTHER=failed; fi}
        run_serial_check $ws_close_other {WORKSPACE_CLOSE_OTHER=passed} {WORKSPACE_CLOSE_OTHER=failed} "closing the other application on workspace two"
        qmp_type $qmp "touch seyrix-moved-window-interactive\n"
        after 300
        set ws_moved_window {if test -f /tmp/seyrix-ws-second/seyrix-moved-window-interactive; then echo WORKSPACE_MOVED_WINDOW_INTERACTIVE=passed; else echo WORKSPACE_MOVED_WINDOW_INTERACTIVE=failed; fi}
        run_serial_check $ws_moved_window {WORKSPACE_MOVED_WINDOW_INTERACTIVE=passed} {WORKSPACE_MOVED_WINDOW_INTERACTIVE=failed} "migrated window remains interactive"
        qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-2-migrated.ppm"

        qmp_key_chord $qmp {meta_l shift} left
        after 350
        set ws_move_left {count=$(pgrep -u 1000 -x weston-terminal | wc -l); if grep -q 'Moved focused window to workspace 1' /tmp/seyrix-compositor.log && [[ "$count" -eq 2 ]]; then echo WORKSPACE_MOVE_LEFT=passed; else echo WORKSPACE_MOVE_LEFT=failed; fi}
        run_serial_check $ws_move_left {WORKSPACE_MOVE_LEFT=passed} {WORKSPACE_MOVE_LEFT=failed} "moving a focused window to workspace one"

        qmp_key_chord $qmp {meta_l} 3
        set ws_three {active=; for n in $(seq 1 15); do active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); [[ "$active" == 3 ]] && break; sleep 1; done; if [[ "$active" == 3 ]]; then echo WORKSPACE_NUMBER_THREE=passed; else echo WORKSPACE_NUMBER_THREE=failed; printf 'WORKSPACE_NUMBER_DIAGNOSTICS_BEGIN\n'; grep -E 'Super number input keycode|Switched to workspace' /tmp/seyrix-compositor.log | tail -n 12; printf 'WORKSPACE_NUMBER_DIAGNOSTICS_END\n'; fi}
        run_serial_check $ws_three {WORKSPACE_NUMBER_THREE=passed} {WORKSPACE_NUMBER_THREE=failed} "Super+3 active workspace state" 20
        qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-3-empty.ppm"
        qmp_key_chord $qmp {meta_l} 4
        set ws_four {active=; for n in $(seq 1 15); do active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); [[ "$active" == 4 ]] && break; sleep 1; done; if [[ "$active" == 4 ]]; then echo WORKSPACE_NUMBER_FOUR=passed; else echo WORKSPACE_NUMBER_FOUR=failed; printf 'WORKSPACE_NUMBER_DIAGNOSTICS_BEGIN\n'; grep -E 'Super number input keycode|Switched to workspace' /tmp/seyrix-compositor.log | tail -n 12; printf 'WORKSPACE_NUMBER_DIAGNOSTICS_END\n'; fi}
        run_serial_check $ws_four {WORKSPACE_NUMBER_FOUR=passed} {WORKSPACE_NUMBER_FOUR=failed} "Super+4 active workspace state" 20
        qmp_key_chord $qmp {meta_l} ret
        set ws_four_terminal_ready {for n in $(seq 1 60); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); pid=$(pgrep -u 1000 -x weston-terminal | tail -n 1); if [[ "$count" -ge 3 ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log; then break; fi; sleep 1; done; if [[ "$count" -ge 3 ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log; then echo WORKSPACE_FOUR_WINDOW_READY=passed; else echo WORKSPACE_FOUR_WINDOW_READY=failed; pgrep -a -u 1000 -x weston-terminal || true; fi}
        run_serial_check $ws_four_terminal_ready {WORKSPACE_FOUR_WINDOW_READY=passed} {WORKSPACE_FOUR_WINDOW_READY=failed} "workspace four active terminal process and map readiness" 70
        qmp_type $qmp "mkdir -p /tmp/seyrix-ws-four\ncd /tmp/seyrix-ws-four\ntouch active-terminal-before\n"
        qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-4-visible.ppm"
        set ws_boundary_before {before=$(grep -c 'Moved focused window to workspace' /tmp/seyrix-compositor.log || true); switches=$(grep -c 'Switched to workspace' /tmp/seyrix-compositor.log || true); active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); pid=$(pgrep -u 1000 -x weston-terminal | tail -n 1); if test -f /tmp/seyrix-ws-four/active-terminal-before && [[ -n "$pid" && "$active" == 4 ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log; then echo "$before" > /tmp/seyrix-ws-moves-before; echo "$switches" > /tmp/seyrix-ws-switches-before; echo WORKSPACE_BOUNDARY_BASELINE=ready; else echo WORKSPACE_BOUNDARY_BASELINE=failed; fi}
        run_serial_check $ws_boundary_before {WORKSPACE_BOUNDARY_BASELINE=ready} {WORKSPACE_BOUNDARY_BASELINE=failed} "workspace four active visible-client boundary baseline" 20
        qmp_key_chord $qmp {meta_l} right
        qmp_key_chord $qmp {meta_l shift} right
        qmp_type $qmp "touch /tmp/seyrix-ws-four/active-terminal-after\n"
        set ws_boundary_after {switches=$(grep -c 'Switched to workspace' /tmp/seyrix-compositor.log || true); moves=$(grep -c 'Moved focused window to workspace' /tmp/seyrix-compositor.log || true); active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); if test -f /tmp/seyrix-ws-four/active-terminal-after && [[ "$active" == 4 && "$switches" -eq "$(cat /tmp/seyrix-ws-switches-before)" && "$moves" -eq "$(cat /tmp/seyrix-ws-moves-before)" ]]; then echo WORKSPACE_BOUNDARY_RIGHT=passed; else echo WORKSPACE_BOUNDARY_RIGHT=failed; fi}
        run_serial_check $ws_boundary_after {WORKSPACE_BOUNDARY_RIGHT=passed} {WORKSPACE_BOUNDARY_RIGHT=failed} "workspace four no-wrap with visible client still interactive" 20
        qmp_key_chord $qmp {meta_l} q

        qmp_key_chord $qmp {meta_l} 1
        after 300
        qmp_key_chord $qmp {meta_l} q
        after 500
        qmp_key_chord $qmp {meta_l} q
        after 500
        qmp_key_chord $qmp {meta_l} 2
        after 300
        qmp_key_chord $qmp {meta_l} q
        after 700
        set ws_destroyed {if [[ "$(pgrep -u 1000 -x weston-terminal | wc -l)" -eq 0 ]]; then echo WORKSPACE_WINDOW_CLEANUP=passed; else echo WORKSPACE_WINDOW_CLEANUP=failed; fi}
        run_serial_check $ws_destroyed {WORKSPACE_WINDOW_CLEANUP=passed} {WORKSPACE_WINDOW_CLEANUP=failed} "closing windows across workspaces"

        qmp_key_chord $qmp {meta_l shift} q
        after 1500
        set compositor_exit_check {if ! pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null; then echo WORKSPACE_COMPOSITOR_EXIT=passed; else echo WORKSPACE_COMPOSITOR_EXIT=failed; fi}
        run_serial_check $compositor_exit_check {WORKSPACE_COMPOSITOR_EXIT=passed} {WORKSPACE_COMPOSITOR_EXIT=failed} "compositor shutdown"
        send -- "poweroff\r"
        expect {
            -re {systemd-shutdown|Powering off|reached target Power-Off|reboot: Power down} {}
            timeout {puts stderr "Timed out waiting for guest shutdown after the workspace checks."; exit 1}
            eof {}
        }
        puts "CLEAN_SHUTDOWN=passed"
        if {$acceptance_failures > 0} {
            puts stderr "ACCEPTANCE_FAILURES=$acceptance_failures; QEMU and guest shutdown completed."
            exit 1
        }
        exit 0
    }

    qmp_hmp $qmp "screendump $run_dir/seyrix-background-terminal.ppm"
    qmp_type $qmp "touch /tmp/seyrix-keyboard-ok\n"
    after 500
    qmp_hmp $qmp "screendump $run_dir/seyrix-after-keyboard.ppm"
    set keyboard_check_command {if test -f /tmp/seyrix-keyboard-ok; then echo KEYBOARD_INPUT=passed; else echo KEYBOARD_INPUT=failed; fi}
    send -- "$keyboard_check_command\r"
    expect {
        -re {KEYBOARD_INPUT=passed} {}
        -re {KEYBOARD_INPUT=failed} {
            puts stderr "Keyboard input did not reach the focused Wayland terminal."
            exit 1
        }
        timeout {
            puts stderr "Timed out checking keyboard input in Seyrix."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before the Seyrix keyboard check."
            exit 1
        }
    }

	if {$phase2c} {
		set output_configuration_command {output_name=$(sed -n 's/.*Output \([^ ]*\) active at.*/\1/p' /tmp/seyrix-compositor.log | head -n 1); wayland_display=$(sed -n 's/.*WAYLAND_DISPLAY=\([^ ]*\).*/\1/p' /tmp/seyrix-compositor.log | head -n 1); if [[ -n "$output_name" && -n "$wayland_display" ]] && runuser -u seyrix -- env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY="$wayland_display" wlr-randr --dryrun --output "$output_name" --pos 8,8 --scale 1.25 && runuser -u seyrix -- env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY="$wayland_display" wlr-randr --output "$output_name" --pos 8,8 --scale 1.25 && runuser -u seyrix -- env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY="$wayland_display" wlr-randr --output "$output_name" --pos 0,0 --scale 1.0; then echo OUTPUT_CONFIGURATION=passed; else echo OUTPUT_CONFIGURATION=failed; fi}
		send -- "$output_configuration_command\r"
		expect {
			-re {OUTPUT_CONFIGURATION=passed} {puts "OUTPUT_CONFIGURATION=passed"}
			-re {OUTPUT_CONFIGURATION=failed} {
				puts stderr "wlr-output-management test/apply or position restore failed."
				exit 1
			}
			timeout {
				puts stderr "Timed out testing wlr-output-management configuration."
				exit 1
			}
			eof {
				puts stderr "QEMU exited during output configuration testing."
				exit 1
			}
		}
	}

    qmp_mouse_drag $qmp 4200 5900 12300 5900 left
    after 500
    qmp_hmp $qmp "screendump $run_dir/seyrix-pointer-selection.ppm"
    qmp_mouse_move $qmp 14000 14000
    qmp_mouse_click $qmp
    qmp_type $qmp "touch /tmp/seyrix-pointer-ok\n"
    after 500
    set pointer_check_command {sleep 1; if test -f /tmp/seyrix-pointer-ok && grep -q 'BTN_LEFT' /tmp/seyrix-evtest-mouse.log && grep -q 'ABS_X' /tmp/seyrix-evtest-mouse.log && grep -q 'ABS_Y' /tmp/seyrix-evtest-mouse.log; then echo POINTER_INPUT=passed; else echo POINTER_INPUT=failed; fi; printf 'POINTER_EVENTS_BEGIN\n'; grep -E 'BTN_LEFT|ABS_X|ABS_Y' /tmp/seyrix-evtest-mouse.log | tail -n 16; printf 'POINTER_EVENTS_END\n'}
    send -- "$pointer_check_command\r"
    expect {
        -re {POINTER_INPUT=passed} {}
        -re {POINTER_INPUT=failed} {
            puts stderr "QEMU pointer input did not reach the compositor and Wayland terminal."
            exit 1
        }
        timeout {
            puts stderr "Timed out checking pointer input in Seyrix."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before the Seyrix pointer check."
            exit 1
        }
    }

    qmp_key_chord $qmp {meta_l} ret
    after 1500
    qmp_hmp $qmp "screendump $run_dir/seyrix-two-windows.ppm"
    set coexist_check_command {for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -ge 2 ]]; then break; fi; sleep 1; done; mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); count=$(pgrep -u 1000 -x weston-terminal | wc -l); printf 'WINDOW_MAPPED_COUNT=%s\nTERMINAL_COUNT=%s\n' "$mapped" "$count"; if [[ "$mapped" -ge 2 && "$count" -ge 2 ]]; then echo WINDOWS_COEXIST=passed; else echo WINDOWS_COEXIST=failed; fi}
    send -- "$coexist_check_command\r"
    expect {
        -re {WINDOWS_COEXIST=passed} {}
        -re {WINDOWS_COEXIST=failed} {
            puts stderr "Two independent xdg-shell windows did not coexist."
            exit 1
        }
        timeout {
            puts stderr "Timed out checking coexistence of two windows."
            exit 1
        }
        eof {
            puts stderr "QEMU exited during the multiple-window check."
            exit 1
        }
    }

    qmp_type $qmp "touch /tmp/seyrix-second-focus-ok\n"
    after 500
    set second_focus_command {if test -f /tmp/seyrix-second-focus-ok; then echo WINDOW_FOCUS_NEW=passed; else echo WINDOW_FOCUS_NEW=failed; fi}
    send -- "$second_focus_command\r"
    expect {
        -re {WINDOW_FOCUS_NEW=passed} {}
        -re {WINDOW_FOCUS_NEW=failed} {
            puts stderr "Keyboard focus did not move to the newly mapped window."
            exit 1
        }
        timeout {
            puts stderr "Timed out checking focus on the new window."
            exit 1
        }
        eof {
            puts stderr "QEMU exited during the new-window focus check."
            exit 1
        }
    }

    set move_before_command {bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot pointer-move-before 2 1}
    run_serial_check $move_before_command {WM_GEOMETRY_SNAPSHOT=passed label=pointer-move-before count=2} {WM_GEOMETRY_FAILED} "record tiled geometry before Alt+drag-to-float" 25
    set move_baseline_command {bash /tmp/seyrix-qemu-guest-helper.sh move-baseline}
    set move_baseline_ok 0
    puts "STAGE_BEGIN name={mapped-window geometry and pointer evidence baseline} timeout_s=20"
    send -- "$move_baseline_command\r"
    expect {
        -re {WINDOW_MOVE_BASELINE=ready qmp_start=([0-9]+),([0-9]+) qmp_end=([0-9]+),([0-9]+)\r} {
            set move_baseline_ok 1
            set move_pointer_x1 $expect_out(1,string)
            set move_pointer_y1 $expect_out(2,string)
            set move_pointer_x2 $expect_out(3,string)
            set move_pointer_y2 $expect_out(4,string)
            puts "STAGE_RESULT name={mapped-window geometry and pointer evidence baseline} result=PASS"
        }
        -re {WINDOW_MOVE_BASELINE=failed} {
            puts stderr "STAGE_RESULT name={mapped-window geometry and pointer evidence baseline} result=FAIL"
            incr acceptance_failures
        }
        timeout {
            puts stderr "STAGE_RESULT name={mapped-window geometry and pointer evidence baseline} result=INCOMPLETE reason=timeout"
            incr acceptance_failures
        }
        eof {puts stderr "QEMU exited while recording the movement baseline."; exit 1}
    }
    if {$move_baseline_ok} {
        qmp_key_transition $qmp alt 1
        qmp_mouse_drag $qmp $move_pointer_x1 $move_pointer_y1 \
            $move_pointer_x2 $move_pointer_y2 left
        qmp_key_transition $qmp alt 0
        set move_check_command {read -r pid surface x_before y_before end_before button_before alt_before gesture_before classification_before evdev_button_before evdev_xy_before < /tmp/seyrix-window-move-before; read -r evdev_x_before evdev_y_before <<< "$evdev_xy_before"; for n in $(seq 1 15); do end_after=$(grep -Fc "GEOMETRY_EVIDENCE event=grab-end pid=$pid surface=$surface " /tmp/seyrix-compositor.log || true); [[ "$end_after" -gt "$end_before" ]] && break; sleep 1; done; grab_line=$(grep -F "GEOMETRY_EVIDENCE event=grab-end pid=$pid surface=$surface " /tmp/seyrix-compositor.log | tail -n 1); button_after=$(grep -Fc 'Pointer button press button=272' /tmp/seyrix-compositor.log || true); alt_after=$(grep -Fc 'Alt pointer gesture button=272' /tmp/seyrix-compositor.log || true); gesture_after=$(grep -Fc 'Window move gesture started' /tmp/seyrix-compositor.log || true); classification_after=$(grep -Fc 'Focused window classification changed to floating' /tmp/seyrix-compositor.log || true); evdev_button_after=$(grep -Ec 'Event: time .*code 272 \(BTN_LEFT\)' /tmp/seyrix-evtest-mouse.log || true); evdev_x_after=$(grep -Ec 'Event: time .*code 0 \(ABS_X\)' /tmp/seyrix-evtest-mouse.log || true); evdev_y_after=$(grep -Ec 'Event: time .*code 1 \(ABS_Y\)' /tmp/seyrix-evtest-mouse.log || true); moved=0; x_after= y_after=; if [[ "$grab_line" =~ GEOMETRY_EVIDENCE[[:space:]]event=grab-end[[:space:]]pid=$pid[[:space:]]surface=$surface[[:space:]]x=(-?[0-9]+)[[:space:]]y=(-?[0-9]+) ]]; then x_after=${BASH_REMATCH[1]}; y_after=${BASH_REMATCH[2]}; dx=$((x_after-x_before)); dy=$((y_after-y_before)); abs_dx=${dx#-}; abs_dy=${dy#-}; if (( abs_dx >= 10 || abs_dy >= 10 )); then moved=1; fi; fi; printf 'WINDOW_MOVE_SCENE_BEFORE=%s,%s\nWINDOW_MOVE_SCENE_AFTER=%s,%s\nWINDOW_MOVE_TARGET_PID=%s\nWINDOW_MOVE_TARGET_SURFACE=%s\n' "$x_before" "$y_before" "${x_after:-unavailable}" "${y_after:-unavailable}" "$pid" "$surface"; printf 'POINTER_COMPOSITOR_BUTTON_DELTA=%s\nPOINTER_COMPOSITOR_ALT_GESTURE_DELTA=%s\nPOINTER_COMPOSITOR_MOVE_START_DELTA=%s\nPOINTER_CLASSIFICATION_FLOATING_DELTA=%s\nPOINTER_EVDEV_BUTTON_DELTA=%s\nPOINTER_EVDEV_ABS_X_DELTA=%s\nPOINTER_EVDEV_ABS_Y_DELTA=%s\n' "$((button_after-button_before))" "$((alt_after-alt_before))" "$((gesture_after-gesture_before))" "$((classification_after-classification_before))" "$((evdev_button_after-evdev_button_before))" "$((evdev_x_after-evdev_x_before))" "$((evdev_y_after-evdev_y_before))"; grep -E 'Pointer button press|Alt pointer gesture|Window move gesture started|Window move update|Focused window classification changed|GEOMETRY_EVIDENCE event=grab-end' /tmp/seyrix-compositor.log | tail -n 14; grep -E 'ABS_X|ABS_Y|BTN_LEFT|BTN_RIGHT' /tmp/seyrix-evtest-mouse.log | tail -n 12; if (( moved == 1 && end_after > end_before && button_after > button_before && alt_after > alt_before && gesture_after > gesture_before && classification_after > classification_before && evdev_button_after > evdev_button_before && evdev_x_after > evdev_x_before && evdev_y_after > evdev_y_before )); then echo WINDOW_MOVE=passed; else echo WINDOW_MOVE=failed; fi}
        puts "STAGE_BEGIN name={real Alt+left movement with same-window scene geometry change} timeout_s=15"
        send -- "$move_check_command\r"
        expect {
            -re {WINDOW_MOVE=passed} {puts "STAGE_RESULT name={real Alt+left movement with same-window scene geometry change} result=PASS"}
            -re {WINDOW_MOVE=failed} {puts stderr "STAGE_RESULT name={real Alt+left movement with same-window scene geometry change} result=FAIL"; puts stderr "Alt+left drag did not move the mapped window by a measurable amount."; incr acceptance_failures}
            timeout {puts stderr "STAGE_RESULT name={real Alt+left movement with same-window scene geometry change} result=INCOMPLETE reason=timeout"; incr acceptance_failures}
            eof {puts stderr "QEMU exited during the window movement check."; exit 1}
        }
        qmp_hmp $qmp "screendump $run_dir/seyrix-window-moved.ppm"
    } else {
        puts "WINDOW_MOVE=INCOMPLETE reason=geometry-baseline-unavailable"
    }
	qmp_key_chord $qmp {meta_l} f
	set move_retile_check {if grep -Fq 'Focused window classification changed to tiled' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh wm-snapshot pointer-move-after 2 1 && bash /tmp/seyrix-qemu-guest-helper.sh wm-same-identity pointer-move-before pointer-move-after; then echo WINDOW_MOVE_RETILE=passed; else echo WINDOW_MOVE_RETILE=failed; fi}
	run_serial_check $move_retile_check {WINDOW_MOVE_RETILE=passed} {WINDOW_MOVE_RETILE=failed} "restore tiled classification after drag-to-float" 30

	qmp_key_chord $qmp {meta_l shift} f
	set phase2c_floating_mode {if grep -Fq 'Workspace 1 layout mode changed to floating' /tmp/seyrix-compositor.log; then echo PHASE2C_FLOATING_MODE=passed; else echo PHASE2C_FLOATING_MODE=failed; fi}
	run_serial_check $phase2c_floating_mode {PHASE2C_FLOATING_MODE=passed} {PHASE2C_FLOATING_MODE=failed} "prepare floating mode for Phase 2C resize regression checks" 20

    if {$phase2c} {
        set resize_cases {
            {top {} {} normal}
            {bottom {} {} normal}
            {left {} {} normal}
            {right {} {} normal}
            {top-left {} {} normal}
            {top-right {} {} normal}
            {bottom-left {} {} normal}
            {bottom-right {} {} normal}
            {bottom-right 400x300 {} in}
            {bottom-right {} 480x360 out}
        }
        set resize_target_unavailable 0
        foreach resize_case $resize_cases {
            lassign $resize_case resize_edge resize_min resize_max resize_direction
            set start_command "bash /tmp/seyrix-qemu-guest-helper.sh resize-start $resize_edge"
            if {$resize_min ne ""} {
                append start_command " $resize_min"
            } else {
                append start_command { ""}
            }
            if {$resize_max ne ""} {
                append start_command " $resize_max"
            } else {
                append start_command { ""}
            }
            append start_command " $resize_direction"
            set start_result [run_serial_capture $start_command \
                {RESIZE_TARGET_READY edge=([^ ]+) pid=([0-9]+) surface=([0-9]+) scene=(-?[0-9]+),(-?[0-9]+) size=([0-9]+)x([0-9]+) qmp_start=([0-9]+),([0-9]+) qmp_end=([0-9]+),([0-9]+)\r} \
                {RESIZE_TARGET_FAILED|QEMU_GUEST_HELPER=failed} \
                "interactive xdg resize $resize_edge mapped-target readiness" 55]
            lassign $start_result start_status ready_edge target_pid target_surface scene_x scene_y initial_width initial_height pointer_x1 pointer_y1 pointer_x2 pointer_y2
            if {$start_status ne "pass"} {
                puts "RESIZE_EDGE=$resize_edge INCOMPLETE reason=target-readiness"
                puts "RESIZE_REMAINING=NOT_RUN reason=shared-resize-client-readiness"
                set resize_target_unavailable 1
                break
            }
            qmp_mouse_move $qmp $pointer_x1 $pointer_y1
            after 100
            qmp_mouse_button $qmp left 1
            set resize_grab_command [format {for n in $(seq 1 100); do grep -Fq 'RESIZE_FRAME_START pid=%s surface=%s ' /tmp/seyrix-compositor.log && break; sleep 0.1; done; if grep -Fq 'RESIZE_FRAME_START pid=%s surface=%s ' /tmp/seyrix-compositor.log; then echo RESIZE_GRAB_STARTED=passed; else echo RESIZE_GRAB_STARTED=failed; fi} \
                $target_pid $target_surface $target_pid $target_surface]
            run_serial_check $resize_grab_command {RESIZE_GRAB_STARTED=passed} \
                {RESIZE_GRAB_STARTED=failed} \
                "compositor resize grab start for $resize_edge $resize_direction" 20
            if {$last_serial_check_result ne "pass"} {
                qmp_mouse_button $qmp left 0
				set resize_cleanup_command "bash /tmp/seyrix-qemu-guest-helper.sh resize-cleanup $resize_edge $resize_direction"
				run_serial_check $resize_cleanup_command {RESIZE_CLEANUP=passed} {QEMU_GUEST_HELPER=failed} "clean up failed resize probe $resize_edge $resize_direction" 15
                puts "RESIZE_EDGE=$resize_edge direction=$resize_direction result=INCOMPLETE reason=grab-start-not-observed"
                continue
            }
            qmp_mouse_move $qmp $pointer_x2 $pointer_y2
            after 250
            qmp_mouse_button $qmp left 0
            after 100
            qmp_hmp $qmp "screendump $run_dir/seyrix-resize-$resize_edge-$resize_direction.ppm"
            set check_command "bash /tmp/seyrix-qemu-guest-helper.sh resize-check $resize_edge"
            if {$resize_min ne ""} {
                append check_command " $resize_min"
            } else {
                append check_command { ""}
            }
            if {$resize_max ne ""} {
                append check_command " $resize_max"
            } else {
                append check_command { ""}
            }
            append check_command " $resize_direction"
            set check_result [run_serial_capture $check_command \
                {RESIZE_ASSERTION=passed edge=([^ ]+) before=([0-9]+x[0-9]+) after=([0-9]+x[0-9]+) scene=(-?[0-9]+),(-?[0-9]+)\r} \
                {RESIZE_ASSERTION_FAILED|QEMU_GUEST_HELPER=failed} \
                "committed geometry and constraints for xdg resize $resize_edge $resize_direction" 55]
            if {[lindex $check_result 0] eq "pass"} {
                puts "RESIZE_EDGE=$resize_edge direction=$resize_direction result=PASS identity=$target_pid,$target_surface"
            } else {
                puts "RESIZE_EDGE=$resize_edge direction=$resize_direction result=INCOMPLETE identity=$target_pid,$target_surface"
            }
        }
        if {$resize_target_unavailable} {
            puts "WINDOW_RESIZE=INCOMPLETE reason=resize-client-target-readiness"
        }
    } else {
        puts "WINDOW_RESIZE=INCOMPLETE reason=phase2c-client-probe-required"
    }

	qmp_key_chord $qmp {meta_l shift} h
	set phase2c_hybrid_restore {if grep -Fq 'Workspace 1 layout mode changed to hybrid' /tmp/seyrix-compositor.log; then echo PHASE2C_HYBRID_RESTORE=passed; else echo PHASE2C_HYBRID_RESTORE=failed; fi}
	run_serial_check $phase2c_hybrid_restore {PHASE2C_HYBRID_RESTORE=passed} {PHASE2C_HYBRID_RESTORE=failed} "restore Hybrid mode after floating pointer regression checks" 20

    qmp_mouse_move $qmp 2815 20479
    qmp_mouse_click $qmp
    qmp_type $qmp "touch /tmp/seyrix-first-focus-ok\n"
    after 500
    set first_focus_command {if test -f /tmp/seyrix-first-focus-ok; then echo WINDOW_FOCUS_CLICK=passed; else echo WINDOW_FOCUS_CLICK=failed; fi}
    send -- "$first_focus_command\r"
    expect {
        -re {WINDOW_FOCUS_CLICK=passed} {}
        -re {WINDOW_FOCUS_CLICK=failed} {
            puts stderr "Pointer click did not focus the lower Wayland window."
            exit 1
        }
        timeout {
            puts stderr "Timed out checking pointer-driven window focus."
            exit 1
        }
        eof {
            puts stderr "QEMU exited during the pointer focus check."
            exit 1
        }
    }

    set close_first_baseline_command {terminal_processes=$(pgrep -u 1000 -x weston-terminal | wc -l); destroyed=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); if [[ "$terminal_processes" -eq 2 ]]; then printf '%s\n' "$destroyed" > /tmp/seyrix-close-first-destroyed-before; echo WINDOW_CLOSE_BASELINE=passed; else echo WINDOW_CLOSE_BASELINE=failed; printf 'WINDOW_CLOSE_BASELINE_DIAGNOSTICS terminals=%s destroyed=%s\n' "$terminal_processes" "$destroyed"; fi}
    run_serial_check $close_first_baseline_command {WINDOW_CLOSE_BASELINE=passed} {WINDOW_CLOSE_BASELINE=failed} "record two-window close baseline" 20
    qmp_key_chord $qmp {meta_l} q
    after 1500
    set close_first_command {terminal_processes=$(pgrep -u 1000 -x weston-terminal | wc -l); before=$(cat /tmp/seyrix-close-first-destroyed-before); destroyed=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); printf 'TERMINAL_PROCESS_COUNT_AFTER_CLOSE=%s\nDESTROYED_BEFORE=%s\nDESTROYED_AFTER=%s\n' "$terminal_processes" "$before" "$destroyed"; if [[ "$terminal_processes" -eq 1 && "$destroyed" -eq $((before + 1)) ]]; then echo WINDOW_CLOSE_FIRST=passed; else echo WINDOW_CLOSE_FIRST=failed; printf 'WINDOW_CLOSE_DIAGNOSTICS_BEGIN\n'; pgrep -a -u 1000 -x weston-terminal || true; grep -E 'Close requested|Window destroyed|Window mapped|Focus changed|focused' /tmp/seyrix-compositor.log | tail -n 30; printf 'WINDOW_CLOSE_DIAGNOSTICS_END\n'; fi}
    send -- "$close_first_command\r"
    expect {
        -re {WINDOW_CLOSE_FIRST=passed} {}
        -re {WINDOW_CLOSE_FIRST=failed} {
            puts stderr "Super+Q did not close the focused Wayland application window."
            incr acceptance_failures
        }
        timeout {
            puts stderr "Timed out checking first-window close."
            exit 1
        }
        eof {
            puts stderr "QEMU exited during the first-window close check."
            exit 1
        }
    }

    qmp_key_chord $qmp {meta_l} q
    set close_all_command {for n in $(seq 1 80); do terminal_processes=$(pgrep -u 1000 -x weston-terminal | wc -l); before=$(cat /tmp/seyrix-close-first-destroyed-before); destroyed=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); if [[ "$terminal_processes" -eq 0 && "$destroyed" -eq $((before + 2)) ]]; then break; fi; sleep 0.1; done; printf 'TERMINAL_PROCESS_COUNT_AFTER_CLOSE_ALL=%s\nDESTROYED_BEFORE=%s\nDESTROYED_AFTER=%s\n' "$terminal_processes" "$before" "$destroyed"; if [[ "$terminal_processes" -eq 0 && "$destroyed" -eq $((before + 2)) ]]; then echo WINDOW_CLOSE=passed; else echo WINDOW_CLOSE=failed; printf 'WINDOW_CLOSE_DIAGNOSTICS_BEGIN\n'; pgrep -a -u 1000 -x weston-terminal || true; grep -E 'Window destroyed|Window unmapped' /tmp/seyrix-compositor.log | tail -n 12; printf 'WINDOW_CLOSE_DIAGNOSTICS_END\n'; fi}
    send -- "$close_all_command\r"
    expect {
        -re {WINDOW_CLOSE=passed} {}
        -re {WINDOW_CLOSE=failed} {
            puts stderr "Both xdg-shell windows did not close cleanly."
            incr acceptance_failures
        }
        timeout {
            puts stderr "Timed out checking application window cleanup."
            exit 1
        }
        eof {
            puts stderr "QEMU exited during application window cleanup."
            exit 1
        }
    }

	if {$phase2c} {
		set shell_ready_check {for n in $(seq 1 30); do panel=$(pgrep -u 1000 -x seyrix-shell | head -n 1); if [[ -n "$panel" ]] && grep -q 'Layer shell surface mapped namespace=seyrix-panel' /tmp/seyrix-compositor.log; then break; fi; sleep 1; done; if [[ -n "$panel" ]] && grep -q 'Layer shell surface mapped namespace=seyrix-panel' /tmp/seyrix-compositor.log; then echo PHASE2C_PANEL=passed; else echo PHASE2C_PANEL=failed; printf 'PANEL_START_DIAGNOSTICS pid=%s map_count=%s\n' "${panel:-missing}" "$(grep -c 'Layer shell surface mapped namespace=seyrix-panel' /tmp/seyrix-compositor.log || true)"; grep -E 'Started isolated Seyrix layer-shell panel|Layer shell surface mapped|seyrix panel' /tmp/seyrix-compositor.log | tail -n 16; fi}
		run_serial_check $shell_ready_check {PHASE2C_PANEL=passed} {PHASE2C_PANEL=failed} "isolated layer-shell panel startup"
		qmp_hmp $qmp "screendump $run_dir/seyrix-panel-workspace-before.ppm"
		qmp_mouse_move $qmp 4659 546
		qmp_mouse_click $qmp
		set panel_select_check {for n in $(seq 1 15); do grep -q 'Switched to workspace 3' /tmp/seyrix-compositor.log && break; sleep 1; done; panel=$(pgrep -u 1000 -x seyrix-shell | head -n 1); if grep -q 'Switched to workspace 3' /tmp/seyrix-compositor.log && [[ -n "$panel" ]]; then echo PHASE2C_PANEL_WORKSPACE_SELECT=passed; else echo PHASE2C_PANEL_WORKSPACE_SELECT=failed; printf 'PANEL_PROCESS=%s\n' "${panel:-missing}"; grep -E 'Switched to workspace|seyrix-panel|Started isolated Seyrix' /tmp/seyrix-compositor.log | tail -n 12; fi}
		run_serial_check $panel_select_check {PHASE2C_PANEL_WORKSPACE_SELECT=passed} {PHASE2C_PANEL_WORKSPACE_SELECT=failed} "native panel workspace selection and process retention" 20
		set panel_before [file normalize [file join $run_dir seyrix-panel-workspace-before.ppm]]
		set panel_after [file normalize [file join $run_dir seyrix-panel-workspace-after.ppm]]
		set pixel_helper [file join [file dirname [file normalize [info script]]] qemu-panel-pixel-check.py]
		set pixel_passed 0
		for {set pixel_attempt 0} {$pixel_attempt < 20 && !$pixel_passed} {incr pixel_attempt} {
			qmp_hmp $qmp "screendump $panel_after"
			if {![catch {set pixel_result [exec python3 $pixel_helper $panel_before $panel_after 1 3]} pixel_error]} {
                puts "PANEL_PIXEL_ATTEMPTS=[expr {$pixel_attempt + 1}]"
				puts $pixel_result
				set pixel_passed 1
			} else {
				after 250
			}
		}
		if {!$pixel_passed} {
            puts stderr "PANEL_PIXEL_ATTEMPTS=20"
			puts stderr "Panel workspace indicator pixel assertion failed after 20 screenshot observations: $pixel_error"
			puts "PANEL_PIXEL_ASSERTION=failed"
			exit 1
		}
		qmp_key_chord $qmp {meta_l} 1
		set workspace_one_active {for n in $(seq 1 20); do active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); if [[ -z "$active" ]]; then active=1; fi; [[ "$active" == 1 ]] && break; sleep 1; done; if [[ "$active" == 1 ]]; then echo WORKSPACE_ONE_ACTIVE=passed; else echo WORKSPACE_ONE_ACTIVE=failed; grep -E 'Super number input|Direct workspace selection|Switched to workspace' /tmp/seyrix-compositor.log | tail -n 20; fi}
		run_serial_check $workspace_one_active {WORKSPACE_ONE_ACTIVE=passed} {WORKSPACE_ONE_ACTIVE=failed} "workspace one activation before no-wrap check" 25
		qmp_key_chord $qmp {meta_l} ret
		set workspace_one_terminal_ready {for n in $(seq 1 60); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); pid=$(pgrep -u 1000 -x weston-terminal | tail -n 1); if [[ "$count" -ge 1 ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log; then break; fi; sleep 1; done; if [[ "$count" -ge 1 ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log; then echo WORKSPACE_ONE_TERMINAL_READY=passed; else echo WORKSPACE_ONE_TERMINAL_READY=failed; pgrep -a -u 1000 -x weston-terminal || true; fi}
		run_serial_check $workspace_one_terminal_ready {WORKSPACE_ONE_TERMINAL_READY=passed} {WORKSPACE_ONE_TERMINAL_READY=failed} "workspace one first terminal process and map readiness" 70
		after 600
		qmp_type $qmp "mkdir -p /tmp/phase2c-ws1-first\ncd /tmp/phase2c-ws1-first\ntouch first-terminal-ready\n"
		set workspace_one_terminal_marker {for n in $(seq 1 10); do test -f /tmp/phase2c-ws1-first/first-terminal-ready && break; sleep 1; done; if test -f /tmp/phase2c-ws1-first/first-terminal-ready; then echo WORKSPACE_ONE_TERMINAL_MARKER=passed; else echo WORKSPACE_ONE_TERMINAL_MARKER=failed; fi}
		run_serial_check $workspace_one_terminal_marker {WORKSPACE_ONE_TERMINAL_MARKER=passed} {WORKSPACE_ONE_TERMINAL_MARKER=failed} "workspace one first terminal command marker" 20
		qmp_type $qmp "touch /tmp/phase2c-boundary-ws1-before\n"
		set workspace_boundary_left_check {before=$(grep -c 'Moved focused window to workspace' /tmp/seyrix-compositor.log || true); switches=$(grep -c 'Switched to workspace' /tmp/seyrix-compositor.log || true); pid=$(pgrep -u 1000 -x weston-terminal | head -n 1); if test -f /tmp/phase2c-boundary-ws1-before && [[ -n "$pid" ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log && grep -q 'Switched to workspace 1' /tmp/seyrix-compositor.log; then echo "$before" > /tmp/phase2c-boundary-move-before; echo "$switches" > /tmp/phase2c-boundary-switch-before; echo WORKSPACE_BOUNDARY_BASELINE=passed; else echo WORKSPACE_BOUNDARY_BASELINE=failed; fi}
		run_serial_check $workspace_boundary_left_check {WORKSPACE_BOUNDARY_BASELINE=passed} {WORKSPACE_BOUNDARY_BASELINE=failed} "workspace one active visible-client boundary baseline" 20
		qmp_key_chord $qmp {meta_l} left
		qmp_key_chord $qmp {meta_l shift} left
		qmp_type $qmp "touch /tmp/phase2c-boundary-ws1-after\n"
		set workspace_boundary_left_check {before=$(cat /tmp/phase2c-boundary-move-before); switches=$(cat /tmp/phase2c-boundary-switch-before); moved=$(grep -c 'Moved focused window to workspace' /tmp/seyrix-compositor.log || true); after=$(grep -c 'Switched to workspace' /tmp/seyrix-compositor.log || true); pid=$(pgrep -u 1000 -x weston-terminal | head -n 1); if test -f /tmp/phase2c-boundary-ws1-after && [[ -n "$pid" ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log && grep -q 'Switched to workspace 1' /tmp/seyrix-compositor.log && [[ "$moved" -eq "$before" && "$after" -eq "$switches" ]]; then echo WORKSPACE_BOUNDARY_LEFT=passed; else echo WORKSPACE_BOUNDARY_LEFT=failed; fi}
		run_serial_check $workspace_boundary_left_check {WORKSPACE_BOUNDARY_LEFT=passed} {WORKSPACE_BOUNDARY_LEFT=failed} "workspace one no-wrap with visible client still interactive" 20
		puts "PHASE2C_PROTOCOL_PROBES=started"
		qmp_key_chord $qmp {meta_l} ret
		after 1200

		qmp_type $qmp "SEYRIX_PROBE_LOG=/tmp/phase2c-state.log seyrix-protocol-probe --state-cycle\n"
		set probe_state_check {for n in $(seq 1 90); do if grep -q 'PROBE_EXIT result=passed' /tmp/phase2c-state.log 2>/dev/null; then break; fi; sleep 1; done; if seyrix-phase2c-probe-check state /tmp/phase2c-state.log; then echo PHASE2C_STATE_PROBE=passed; else echo PHASE2C_STATE_PROBE=failed; fi}
		run_serial_check $probe_state_check {PHASE2C_STATE_PROBE=passed} {PHASE2C_STATE_PROBE=failed} "maximize/fullscreen configure-cycle probe"

		qmp_type $qmp "SEYRIX_PROBE_LOG=/tmp/phase2c-rapid.log seyrix-protocol-probe --rapid-state --app-id seyrix.rapid-state-probe\n"
		set probe_rapid_check {for n in $(seq 1 90); do if grep -q 'PROBE_EXIT result=passed' /tmp/phase2c-rapid.log 2>/dev/null; then break; fi; sleep 1; done; if seyrix-phase2c-probe-check rapid /tmp/phase2c-rapid.log; then echo PHASE2C_RAPID_PROBE=passed; else echo PHASE2C_RAPID_PROBE=failed; fi}
		run_serial_check $probe_rapid_check {PHASE2C_RAPID_PROBE=passed} {PHASE2C_RAPID_PROBE=failed} "rapid xdg-shell state transition probe"

		qmp_type $qmp "SEYRIX_PROBE_LOG=/tmp/phase2c-decoration.log seyrix-protocol-probe --client-decoration\n"
		set probe_decoration_check {for n in $(seq 1 90); do if grep -q 'PROBE_EXIT result=passed' /tmp/phase2c-decoration.log 2>/dev/null; then break; fi; sleep 1; done; if seyrix-phase2c-probe-check decoration /tmp/phase2c-decoration.log; then echo PHASE2C_DECORATION_NEGOTIATION=passed; else echo PHASE2C_DECORATION_NEGOTIATION=failed; fi}
		run_serial_check $probe_decoration_check {PHASE2C_DECORATION_NEGOTIATION=passed} {PHASE2C_DECORATION_NEGOTIATION=failed} "client-side decoration negotiation probe"

		qmp_type $qmp "SEYRIX_PROBE_LOG=/tmp/phase2c-destroy.log seyrix-protocol-probe --destroy-during-transition\n"
		set probe_destroy_check {for n in $(seq 1 90); do if grep -q 'PROBE_EXIT result=passed' /tmp/phase2c-destroy.log 2>/dev/null; then break; fi; sleep 1; done; if seyrix-phase2c-probe-check destroy /tmp/phase2c-destroy.log; then echo PHASE2C_STATE_DESTROY=passed; else echo PHASE2C_STATE_DESTROY=failed; fi}
		run_serial_check $probe_destroy_check {PHASE2C_STATE_DESTROY=passed} {PHASE2C_STATE_DESTROY=failed} "window destruction during pending state transition probe"

		qmp_key_chord $qmp {meta_l shift} f
		set popup_floating_mode {if grep -Fq 'Workspace 1 layout mode changed to floating' /tmp/seyrix-compositor.log; then echo PHASE2C_POPUP_FLOATING_MODE=passed; else echo PHASE2C_POPUP_FLOATING_MODE=failed; fi}
		run_serial_check $popup_floating_mode {PHASE2C_POPUP_FLOATING_MODE=passed} {PHASE2C_POPUP_FLOATING_MODE=failed} "prepare floating mode for popup and hidden-pointer probes" 20
		qmp_type $qmp "SEYRIX_PROBE_LOG=/tmp/phase2c-popup.log seyrix-protocol-probe --title Seyrix-QEMU-Popup-Probe --app-id seyrix.qemu.$qemu_identity.popup\n"
		after 1200
		qmp_mouse_move $qmp 16000 16500
		qmp_mouse_click $qmp
		after 700
		qmp_hmp $qmp "screendump $run_dir/seyrix-popup-parent.ppm"
		qmp_mouse_move $qmp 17400 20480
		qmp_mouse_click $qmp
		after 900
		qmp_hmp $qmp "screendump $run_dir/seyrix-popup-nested.ppm"
		set popup_nested_check {if grep -q 'POPUP_CONFIGURE kind=popup' /tmp/phase2c-popup.log && grep -q 'POPUP_CONFIGURE kind=nested-popup' /tmp/phase2c-popup.log; then echo PHASE2C_NESTED_POPUP=passed; else echo PHASE2C_NESTED_POPUP=failed; fi}
		run_serial_check $popup_nested_check {PHASE2C_NESTED_POPUP=passed} {PHASE2C_NESTED_POPUP=failed} "nested xdg popup creation and configure probe"

		qmp_key_chord $qmp {meta_l} m
		after 500
		qmp_key_chord $qmp {meta_l} right
		after 400
		qmp_hmp $qmp "screendump $run_dir/seyrix-popup-workspace-away.ppm"
		qmp_key_chord $qmp {meta_l} left
		after 400
		qmp_key_chord $qmp {meta_l shift} m
		after 500
		set popup_minimize_check {if grep -q 'POPUP_DONE kind=popup' /tmp/phase2c-popup.log && grep -q 'Window minimized into compositor hidden state' /tmp/seyrix-compositor.log && grep -q 'Switched to workspace 2' /tmp/seyrix-compositor.log && bash /tmp/seyrix-qemu-guest-helper.sh popup-alive; then echo PHASE2C_POPUP_MINIMIZE=passed; else echo PHASE2C_POPUP_MINIMIZE=failed; fi}
		run_serial_check $popup_minimize_check {PHASE2C_POPUP_MINIMIZE=passed} {PHASE2C_POPUP_MINIMIZE=failed} "minimize and workspace switch while an xdg popup grab is active"

		qmp_mouse_move $qmp 16000 16500
		qmp_mouse_click $qmp
		after 700
		qmp_mouse_move $qmp 17400 20480
		qmp_mouse_click $qmp
		after 900
		set popup_destroy_command {before=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); if bash /tmp/seyrix-qemu-guest-helper.sh terminate-popup; then for n in $(seq 1 30); do after=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); if [[ "$after" -gt "$before" ]]; then break; fi; sleep 1; done; after=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); if [[ "$after" -gt "$before" ]] && pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null; then echo PHASE2C_POPUP_DESTROY=passed; else echo PHASE2C_POPUP_DESTROY=failed; fi; else echo PHASE2C_POPUP_DESTROY=failed; fi}
		run_serial_check $popup_destroy_command {PHASE2C_POPUP_DESTROY=passed} {PHASE2C_POPUP_DESTROY=failed} "client destruction during an active nested popup grab"
		qmp_key_chord $qmp {meta_l} right
		after 300
		qmp_key_chord $qmp {meta_l} left
		after 400
		set popup_validator_command {if seyrix-phase2c-probe-check popup /tmp/phase2c-popup.log; then echo PHASE2C_POPUP_PROTOCOL=passed; else echo PHASE2C_POPUP_PROTOCOL=failed; fi}
		run_serial_check $popup_validator_command {PHASE2C_POPUP_PROTOCOL=passed} {PHASE2C_POPUP_PROTOCOL=failed} "xdg popup dismissal protocol probe"
		puts "PHASE2C_PROTOCOL_PROBES=completed"

		qmp_key_chord $qmp {meta_l} ret
		set second_window_ready {for n in $(seq 1 60); do ready=1; pids=$(pgrep -u 1000 -x weston-terminal || true); count=$(printf '%s\n' "$pids" | sed '/^$/d' | wc -l); for pid in $pids; do grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log || ready=0; done; if [[ "$count" -ge 2 && "$ready" -eq 1 ]]; then break; fi; sleep 1; done; printf 'WORKSPACE_SECOND_TERMINAL_COUNT=%s\nWORKSPACE_SECOND_MAPPED_PIDS=%s\n' "$count" "$ready"; if [[ "$count" -ge 2 && "$ready" -eq 1 ]]; then echo WORKSPACE_SECOND_WINDOW_READY=passed; else echo WORKSPACE_SECOND_WINDOW_READY=failed; pgrep -a -u 1000 -x weston-terminal || true; grep 'GEOMETRY_EVIDENCE event=map' /tmp/seyrix-compositor.log | tail -n 10; fi}
		run_serial_check $second_window_ready {WORKSPACE_SECOND_WINDOW_READY=passed} {WORKSPACE_SECOND_WINDOW_READY=failed} "second terminal process and same-PID toplevel map readiness" 70
		qmp_type $qmp "mkdir -p /tmp/phase2c-ws1-second\ncd /tmp/phase2c-ws1-second\ntouch second-terminal-ready\n"
		set workspace_one_second_marker {for n in $(seq 1 10); do test -f /tmp/phase2c-ws1-second/second-terminal-ready && break; sleep 1; done; if test -f /tmp/phase2c-ws1-second/second-terminal-ready; then echo WORKSPACE_ONE_SECOND_TERMINAL_MARKER=passed; else echo WORKSPACE_ONE_SECOND_TERMINAL_MARKER=failed; fi}
		run_serial_check $workspace_one_second_marker {WORKSPACE_ONE_SECOND_TERMINAL_MARKER=passed} {WORKSPACE_ONE_SECOND_TERMINAL_MARKER=failed} "workspace one second terminal command marker" 20
		qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-1.ppm"

		set watch_start_result [run_serial_capture {bash /tmp/seyrix-qemu-guest-helper.sh watch-start} \
			{WATCH_POINTER_TARGET_READY pid=([0-9]+) surface=([0-9]+) scene=(-?[0-9]+),(-?[0-9]+) size=([0-9]+)x([0-9]+) qmp=([0-9]+),([0-9]+)\r} \
			{WATCH_POINTER_TARGET_FAILED|QEMU_GUEST_HELPER=failed} \
			"hidden-workspace pointer watcher map readiness" 55]
		lassign $watch_start_result watch_status watch_pid watch_surface watch_scene_x watch_scene_y watch_width watch_height watch_x watch_y
		set watch_active_pointer_passed 0
		if {$watch_status eq "pass"} {
			qmp_mouse_move $qmp $watch_x $watch_y
			qmp_mouse_click $qmp
			after 500
			set watch_baseline_command {bash /tmp/seyrix-qemu-guest-helper.sh watch-baseline}
			run_serial_check $watch_baseline_command {WATCH_POINTER_ACTIVE_BASELINE=passed} {WATCH_POINTER_ASSERTION_FAILED} "visible pointer watcher button callback positive control" 20
			if {$last_serial_check_result eq "pass"} {
				set watch_active_pointer_passed 1
			} else {
				set watch_stop_command {bash /tmp/seyrix-qemu-guest-helper.sh watch-stop}
				run_serial_check $watch_stop_command {WATCH_POINTER_STOPPED=passed} {QEMU_GUEST_HELPER=failed} "clean up pointer watcher after failed positive control" 20
				puts "WORKSPACE_HIDDEN_POINTER=INCOMPLETE reason=positive-control-failed"
			}
		} else {
			puts "WORKSPACE_HIDDEN_POINTER=INCOMPLETE reason=watch-target-unavailable"
		}
		qmp_key_chord $qmp {meta_l} right
		set second_workspace_active {for n in $(seq 1 20); do active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); if [[ -z "$active" ]]; then active=1; fi; [[ "$active" == 2 ]] && break; sleep 1; done; if [[ "$active" == 2 ]]; then echo WORKSPACE_TWO_ACTIVE=passed; else echo WORKSPACE_TWO_ACTIVE=failed; grep -E 'Super number input|Direct workspace selection|Switched to workspace' /tmp/seyrix-compositor.log | tail -n 20; fi}
		run_serial_check $second_workspace_active {WORKSPACE_TWO_ACTIVE=passed} {WORKSPACE_TWO_ACTIVE=failed} "workspace two activation before hidden-client input checks" 25
		qmp_key_chord $qmp {meta_l} ret
		set second_workspace_terminal_ready {for n in $(seq 1 60); do ready=1; pids=$(pgrep -u 1000 -x weston-terminal || true); count=$(printf '%s\n' "$pids" | sed '/^$/d' | wc -l); for pid in $pids; do grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log || ready=0; done; if [[ "$count" -ge 3 && "$ready" -eq 1 ]]; then break; fi; sleep 1; done; if [[ "$count" -ge 3 && "$ready" -eq 1 ]]; then echo WORKSPACE_TWO_TERMINAL_READY=passed; else echo WORKSPACE_TWO_TERMINAL_READY=failed; pgrep -a -u 1000 -x weston-terminal || true; fi}
		run_serial_check $second_workspace_terminal_ready {WORKSPACE_TWO_TERMINAL_READY=passed} {WORKSPACE_TWO_TERMINAL_READY=failed} "active workspace terminal process and map readiness" 70
		qmp_type $qmp "mkdir -p /tmp/phase2c-ws2\ncd /tmp/phase2c-ws2\ntouch active-terminal-ready\n"
		set second_workspace_marker {for n in $(seq 1 10); do test -f /tmp/phase2c-ws2/active-terminal-ready && break; sleep 1; done; if test -f /tmp/phase2c-ws2/active-terminal-ready; then echo WORKSPACE_TWO_TERMINAL_MARKER=passed; else echo WORKSPACE_TWO_TERMINAL_MARKER=failed; fi}
		run_serial_check $second_workspace_marker {WORKSPACE_TWO_TERMINAL_MARKER=passed} {WORKSPACE_TWO_TERMINAL_MARKER=failed} "active workspace terminal command marker" 20
		if {$watch_status eq "pass" && $watch_active_pointer_passed} {
			set watch_hidden_baseline_command {bash /tmp/seyrix-qemu-guest-helper.sh watch-hidden-baseline}
			run_serial_check $watch_hidden_baseline_command {WATCH_POINTER_HIDDEN_BASELINE=passed} {WATCH_POINTER_ASSERTION_FAILED} "pointer event baseline after hiding watcher workspace" 20
			qmp_mouse_move $qmp $watch_x $watch_y
			qmp_mouse_click $qmp
			set watch_hidden_command {bash /tmp/seyrix-qemu-guest-helper.sh watch-check-hidden}
			run_serial_check $watch_hidden_command {WATCH_POINTER_HIDDEN_ASSERTION=passed} {WATCH_POINTER_HIDDEN_ASSERTION=failed} "hidden workspace pointer event isolation" 20
			set watch_stop_command {bash /tmp/seyrix-qemu-guest-helper.sh watch-stop}
			run_serial_check $watch_stop_command {WATCH_POINTER_STOPPED=passed} {QEMU_GUEST_HELPER=failed} "stop pointer watcher by recorded PID and identity" 20
		}
		qmp_key_chord $qmp {meta_l shift} h
		set phase2c_workspace_hybrid {if grep -Fq 'Workspace 1 layout mode changed to hybrid' /tmp/seyrix-compositor.log; then echo PHASE2C_WORKSPACE_HYBRID=passed; else echo PHASE2C_WORKSPACE_HYBRID=failed; fi}
		run_serial_check $phase2c_workspace_hybrid {PHASE2C_WORKSPACE_HYBRID=passed} {PHASE2C_WORKSPACE_HYBRID=failed} "restore Hybrid mode before workspace isolation checks" 20
		qmp_type $qmp "touch hidden-keyboard-probe\n"
		set hidden_workspace_check {count=$(pgrep -u 1000 -x weston-terminal | wc -l); if test -f /tmp/phase2c-ws2/hidden-keyboard-probe && test ! -e /tmp/phase2c-ws1-first/hidden-keyboard-probe && test ! -e /tmp/phase2c-ws1-second/hidden-keyboard-probe && [[ "$count" -ge 3 ]]; then echo WORKSPACE_HIDDEN_INPUT=passed; else echo WORKSPACE_HIDDEN_INPUT=failed; fi}
		run_serial_check $hidden_workspace_check {WORKSPACE_HIDDEN_INPUT=passed} {WORKSPACE_HIDDEN_INPUT=failed} "keyboard isolation with a visible client on the active workspace" 20
		qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-2-empty.ppm"
		set workspace_terminal_baseline {pids=$(pgrep -u 1000 -x weston-terminal | sort -n | paste -sd, -); if [[ -n "$pids" ]]; then printf '%s\n' "$pids" > /tmp/phase2c-workspace-terminal-baseline; printf 'WORKSPACE_TERMINAL_BASELINE=passed pids=%s\n' "$pids"; else echo WORKSPACE_TERMINAL_BASELINE=failed; fi}
		run_serial_check $workspace_terminal_baseline {WORKSPACE_TERMINAL_BASELINE=passed} {WORKSPACE_TERMINAL_BASELINE=failed} "record workspace terminal process baseline" 20
		set workspace_focus_markers_reset {rm -f /tmp/phase2c-ws1-first/focus-history-ws1 /tmp/phase2c-ws1-second/focus-history-ws1 /tmp/phase2c-ws2/focus-history-ws2-after-move; echo WORKSPACE_FOCUS_MARKERS_RESET=passed}
		run_serial_check $workspace_focus_markers_reset {WORKSPACE_FOCUS_MARKERS_RESET=passed} {WORKSPACE_FOCUS_MARKERS_RESET=failed} "reset workspace focus marker files" 20
		qmp_key_chord $qmp {meta_l} left
		after 350
		qmp_type $qmp "touch focus-history-ws1\n"
		after 300
		set workspace_focus_check {if test -f /tmp/phase2c-ws1-second/focus-history-ws1 && test ! -e /tmp/phase2c-ws1-first/focus-history-ws1; then echo WORKSPACE_FOCUS_RESTORE=passed; else echo WORKSPACE_FOCUS_RESTORE=failed; fi}
		run_serial_check $workspace_focus_check {WORKSPACE_FOCUS_RESTORE=passed} {WORKSPACE_FOCUS_RESTORE=failed} "per-workspace focus history restoration"

		set workspace_move_right_baseline {before=$(grep -c 'Moved focused window to workspace 2' /tmp/seyrix-compositor.log || true); pids=$(pgrep -u 1000 -x weston-terminal | sort -n | paste -sd, -); expected=$(cat /tmp/phase2c-workspace-terminal-baseline); if [[ "$pids" == "$expected" ]]; then printf '%s\n' "$before" > /tmp/phase2c-move-right-before; echo WORKSPACE_MOVE_RIGHT_BASELINE=passed; else echo WORKSPACE_MOVE_RIGHT_BASELINE=failed; fi}
		run_serial_check $workspace_move_right_baseline {WORKSPACE_MOVE_RIGHT_BASELINE=passed} {WORKSPACE_MOVE_RIGHT_BASELINE=failed} "record move-right log baseline"
		qmp_key_chord $qmp {meta_l shift} right
		set workspace_move_right_check {before=$(cat /tmp/phase2c-move-right-before); expected=$(cat /tmp/phase2c-workspace-terminal-baseline); moved=0; for n in $(seq 1 20); do moved=$(grep -c 'Moved focused window to workspace 2' /tmp/seyrix-compositor.log || true); [[ "$moved" -gt "$before" ]] && break; sleep 0.1; done; pids=$(pgrep -u 1000 -x weston-terminal | sort -n | paste -sd, -); active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); if [[ "$moved" -gt "$before" && "$pids" == "$expected" && "$active" == 1 ]]; then echo WORKSPACE_MOVE_RIGHT=passed; else echo WORKSPACE_MOVE_RIGHT=failed; printf 'WORKSPACE_MOVE_RIGHT_DIAGNOSTICS before=%s moved=%s expected_pids=%s current_pids=%s active=%s\n' "$before" "$moved" "$expected" "$pids" "$active"; grep -E 'Workspace move shortcut|Moved focused window|Window move deferred|Window minimized|Switched to workspace|Focus changed' /tmp/seyrix-compositor.log | tail -n 24; fi}
		run_serial_check $workspace_move_right_check {WORKSPACE_MOVE_RIGHT=passed} {WORKSPACE_MOVE_RIGHT=failed} "moving a focused window to the next workspace"
		set workspace_two_focus_markers_reset {rm -f /tmp/phase2c-ws1-first/focus-history-ws2-after-move /tmp/phase2c-ws1-second/focus-history-ws2-after-move /tmp/phase2c-ws2/focus-history-ws2-after-move; echo WORKSPACE_TWO_FOCUS_MARKERS_RESET=passed}
		run_serial_check $workspace_two_focus_markers_reset {WORKSPACE_TWO_FOCUS_MARKERS_RESET=passed} {WORKSPACE_TWO_FOCUS_MARKERS_RESET=failed} "reset workspace two focus marker files" 20
		qmp_key_chord $qmp {meta_l} right
		after 350
		qmp_type $qmp "touch focus-history-ws2-after-move\n"
		after 300
		set workspace_two_focus_check {for n in $(seq 1 10); do test -f /tmp/phase2c-ws2/focus-history-ws2-after-move && break; test -e /tmp/phase2c-ws1-second/focus-history-ws2-after-move && break; sleep 0.2; done; if test -f /tmp/phase2c-ws2/focus-history-ws2-after-move && test ! -e /tmp/phase2c-ws1-first/focus-history-ws2-after-move && test ! -e /tmp/phase2c-ws1-second/focus-history-ws2-after-move; then echo WORKSPACE_TWO_FOCUS=passed; else echo WORKSPACE_TWO_FOCUS=failed; printf 'WORKSPACE_TWO_FOCUS_DIAGNOSTICS ws2=%s ws1_first=%s moved=%s\n' "$(test -e /tmp/phase2c-ws2/focus-history-ws2-after-move && echo present || echo absent)" "$(test -e /tmp/phase2c-ws1-first/focus-history-ws2-after-move && echo present || echo absent)" "$(test -e /tmp/phase2c-ws1-second/focus-history-ws2-after-move && echo present || echo absent)"; grep -E 'Workspace move shortcut|Moved focused window|Switched to workspace|Focus changed' /tmp/seyrix-compositor.log | tail -n 18; fi}
		run_serial_check $workspace_two_focus_check {WORKSPACE_TWO_FOCUS=passed} {WORKSPACE_TWO_FOCUS=failed} "focus restoration on the second workspace"
		set workspace_move_left_baseline {before=$(grep -c 'Moved focused window to workspace 1' /tmp/seyrix-compositor.log || true); pids=$(pgrep -u 1000 -x weston-terminal | sort -n | paste -sd, -); expected=$(cat /tmp/phase2c-workspace-terminal-baseline); if [[ "$pids" == "$expected" ]]; then printf '%s\n' "$before" > /tmp/phase2c-move-left-before; echo WORKSPACE_MOVE_LEFT_BASELINE=passed; else echo WORKSPACE_MOVE_LEFT_BASELINE=failed; fi}
		run_serial_check $workspace_move_left_baseline {WORKSPACE_MOVE_LEFT_BASELINE=passed} {WORKSPACE_MOVE_LEFT_BASELINE=failed} "record move-left log baseline"
		qmp_key_chord $qmp {meta_l shift} left
		set workspace_move_left_check {before=$(cat /tmp/phase2c-move-left-before); expected=$(cat /tmp/phase2c-workspace-terminal-baseline); moved=0; for n in $(seq 1 20); do moved=$(grep -c 'Moved focused window to workspace 1' /tmp/seyrix-compositor.log || true); [[ "$moved" -gt "$before" ]] && break; sleep 0.1; done; pids=$(pgrep -u 1000 -x weston-terminal | sort -n | paste -sd, -); active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); if [[ "$moved" -gt "$before" && "$pids" == "$expected" && "$active" == 2 ]]; then echo WORKSPACE_MOVE_LEFT=passed; else echo WORKSPACE_MOVE_LEFT=failed; printf 'WORKSPACE_MOVE_LEFT_DIAGNOSTICS before=%s moved=%s expected_pids=%s current_pids=%s active=%s\n' "$before" "$moved" "$expected" "$pids" "$active"; grep -E 'Workspace move shortcut|Moved focused window|Window move deferred|Window minimized|Switched to workspace|Focus changed' /tmp/seyrix-compositor.log | tail -n 24; fi}
		run_serial_check $workspace_move_left_check {WORKSPACE_MOVE_LEFT=passed} {WORKSPACE_MOVE_LEFT=failed} "moving a focused window to the previous workspace"
		qmp_key_chord $qmp {meta_l} 3
		after 350
		set workspace_three_check {active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); if [[ -z "$active" ]]; then active=1; fi; if [[ "$active" == 3 ]]; then echo WORKSPACE_THREE=passed; else echo WORKSPACE_THREE=failed; fi}
		run_serial_check $workspace_three_check {WORKSPACE_THREE=passed} {WORKSPACE_THREE=failed} "Super+3 selects workspace 3" 20
		qmp_mouse_move $qmp 15000 15000
		qmp_mouse_click $qmp
		qmp_type $qmp "touch /tmp/phase2c-hidden-workspace-number-leak\n"
		after 300
		set hidden_number_check {if [[ ! -e /tmp/phase2c-hidden-workspace-number-leak ]]; then echo WORKSPACE_NUMBER_INPUT=passed; else echo WORKSPACE_NUMBER_INPUT=failed; fi}
		run_serial_check $hidden_number_check {WORKSPACE_NUMBER_INPUT=passed} {WORKSPACE_NUMBER_INPUT=failed} "Super+3 selection and hidden-window input isolation"
		qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-3-empty.ppm"
		qmp_key_chord $qmp {meta_l} 4
		qmp_hmp $qmp "screendump $run_dir/seyrix-workspace-4-panel-selection.ppm"
		set workspace_four_check {active=$(grep 'Switched to workspace' /tmp/seyrix-compositor.log | tail -n 1 | sed -E 's/^.*Switched to workspace ([0-9]+).*$/\1/' | tr -d '\r'); if [[ -z "$active" ]]; then active=1; fi; if [[ "$active" == 4 ]]; then echo WORKSPACE_FOUR=passed; else echo WORKSPACE_FOUR=failed; fi}
		run_serial_check $workspace_four_check {WORKSPACE_FOUR=passed} {WORKSPACE_FOUR=failed} "Super+4 selects workspace 4" 20
		qmp_key_chord $qmp {meta_l} ret
		set workspace_four_window_ready {for n in $(seq 1 60); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); pid=$(pgrep -u 1000 -x weston-terminal | tail -n 1); if [[ "$count" -ge 4 ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log; then break; fi; sleep 1; done; if [[ "$count" -ge 4 ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log; then echo WORKSPACE_FOUR_WINDOW_READY=passed; else echo WORKSPACE_FOUR_WINDOW_READY=failed; pgrep -a -u 1000 -x weston-terminal || true; fi}
		run_serial_check $workspace_four_window_ready {WORKSPACE_FOUR_WINDOW_READY=passed} {WORKSPACE_FOUR_WINDOW_READY=failed} "workspace four active terminal process and map readiness" 70
		qmp_type $qmp "mkdir -p /tmp/phase2c-ws4\ncd /tmp/phase2c-ws4\ntouch active-terminal-ready\n"
		set workspace_four_terminal_marker {for n in $(seq 1 10); do test -f /tmp/phase2c-ws4/active-terminal-ready && break; sleep 1; done; if test -f /tmp/phase2c-ws4/active-terminal-ready; then echo WORKSPACE_FOUR_TERMINAL_MARKER=passed; else echo WORKSPACE_FOUR_TERMINAL_MARKER=failed; fi}
		run_serial_check $workspace_four_terminal_marker {WORKSPACE_FOUR_TERMINAL_MARKER=passed} {WORKSPACE_FOUR_TERMINAL_MARKER=failed} "workspace four visible terminal command marker" 20
		set workspace_boundary_right_baseline {before=$(grep -c 'Moved focused window to workspace' /tmp/seyrix-compositor.log || true); switches=$(grep -c 'Switched to workspace' /tmp/seyrix-compositor.log || true); pid=$(pgrep -u 1000 -x weston-terminal | tail -n 1); if test -f /tmp/phase2c-ws4/active-terminal-ready && [[ -n "$pid" ]] && grep -Fq "GEOMETRY_EVIDENCE event=map pid=$pid " /tmp/seyrix-compositor.log && grep -q 'Switched to workspace 4' /tmp/seyrix-compositor.log; then echo "$before" > /tmp/phase2c-boundary4-move-before; echo "$switches" > /tmp/phase2c-boundary4-switch-before; echo WORKSPACE_BOUNDARY_4_BASELINE=passed; else echo WORKSPACE_BOUNDARY_4_BASELINE=failed; fi}
		run_serial_check $workspace_boundary_right_baseline {WORKSPACE_BOUNDARY_4_BASELINE=passed} {WORKSPACE_BOUNDARY_4_BASELINE=failed} "workspace four active visible-client boundary baseline" 20
		qmp_key_chord $qmp {meta_l shift} right
		qmp_key_chord $qmp {meta_l} right
		qmp_type $qmp "touch /tmp/phase2c-ws4-boundary-after\n"
		set workspace_boundary_right_check {moved=$(grep -c 'Moved focused window to workspace' /tmp/seyrix-compositor.log || true); switches=$(grep -c 'Switched to workspace' /tmp/seyrix-compositor.log || true); if test -f /tmp/phase2c-ws4-boundary-after && test -f /tmp/phase2c-ws4/active-terminal-ready && grep -q 'Switched to workspace 4' /tmp/seyrix-compositor.log && [[ "$moved" -eq "$(cat /tmp/phase2c-boundary4-move-before)" && "$switches" -eq "$(cat /tmp/phase2c-boundary4-switch-before)" ]]; then echo WORKSPACE_BOUNDARY_RIGHT=passed; else echo WORKSPACE_BOUNDARY_RIGHT=failed; fi}
		run_serial_check $workspace_boundary_right_check {WORKSPACE_BOUNDARY_RIGHT=passed} {WORKSPACE_BOUNDARY_RIGHT=failed} "workspace four no-wrap with visible client still interactive" 20
		qmp_key_chord $qmp {meta_l} q
		after 500
		qmp_key_chord $qmp {meta_l} 1
		after 350
		qmp_type $qmp "touch /tmp/phase2c-workspace-app-persistent\n"
		after 350
		set workspace_persistence_check {expected=$(cat /tmp/phase2c-workspace-terminal-baseline); pids=$(pgrep -u 1000 -x weston-terminal | sort -n | paste -sd, -); if [[ "$pids" == "$expected" ]] && test -f /tmp/phase2c-workspace-app-persistent; then echo WORKSPACE_APP_PERSISTENCE=passed; else echo WORKSPACE_APP_PERSISTENCE=failed; printf 'WORKSPACE_APP_PERSISTENCE_DIAGNOSTICS expected_pids=%s current_pids=%s marker=%s\n' "$expected" "$pids" "$(test -f /tmp/phase2c-workspace-app-persistent && echo present || echo absent)"; pgrep -a -u 1000 -x weston-terminal || true; fi}
		run_serial_check $workspace_persistence_check {WORKSPACE_APP_PERSISTENCE=passed} {WORKSPACE_APP_PERSISTENCE=failed} "application persistence while windows migrate between workspaces"
		for {set i 0} {$i < 4} {incr i} {
			qmp_key_chord $qmp {meta_l} q
			after 500
		}
		qmp_key_chord $qmp {meta_l} 2
		after 350
		for {set i 0} {$i < 4} {incr i} {
			qmp_key_chord $qmp {meta_l} q
			after 500
		}
		qmp_key_chord $qmp {meta_l} 1
		after 350
		set workspace_cleanup_check {count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -eq 0 ]]; then echo WORKSPACE_CLEANUP=passed; else echo WORKSPACE_CLEANUP=failed; printf 'WORKSPACE_CLEANUP_DIAGNOSTICS count=%s\n' "$count"; pgrep -a -u 1000 -x weston-terminal || true; fi}
		run_serial_check $workspace_cleanup_check {WORKSPACE_CLEANUP=passed} {WORKSPACE_CLEANUP=failed} "closing windows on separate workspaces"
		puts "PHASE2C_WORKSPACES=completed"

		set panel_crash_check {bash /tmp/seyrix-qemu-guest-helper.sh crash-panel}
		run_serial_check $panel_crash_check {PHASE2C_PANEL_CRASH_ISOLATION=passed} {PHASE2C_PANEL_CRASH_ISOLATION=failed} "panel process crash isolation"
		qmp_key_chord $qmp {meta_l} ret
		after 600
		qmp_type $qmp "touch /tmp/phase2c-compositor-after-panel-crash\n"
		set panel_crash_input_check {if test -f /tmp/phase2c-compositor-after-panel-crash && pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null; then echo PHASE2C_PANEL_CRASH_INPUT=passed; else echo PHASE2C_PANEL_CRASH_INPUT=failed; fi}
		run_serial_check $panel_crash_input_check {PHASE2C_PANEL_CRASH_INPUT=passed} {PHASE2C_PANEL_CRASH_INPUT=failed} "compositor input after panel crash"
		qmp_key_chord $qmp {meta_l} q
		after 500
	}

    if {[info exists env(SEYRIX_QEMU_STRESS)] && $env(SEYRIX_QEMU_STRESS) eq "1"} {
        puts "STRESS_CAMPAIGN=started"
        set stress_baseline_command {compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1); if [[ -n "$compositor_pid" ]]; then awk '/VmRSS:/ {print $2}' "/proc/$compositor_pid/status" > /tmp/seyrix-compositor-rss-before; else echo missing > /tmp/seyrix-compositor-rss-before; fi; printf 'STRESS_BASELINE_RSS_KB='; cat /tmp/seyrix-compositor-rss-before; printf 'STRESS_BASELINE_TERMINALS='; pgrep -u 1000 -x weston-terminal | wc -l; printf 'STRESS_BASELINE_COMPOSITORS='; pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | wc -l}
        send -- "$stress_baseline_command\r"
        expect {
            -re {STRESS_BASELINE_RSS_KB=[0-9]+} {}
            timeout {puts stderr "Could not record compositor stress baseline."; exit 1}
            eof {puts stderr "QEMU exited before stress baseline recording."; exit 1}
        }

        for {set cycle 1} {$cycle <= 5} {incr cycle} {
            set cycle_id [format "%02d" $cycle]
            puts "STRESS_CYCLE_START=$cycle_id"
            qmp_key_chord $qmp {meta_l} ret
            after 400
            set open_first_command {for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -ge 1 ]]; then break; fi; sleep 1; done; if [[ "$(pgrep -u 1000 -x weston-terminal | wc -l)" -ge 1 ]]; then echo STRESS_FIRST_WINDOW=passed; else echo STRESS_FIRST_WINDOW=failed; fi}
            send -- "$open_first_command\r"
            expect {
                -re {STRESS_FIRST_WINDOW=passed} {}
                -re {STRESS_FIRST_WINDOW=failed} {puts stderr "Stress cycle could not open first window."; exit 1}
                timeout {puts stderr "Timed out opening first stress window."; exit 1}
                eof {puts stderr "QEMU exited opening first stress window."; exit 1}
            }

            qmp_key_chord $qmp {meta_l} ret
            after 400
            set open_second_command {for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -ge 2 ]]; then break; fi; sleep 1; done; count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -ge 2 ]]; then echo STRESS_SECOND_WINDOW=passed; else echo STRESS_SECOND_WINDOW=failed; fi}
            send -- "$open_second_command\r"
            expect {
                -re {STRESS_SECOND_WINDOW=passed} {}
                -re {STRESS_SECOND_WINDOW=failed} {puts stderr "Stress cycle could not open second window."; exit 1}
                timeout {puts stderr "Timed out opening second stress window."; exit 1}
                eof {puts stderr "QEMU exited opening second stress window."; exit 1}
            }

            qmp_type $qmp "touch /tmp/seyrix-stress-focus-$cycle_id\n"
            set focus_command [format {if test -f /tmp/seyrix-stress-focus-%s; then echo STRESS_NEW_WINDOW_FOCUS=passed; else echo STRESS_NEW_WINDOW_FOCUS=failed; fi} $cycle_id]
            send -- "$focus_command\r"
            expect {
                -re {STRESS_NEW_WINDOW_FOCUS=passed} {}
                -re {STRESS_NEW_WINDOW_FOCUS=failed} {puts stderr "New stress window did not receive keyboard focus."; exit 1}
                timeout {puts stderr "Timed out checking stress window focus."; exit 1}
                eof {puts stderr "QEMU exited checking stress window focus."; exit 1}
            }

            qmp_hmp $qmp "screendump $run_dir/stress-cycle-$cycle_id-before-interaction.ppm"
            qmp_mouse_drag $qmp 16384 31743 16384 32589 left
            qmp_key_transition $qmp alt 1
            qmp_mouse_drag $qmp 15360 17066 20480 20480 left
            qmp_key_transition $qmp alt 0
            after 500
            qmp_hmp $qmp "screendump $run_dir/stress-cycle-$cycle_id-after-interaction.ppm"
            set required_interactions [expr {$cycle + 1}]
            set interaction_command {moved=$(grep -c 'Window moved to' /tmp/seyrix-compositor.log || true); resized=$(grep -c 'Resize gesture ended' /tmp/seyrix-compositor.log || true); printf 'STRESS_MOVE_COUNT=%s\nSTRESS_RESIZE_COUNT=%s\n' "$moved" "$resized"; echo STRESS_MOVE_RESIZE=INCOMPLETE reason=requires-same-window-scene-geometry}
            send -- "$interaction_command\r"
            puts "STRESS_MOVE_RESIZE=INCOMPLETE reason=requires-same-window-scene-geometry"
            expect {
                -re {STRESS_RESIZE_COUNT=[0-9]+\r} {}
                timeout {puts stderr "Timed out reading stress interaction counters."; exit 1}
                eof {puts stderr "QEMU exited reading stress interaction counters."; exit 1}
            }
            expect {
                -re {STRESS_MOVE_RESIZE=INCOMPLETE} {}
                timeout {puts stderr "Timed out checking stress movement and resize."; exit 1}
                eof {puts stderr "QEMU exited checking stress movement and resize."; exit 1}
            }
            qmp_key_chord $qmp {meta_l} q
            after 700
            set close_top_command {for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -le 1 ]]; then break; fi; sleep 1; done; if [[ "$(pgrep -u 1000 -x weston-terminal | wc -l)" -eq 1 ]]; then echo STRESS_CLOSE_TOP=passed; else echo STRESS_CLOSE_TOP=failed; fi}
            send -- "$close_top_command\r"
            expect {
                -re {STRESS_CLOSE_TOP=passed} {}
                -re {STRESS_CLOSE_TOP=failed} {puts stderr "Stress cycle failed to close top window."; exit 1}
                timeout {puts stderr "Timed out closing top stress window."; exit 1}
                eof {puts stderr "QEMU exited closing top stress window."; exit 1}
            }

            qmp_type $qmp "touch /tmp/seyrix-stress-fallback-$cycle_id\n"
            set fallback_command [format {if test -f /tmp/seyrix-stress-fallback-%s; then echo STRESS_FOCUS_FALLBACK=passed; else echo STRESS_FOCUS_FALLBACK=failed; fi} $cycle_id]
            send -- "$fallback_command\r"
            expect {
                -re {STRESS_FOCUS_FALLBACK=passed} {}
                -re {STRESS_FOCUS_FALLBACK=failed} {puts stderr "Focus did not return to remaining stress window."; exit 1}
                timeout {puts stderr "Timed out checking focus fallback."; exit 1}
                eof {puts stderr "QEMU exited checking focus fallback."; exit 1}
            }

            qmp_key_chord $qmp {meta_l} q
            after 700
            set close_last_command {for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -eq 0 ]]; then break; fi; sleep 1; done; if [[ "$(pgrep -u 1000 -x weston-terminal | wc -l)" -eq 0 ]]; then echo STRESS_CLOSE_LAST=passed; else echo STRESS_CLOSE_LAST=failed; fi}
            send -- "$close_last_command\r"
            expect {
                -re {STRESS_CLOSE_LAST=passed} {}
                -re {STRESS_CLOSE_LAST=failed} {puts stderr "Stress cycle failed to close last window."; exit 1}
                timeout {puts stderr "Timed out closing last stress window."; exit 1}
                eof {puts stderr "QEMU exited closing last stress window."; exit 1}
            }
            puts "STRESS_CYCLE_${cycle_id}=completed"
        }

        qmp_key_chord $qmp {meta_l} ret
        after 400
        qmp_key_chord $qmp {meta_l} ret
        after 500
        set unexpected_exit_command {for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -ge 2 ]]; then break; fi; sleep 1; done; before=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); if bash /tmp/seyrix-qemu-guest-helper.sh kill-mapped-terminal; then for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); destroyed=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); if [[ "$count" -eq 1 && "$destroyed" -gt "$before" ]]; then break; fi; sleep 1; done; count=$(pgrep -u 1000 -x weston-terminal | wc -l); destroyed=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); if [[ "$count" -eq 1 && "$destroyed" -gt "$before" ]] && pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null; then echo STRESS_UNEXPECTED_APP_EXIT=passed; else echo STRESS_UNEXPECTED_APP_EXIT=failed; fi; else echo STRESS_UNEXPECTED_APP_EXIT=failed; fi}
        send -- "$unexpected_exit_command\r"
        expect {
            -re {STRESS_UNEXPECTED_APP_EXIT=passed} {}
            -re {STRESS_UNEXPECTED_APP_EXIT=failed} {puts stderr "Unexpected application termination did not clean up its window."; exit 1}
            timeout {puts stderr "Timed out checking unexpected application termination."; exit 1}
            eof {puts stderr "QEMU exited during unexpected application termination."; exit 1}
        }
        qmp_type $qmp "touch /tmp/seyrix-stress-unexpected-focus\n"
        set unexpected_focus_command {if test -f /tmp/seyrix-stress-unexpected-focus; then echo STRESS_UNEXPECTED_FOCUS=passed; else echo STRESS_UNEXPECTED_FOCUS=failed; fi}
        send -- "$unexpected_focus_command\r"
        expect {
            -re {STRESS_UNEXPECTED_FOCUS=passed} {}
            -re {STRESS_UNEXPECTED_FOCUS=failed} {puts stderr "Focus did not recover after unexpected application exit."; exit 1}
            timeout {puts stderr "Timed out checking focus after unexpected exit."; exit 1}
            eof {puts stderr "QEMU exited checking focus after unexpected exit."; exit 1}
        }

        qmp_key_chord $qmp {meta_l} ret
        after 500
        qmp_key_transition $qmp alt 1
        qmp_mouse_move $qmp 12000 15000
        qmp_mouse_button $qmp left 1
        after 250
        set grabbed_destroy_command {before_destroy=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); before_move=$(grep -c 'Window moved to' /tmp/seyrix-compositor.log || true); if bash /tmp/seyrix-qemu-guest-helper.sh kill-mapped-terminal; then for n in $(seq 1 30); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); destroyed=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); moved=$(grep -c 'Window moved to' /tmp/seyrix-compositor.log || true); if [[ "$count" -eq 1 && "$destroyed" -gt "$before_destroy" && "$moved" -gt "$before_move" ]]; then break; fi; sleep 1; done; count=$(pgrep -u 1000 -x weston-terminal | wc -l); destroyed=$(grep -c 'Window destroyed' /tmp/seyrix-compositor.log || true); moved=$(grep -c 'Window moved to' /tmp/seyrix-compositor.log || true); if [[ "$count" -eq 1 && "$destroyed" -gt "$before_destroy" && "$moved" -gt "$before_move" ]] && pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null; then echo STRESS_DESTROY_DURING_GRAB=passed; else echo STRESS_DESTROY_DURING_GRAB=failed; fi; else echo STRESS_DESTROY_DURING_GRAB=failed; fi}
        send -- "$grabbed_destroy_command\r"
        expect {
            -re {STRESS_DESTROY_DURING_GRAB=passed} {}
            -re {STRESS_DESTROY_DURING_GRAB=failed} {puts stderr "Destroy during pointer grab did not reset compositor state."; exit 1}
            timeout {puts stderr "Timed out destroying window during pointer grab."; exit 1}
            eof {puts stderr "QEMU exited during pointer-grab destruction."; exit 1}
        }
        qmp_mouse_button $qmp left 0
        qmp_key_transition $qmp alt 0
        qmp_type $qmp "touch /tmp/seyrix-stress-grab-focus\n"
        set grab_focus_command {if test -f /tmp/seyrix-stress-grab-focus; then echo STRESS_GRAB_FOCUS_RECOVERY=passed; else echo STRESS_GRAB_FOCUS_RECOVERY=failed; fi}
        send -- "$grab_focus_command\r"
        expect {
            -re {STRESS_GRAB_FOCUS_RECOVERY=passed} {}
            -re {STRESS_GRAB_FOCUS_RECOVERY=failed} {puts stderr "Focus did not recover after destroying grabbed window."; exit 1}
            timeout {puts stderr "Timed out checking focus after grabbed-window destruction."; exit 1}
            eof {puts stderr "QEMU exited checking focus after grabbed-window destruction."; exit 1}
        }

        qmp_key_chord $qmp {meta_l} q
        after 700
        set stress_metrics_command {compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1); before=$(cat /tmp/seyrix-compositor-rss-before); after=$(awk '/VmRSS:/ {print $2}' "/proc/$compositor_pid/status"); fds=$(find "/proc/$compositor_pid/fd" -maxdepth 1 -type l | wc -l); terminals=$(pgrep -u 1000 -x weston-terminal | wc -l); compositors=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | wc -l); printf 'STRESS_RSS_BEFORE_KB=%s\nSTRESS_RSS_AFTER_KB=%s\nSTRESS_RSS_DELTA_KB=%s\nSTRESS_OPEN_FDS=%s\nSTRESS_TERMINAL_PROCESSES=%s\nSTRESS_COMPOSITOR_PROCESSES=%s\n' "$before" "$after" "$((after - before))" "$fds" "$terminals" "$compositors"; if [[ "$terminals" -eq 0 && "$compositors" -eq 1 ]]; then echo STRESS_PROCESS_CHECK=passed; else echo STRESS_PROCESS_CHECK=failed; fi}
        send -- "$stress_metrics_command\r"
        expect {
            -re {STRESS_PROCESS_CHECK=passed} {}
            -re {STRESS_PROCESS_CHECK=failed} {puts stderr "Stress run left unexpected compositor or app processes."; exit 1}
            timeout {puts stderr "Timed out recording post-stress metrics."; exit 1}
            eof {puts stderr "QEMU exited before post-stress metrics."; exit 1}
        }
        puts "STRESS_CAMPAIGN=passed"
    }

    qmp_key_chord $qmp {meta_l shift} q
    set compositor_exit_command {for n in $(seq 1 60); do if ! pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null; then break; fi; sleep 1; done; printf 'COMPOSITOR_LOG_TAIL_BEGIN\n'; if grep -Eq 'AddressSanitizer:|LeakSanitizer:|runtime error:' /tmp/seyrix-compositor.log; then cat /tmp/seyrix-compositor.log; else tail -n 50 /tmp/seyrix-compositor.log 2>/dev/null || true; fi; printf 'COMPOSITOR_LOG_TAIL_END\n'; printf 'OUTPUT_TEARDOWN_LOG='; if grep -q 'No outputs remain; stopping compositor' /tmp/seyrix-compositor.log; then echo unexpected; else echo clean; fi; printf 'CLEAN_STOP_LOG='; if grep -q 'Seyrix compositor stopped cleanly' /tmp/seyrix-compositor.log; then echo present; else echo missing; fi; printf 'MEM_TOTAL_KB='; awk '/MemTotal/ {print $2}' /proc/meminfo; printf 'MEM_AVAILABLE_KB='; awk '/MemAvailable/ {print $2}' /proc/meminfo; printf 'RUNNING_SERVICES='; systemctl list-units --type=service --state=running --no-legend | wc -l; printf 'PACKAGE_COUNT='; pacman --config /dev/null -Q | wc -l; if ! pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null && systemctl is-active --quiet getty@tty1 && pgrep -a -u 1000 | grep -Eq ' [-]?bash$' && grep -q 'Seyrix compositor stopped cleanly' /tmp/seyrix-compositor.log && ! grep -q 'No outputs remain; stopping compositor' /tmp/seyrix-compositor.log; then echo COMPOSITOR_EXIT=passed; else echo COMPOSITOR_EXIT=failed; fi}
    send -- "$compositor_exit_command\r"
    expect {
        -re {COMPOSITOR_EXIT=passed} {}
        -re {COMPOSITOR_EXIT=failed} {
            puts stderr "Super+Shift+Q did not return the user to the tty1 shell."
            exit 1
        }
        timeout {
            puts stderr "Timed out waiting for a clean Seyrix compositor exit."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before compositor shutdown was checked."
            exit 1
        }
    }
    if {$sanitizers_enabled} {
        set sanitizer_check_command {if grep -Eq 'AddressSanitizer:|LeakSanitizer:|runtime error:' /tmp/seyrix-compositor.log; then echo SANITIZER_FINDINGS=present; else echo SANITIZER_FINDINGS=none; fi}
        send -- "$sanitizer_check_command\r"
        expect {
            -re {SANITIZER_FINDINGS=none} {puts "SANITIZER_FINDINGS=none"}
            -re {SANITIZER_FINDINGS=present} {puts stderr "Sanitizer diagnostics appeared in the compositor log."; exit 1}
            timeout {puts stderr "Timed out checking sanitizer diagnostics."; exit 1}
            eof {puts stderr "QEMU exited before sanitizer diagnostics were checked."; exit 1}
        }
    }
    qmp_hmp $qmp "screendump $run_dir/tty1-after-seyrix-exit.ppm"
    puts "SESSION_EXIT=passed"
    if {[info exists env(SEYRIX_QEMU_STRESS)] && $env(SEYRIX_QEMU_STRESS) eq "1"} {
        qmp_type $qmp $compositor_launch_command
        set restart_start [clock milliseconds]
        qmp_key_transition $qmp ret 1
        after 80
        qmp_key_transition $qmp ret 0
        set restart_ready_command {for n in $(seq 1 60); do if pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null && grep -q 'SEYRIX_COMPOSITOR_READY=1' /tmp/seyrix-compositor.log 2>/dev/null && grep -q 'Window mapped:' /tmp/seyrix-compositor.log 2>/dev/null && pgrep -u 1000 -x weston-terminal >/dev/null; then break; fi; sleep 1; done; if pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null && grep -q 'SEYRIX_COMPOSITOR_READY=1' /tmp/seyrix-compositor.log 2>/dev/null && grep -q 'Window mapped:' /tmp/seyrix-compositor.log 2>/dev/null && pgrep -u 1000 -x weston-terminal >/dev/null; then echo COMPOSITOR_RESTART=passed; else echo COMPOSITOR_RESTART=failed; fi; printf 'RESTART_RENDERER='; grep -i 'renderer' /tmp/seyrix-compositor.log | head -n 1; printf 'RESTART_COMPOSITOR_RSS_KB='; compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1); awk '/VmRSS:/ {print $2}' "/proc/$compositor_pid/status"}
        send -- "$restart_ready_command\r"
        expect {
            -re {COMPOSITOR_RESTART=passed} {
                set restart_ms [expr {[clock milliseconds] - $restart_start}]
                puts "COMPOSITOR_RESTART_STARTUP_MS=$restart_ms"
            }
            -re {COMPOSITOR_RESTART=failed} {puts stderr "Seyrix compositor did not restart cleanly."; exit 1}
            timeout {puts stderr "Timed out restarting Seyrix compositor."; exit 1}
            eof {puts stderr "QEMU exited before compositor restart."; exit 1}
        }
        qmp_type $qmp "touch /tmp/seyrix-restart-keyboard-ok\n"
        set restart_input_command {if test -f /tmp/seyrix-restart-keyboard-ok; then echo COMPOSITOR_RESTART_INPUT=passed; else echo COMPOSITOR_RESTART_INPUT=failed; fi}
        send -- "$restart_input_command\r"
        expect {
            -re {COMPOSITOR_RESTART_INPUT=passed} {}
            -re {COMPOSITOR_RESTART_INPUT=failed} {puts stderr "Keyboard input failed after compositor restart."; exit 1}
            timeout {puts stderr "Timed out checking input after compositor restart."; exit 1}
            eof {puts stderr "QEMU exited checking input after compositor restart."; exit 1}
        }
        qmp_key_chord $qmp {meta_l shift} q
        set restart_exit_command {for n in $(seq 1 60); do if ! pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null; then break; fi; sleep 1; done; if ! pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null && systemctl is-active --quiet getty@tty1 && pgrep -a -u 1000 | grep -Eq ' [-]?bash$' && grep -q 'Seyrix compositor stopped cleanly' /tmp/seyrix-compositor.log && ! grep -q 'No outputs remain; stopping compositor' /tmp/seyrix-compositor.log; then echo COMPOSITOR_RESTART_EXIT=passed; else echo COMPOSITOR_RESTART_EXIT=failed; fi; printf 'RESTART_LOG_TAIL_BEGIN\n'; tail -n 40 /tmp/seyrix-compositor.log; printf 'RESTART_LOG_TAIL_END\n'}
        send -- "$restart_exit_command\r"
        expect {
            -re {COMPOSITOR_RESTART_EXIT=passed} {}
            -re {COMPOSITOR_RESTART_EXIT=failed} {puts stderr "Restarted compositor did not exit cleanly."; exit 1}
            timeout {puts stderr "Timed out waiting for restarted compositor exit."; exit 1}
            eof {puts stderr "QEMU exited before restarted compositor exit check."; exit 1}
        }
        puts "COMPOSITOR_RESTART_EXIT=passed"
        if {$sanitizers_enabled} {
            send -- "$sanitizer_check_command\r"
            expect {
                -re {SANITIZER_FINDINGS=none} {puts "SANITIZER_FINDINGS=none"}
                -re {SANITIZER_FINDINGS=present} {puts stderr "Sanitizer diagnostics appeared after compositor restart."; exit 1}
                timeout {puts stderr "Timed out checking sanitizer diagnostics after restart."; exit 1}
                eof {puts stderr "QEMU exited before restart sanitizer diagnostics were checked."; exit 1}
            }
        }
    }
} else {
qmp_hmp $qmp "screendump $run_dir/tty1-before-wayland.ppm"
qmp_type $qmp "start-wayland\n"
after 2000
qmp_hmp $qmp "screendump $run_dir/tty1-after-wayland-command.ppm"
set wayland_ready_command {for n in $(seq 1 120); do test -f "/run/user/$(id -u seyrix)/seyrix-wayland-ready" && break; sleep 1; done; if test -f "/run/user/$(id -u seyrix)/seyrix-wayland-ready"; then echo WAYLAND_SESSION_READY=passed; else echo WAYLAND_SESSION_READY=failed; tail -n 40 /tmp/seyrix-weston-gl.log /tmp/seyrix-weston-pixman.log 2>/dev/null; fi}
send -- "$wayland_ready_command\r"
expect {
    -re {WAYLAND_SESSION_READY=passed} {
        set graphics_ms [expr {[clock milliseconds] - $boot_started}]
        puts "GRAPHICAL_BOOT_MS=$graphics_ms"
    }
    -re {WAYLAND_SESSION_READY=failed} {
        puts stderr "Weston failed to open a Wayland session."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for the Weston terminal session."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the Weston session became ready."
        exit 1
    }
}

set wayland_stability_command {sleep 2; if test -f "/run/user/$(id -u seyrix)/seyrix-wayland-ready" && pgrep -u 1000 -x weston >/dev/null && pgrep -u 1000 -x weston-terminal >/dev/null; then echo WAYLAND_SESSION_STABLE=passed; else echo WAYLAND_SESSION_STABLE=failed; fi; printf 'WAYLAND_STATUS_FILE_BEGIN\n'; cat /tmp/seyrix-weston-status.txt 2>/dev/null || true; printf 'WAYLAND_STATUS_FILE_END\n'; printf 'WESTON_PROCESSES_BEGIN\n'; pgrep -a -u 1000 -f 'weston|weston-terminal' || true; printf 'WESTON_PROCESSES_END\n'; printf 'WESTON_LOGS_BEGIN\n'; cat /tmp/seyrix-weston-gl.log /tmp/seyrix-weston-pixman.log 2>/dev/null || true; printf 'WESTON_LOGS_END\nWAYLAND_DIAGNOSTICS_END\n'}
send -- "$wayland_stability_command\r"
expect {
    -re {WAYLAND_SESSION_STABLE=passed} {}
    -re {WAYLAND_SESSION_STABLE=failed} {
        puts stderr "Wayland socket did not remain available with Weston and its terminal app running."
        exit 1
    }
    timeout {
        puts stderr "Timed out checking the persistent Weston session."
        exit 1
    }
    eof {
        puts stderr "QEMU exited while checking the persistent Weston session."
        exit 1
    }
}

set graphical_metrics_command {printf 'GRAPHICAL_MEM_TOTAL_KB='; awk '/MemTotal/ {print $2}' /proc/meminfo; printf 'GRAPHICAL_MEM_AVAILABLE_KB='; awk '/MemAvailable/ {print $2}' /proc/meminfo; printf 'GRAPHICAL_MEMORY_USED_APPROX_KB='; awk '/MemTotal/ {t=$2} /MemAvailable/ {a=$2} END {print t-a}' /proc/meminfo; printf 'GRAPHICAL_RUNNING_SERVICES='; systemctl list-units --type=service --state=running --no-legend | wc -l; printf 'GRAPHICAL_METRICS_END\n'}
send -- "$graphical_metrics_command\r"
expect {
    -re {GRAPHICAL_METRICS_END} {}
    timeout {
        puts stderr "Timed out collecting metrics for the running graphical session."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before graphical session metrics were collected."
        exit 1
    }
}

qmp_hmp $qmp "screendump $run_dir/desktop-before.ppm"
qmp_type $qmp "touch /tmp/seyrix-keyboard-ok\n"
after 500
qmp_hmp $qmp "screendump $run_dir/desktop-after-keyboard.ppm"
set keyboard_check_command {for n in $(seq 1 30); do test -f /tmp/seyrix-keyboard-ok && break; sleep 1; done; if test -f /tmp/seyrix-keyboard-ok; then echo KEYBOARD_INPUT=passed; else echo KEYBOARD_INPUT=failed; fi}
send -- "$keyboard_check_command\r"
expect {
    -re {KEYBOARD_INPUT=passed} {}
    -re {KEYBOARD_INPUT=failed} {
        puts stderr "Keyboard input did not create the guest marker."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for graphical keyboard input."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before graphical keyboard input was checked."
        exit 1
    }
}

qmp_mouse_move $qmp 2500 2500
after 750
qmp_hmp $qmp "screendump $run_dir/desktop-pointer-a.ppm"
qmp_mouse_move $qmp 29000 21000
qmp_mouse_click $qmp
after 750
qmp_hmp $qmp "screendump $run_dir/desktop-pointer-b.ppm"
puts "MOUSE_EVENTS_SENT=2"

set mouse_check_command {sleep 1; printf 'EVTEST_POINTER_EVENTS_BEGIN\n'; grep -E 'ABS_X|ABS_Y' /tmp/seyrix-evtest-mouse.log | tail -n 20; if grep -q 'ABS_X' /tmp/seyrix-evtest-mouse.log && grep -q 'ABS_Y' /tmp/seyrix-evtest-mouse.log; then echo MOUSE_INPUT=passed; else echo MOUSE_INPUT=failed; fi}
send -- "$mouse_check_command\r"
expect {
    -re {MOUSE_INPUT=passed} {}
    -re {MOUSE_INPUT=failed} {
        puts stderr "QEMU mouse events did not produce evdev absolute pointer motion."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for guest evdev pointer events."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before guest mouse input was checked."
        exit 1
    }
}

set session_active_command {if test -f "/run/user/$(id -u seyrix)/seyrix-wayland-ready" && pgrep -u 1000 -x weston >/dev/null && pgrep -u 1000 -x weston-terminal >/dev/null; then echo WAYLAND_SESSION_BEFORE_EXIT=passed; else echo WAYLAND_SESSION_BEFORE_EXIT=failed; fi}
send -- "$session_active_command\r"
expect {
    -re {WAYLAND_SESSION_BEFORE_EXIT=passed} {}
    -re {WAYLAND_SESSION_BEFORE_EXIT=failed} {
        puts stderr "Weston and its terminal app were not both active before the exit-key check."
        exit 1
    }
    timeout {
        puts stderr "Timed out checking the Wayland session before exit."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the Wayland pre-exit check."
        exit 1
    }
}

qmp_type $qmp "exit\n"
set session_exit_command {for n in $(seq 1 60); do test ! -f "/run/user/$(id -u seyrix)/seyrix-wayland-ready" && break; sleep 1; done; if test ! -f "/run/user/$(id -u seyrix)/seyrix-wayland-ready"; then echo SESSION_EXIT=passed; else echo SESSION_EXIT=failed; fi; if systemctl is-active --quiet getty@tty1 && pgrep -a -u 1000 | grep -Eq ' [-]?bash$'; then echo TTY1_SHELL_RETURN=passed; else echo TTY1_SHELL_RETURN=failed; fi; printf 'WESTON_STATUS='; cat /tmp/seyrix-weston-status.txt 2>/dev/null || echo missing; printf 'WESTON_RENDERER_LOGS_BEGIN\n'; grep -hEi 'renderer|rendering device|libseat|drm' /tmp/seyrix-weston-gl.log /tmp/seyrix-weston-pixman.log 2>/dev/null | tail -n 40 || true; printf 'WESTON_RENDERER_LOGS_END\n'}
send -- "$session_exit_command\r"
expect {
    -re {SESSION_EXIT=passed} {}
    -re {SESSION_EXIT=failed} {
        puts stderr "Wayland session did not exit cleanly."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for Weston to return to tty1."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before Wayland session exit was checked."
        exit 1
    }
}
expect {
    -re {TTY1_SHELL_RETURN=passed} {}
    -re {TTY1_SHELL_RETURN=failed} {
        puts stderr "The graphical session exited without returning to the tty1 user shell."
        exit 1
    }
    timeout {
        puts stderr "Timed out checking return to the tty1 shell."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before return to the tty1 shell was checked."
        exit 1
    }
}
qmp_hmp $qmp "screendump $run_dir/tty1-after-wayland-exit.ppm"
puts "SESSION_EXIT=passed"
}

if {$egl_lifecycle_control} {
	set timeout 120
	puts "STAGE_BEGIN name={direct Mesa EGL GBM lifecycle sanitizer control} timeout_s=120"
	set egl_control_command {ASAN_OPTIONS=detect_leaks=1 /usr/local/bin/seyrix-egl-gbm-lifecycle-control; egl_control_status=$?; echo EGL_CONTROL_EXIT=$egl_control_status}
	send -- "$egl_control_command\r"
	set egl_control_renderer_llvmpipe 0
	set egl_control_exit -1
	set egl_control_incomplete 0
	expect {
		-re {EGL_CONTROL_GL_RENDERER=llvmpipe[^\r\n]*\r} {
			set egl_control_renderer_llvmpipe 1
			exp_continue
		}
		-re {EGL_CONTROL_EXIT=([0-9]+)\r} {
			set egl_control_exit $expect_out(1,string)
		}
		timeout {
			puts stderr "STAGE_RESULT name={direct Mesa EGL GBM lifecycle sanitizer control} result=INCOMPLETE reason=timeout"
			set egl_control_incomplete 1
		}
		eof {
			puts stderr "STAGE_RESULT name={direct Mesa EGL GBM lifecycle sanitizer control} result=INCOMPLETE reason=guest-exit"
			set egl_control_incomplete 1
		}
	}
	if {$egl_control_incomplete} {
		incr acceptance_failures
	} elseif {$egl_control_exit eq "0" && $egl_control_renderer_llvmpipe} {
		puts "STAGE_RESULT name={direct Mesa EGL GBM lifecycle sanitizer control} result=PASS"
	} else {
		puts stderr "STAGE_RESULT name={direct Mesa EGL GBM lifecycle sanitizer control} result=FAIL exit=$egl_control_exit renderer_llvmpipe=$egl_control_renderer_llvmpipe"
		incr acceptance_failures
	}
}

set shutdown_command {printf 'SEYRIX_GRAPHICS_CHECK_END\n'; systemctl poweroff}
send -- "$shutdown_command\r"
set timeout 90
expect {
    eof {}
    timeout {
        puts stderr "Timed out waiting for clean guest shutdown."
        exit 1
    }
}
set wait_result [wait]
set qemu_exit [lindex $wait_result 3]
if {$qemu_exit != 0} {
    puts stderr "QEMU exited with status $qemu_exit after guest shutdown."
    exit 1
}

puts "CLEAN_SHUTDOWN=passed"
if {$acceptance_failures > 0} {
    puts stderr "ACCEPTANCE_FAILURES=$acceptance_failures; QEMU and guest shutdown completed."
    exit 1
}
