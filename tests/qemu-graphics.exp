			set target_process_kill_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); if [[ -n "$pid" ]]; then kill -KILL "$pid" && printf 'SETTINGS_RECOVERY_PROCESS_KILLED pid=%s signal=KILL\\n' "$pid"; else echo SETTINGS_RECOVERY_PROCESS_KILLED=failed; fi}
