				set target_recovery_popup_command {
pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
baseline=$(cat /tmp/seyrix-settings-recovery-category-baseline)
trace=/tmp/seyrix-compositor.log
xdg_surface_id=; popup_id=; surface_id=; popup_x=; popup_y=; popup_width=; popup_height=
configured=0; acknowledged=0; attached=0; ready=0
exec {trace_fd}< <(tail -n +$((baseline + 1)) -F "$trace")
trace_pid=$!
deadline=$((SECONDS + 15))
while (( SECONDS < deadline )); do
  if ! IFS= read -r -t 0.25 -u "$trace_fd" line; then continue; fi
  [[ "$line" == *"source=client-stderr pid=$pid "* ]] || continue
  if [[ "$line" =~ xdg_wm_base[@#][0-9]+\.get_xdg_surface\(new[[:space:]]id[[:space:]]xdg_surface[@#]([0-9]+),[[:space:]]wl_surface[@#]([0-9]+)\) ]]; then
    xdg_surface_id=${BASH_REMATCH[1]}; surface_id=${BASH_REMATCH[2]}
  fi
  if [[ "$line" =~ xdg_surface[@#]([0-9]+)\.get_popup\(new[[:space:]]id[[:space:]]xdg_popup[@#]([0-9]+), ]] &&
      [[ "${BASH_REMATCH[1]}" == "$xdg_surface_id" ]]; then
    popup_id=${BASH_REMATCH[2]}; configured=0; acknowledged=0; attached=0
  fi
  if [[ -n "$popup_id" && "$line" =~ xdg_popup[@#]${popup_id}\.configure\((-?[0-9]+),[[:space:]]*(-?[0-9]+),[[:space:]]*([0-9]+),[[:space:]]*([0-9]+)\) ]]; then
    popup_x=${BASH_REMATCH[1]}; popup_y=${BASH_REMATCH[2]}; popup_width=${BASH_REMATCH[3]}; popup_height=${BASH_REMATCH[4]}; configured=1
  fi
  if [[ -n "$xdg_surface_id" && "$line" =~ xdg_surface[@#]${xdg_surface_id}\.ack_configure\([0-9]+\) && "$configured" == 1 ]]; then acknowledged=1; fi
  if [[ -n "$surface_id" && "$line" =~ wl_surface[@#]${surface_id}\.attach\(wl_buffer[@#][0-9]+, && "$acknowledged" == 1 ]]; then attached=1; fi
  if [[ -n "$surface_id" && "$line" =~ wl_surface[@#]${surface_id}\.commit\(\) && "$configured" == 1 && "$acknowledged" == 1 && "$attached" == 1 ]]; then
