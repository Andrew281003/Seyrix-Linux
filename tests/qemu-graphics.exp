			run_serial_check $target_recovery_category_command {SETTINGS_RECOVERY_SAVED_CATEGORY=passed} {SETTINGS_RECOVERY_SAVED_CATEGORY=failed} "save the Input category through the real GTK control before supervised recovery" 15
