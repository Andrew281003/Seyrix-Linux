			set target_user_open_baseline_command {wc -l < /tmp/seyrix-compositor.log > /tmp/seyrix-settings-supervisor-open-baseline; read -r old_pid old_start manager manager_start category width height maximized paned log_lines compositor compositor_start < /tmp/seyrix-settings-supervisor-before; printf '%s %s\\n' "$old_pid" "$manager" > /tmp/seyrix-settings-supervisor-open-before; echo SETTINGS_SUPERVISOR_OPEN_BASELINE=ready}
