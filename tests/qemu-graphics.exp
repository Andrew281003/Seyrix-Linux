				qmp_key_chord $qmp {} tab
				qmp_key_chord $qmp {} spc
				set keyboard_focus_check_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; space=$(grep -F "pid=$pid event=gtk_input_key_press page=space " "$trace" | tail -n 1); printf 'SETTINGS_KEYBOARD_SPACE_FOCUS=%s\n' "${space:-missing}"; if [[ "$space" == *focus_widget=GtkToggleButton* && "$space" == *target_widget=GtkToggleButton* && "$space" == *selected_category=desktop* ]]; then echo SETTINGS_KEYBOARD_FOCUS=verified; else echo SETTINGS_KEYBOARD_FOCUS=failed; fi}
				run_serial_check $keyboard_focus_check_command {SETTINGS_KEYBOARD_FOCUS=verified} {SETTINGS_KEYBOARD_FOCUS=failed} "verify the focused compact category selector receives Space before keyboard selection" 10
			} else {
				set keyboard_setup_baseline_command {wc -l < /tmp/seyrix-compositor.log > /tmp/seyrix-settings-keyboard-setup-baseline; wc -l < /tmp/seyrix-compositor.log > /tmp/seyrix-settings-keyboard-setup-compositor-baseline; echo SETTINGS_KEYBOARD_SETUP_BASELINE=ready}
				run_serial_check $keyboard_setup_baseline_command {SETTINGS_KEYBOARD_SETUP_BASELINE=ready} {SETTINGS_KEYBOARD_SETUP_BASELINE=failed} "record GTK state before restoring Appearance focus for keyboard navigation" 10
				set appearance_bounds_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; line=$(grep -F "pid=$pid event=gtk_sidebar_row_bounds page=appearance " "$trace" | tail -n 1); bounds=$(sed -nE 's/.*bounds_valid=1 bounds=([0-9.]+),([0-9.]+),([0-9.]+),([0-9.]+).*/\1,\2,\3,\4/p' <<< "$line"); if [[ "$line" == *visible=1* && "$line" == *mapped=1* && "$line" == *target_category=appearance* && -n "$bounds" ]]; then printf 'SETTINGS_DIAGNOSTIC_APPEARANCE_BOUNDS=%s\n' "$bounds"; else echo SETTINGS_DIAGNOSTIC_APPEARANCE_BOUNDS=missing; fi}
				set appearance_bounds [run_serial_capture $appearance_bounds_command {SETTINGS_DIAGNOSTIC_APPEARANCE_BOUNDS=([0-9.]+),([0-9.]+),([0-9.]+),([0-9.]+)} {SETTINGS_DIAGNOSTIC_APPEARANCE_BOUNDS=missing} "read mapped Appearance row bounds before keyboard setup" 10]
				if {[lindex $appearance_bounds 0] ne "pass"} {
					puts stderr "The Appearance sidebar row is not visible and mapped."
