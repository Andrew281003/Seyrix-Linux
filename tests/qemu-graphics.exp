				exit 1
			}
			puts "SETTINGS_RESTORE_APPEARANCE_PIXELS=passed $appearance_restore_pixel_result"
				set keyboard_trace_baseline_command {wc -l < /tmp/seyrix-compositor.log > /tmp/seyrix-settings-keyboard-trace-baseline; echo SETTINGS_KEYBOARD_TRACE_BASELINE=ready}
				run_serial_check $keyboard_trace_baseline_command {SETTINGS_KEYBOARD_TRACE_BASELINE=ready} {SETTINGS_KEYBOARD_TRACE_BASELINE=failed} "record GTK state before keyboard category navigation" 10
				qmp_key_chord $qmp {ctrl} f
				qmp_key_chord $qmp {} tab
				qmp_key_chord $qmp {} spc
				set keyboard_focus_check_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; baseline=$(cat /tmp/seyrix-settings-keyboard-trace-baseline); delta=$(tail -n +$((baseline + 1)) "$trace"); down=$(grep -F "pid=$pid event=gtk_input_key_press page=Down " <<< "$delta" | tail -n 1); selected=$(grep -F "pid=$pid event=gtk_sidebar_row_selected page=desktop " <<< "$delta" | tail -n 1); page=$(grep -F "pid=$pid event=gtk_page_selection page=desktop selected=desktop" <<< "$delta" | tail -n 1); mapped_page=$(grep -F "pid=$pid event=gtk_page_bounds page=desktop " <<< "$delta" | tail -n 1); printf 'SETTINGS_KEYBOARD_DOWN_FOCUS=%s\nSETTINGS_KEYBOARD_SELECTED_ROW=%s\nSETTINGS_KEYBOARD_STACK_PAGE=%s\nSETTINGS_KEYBOARD_PAGE_MAPPED=%s\n' "$down" "$selected" "$page" "$mapped_page"; if [[ "$down" == *focus_widget=GtkListBoxRow* && "$down" == *focus_category=appearance* && "$down" == *target_category=appearance* && "$selected" == *category_sync_active=0* && "$selected" == *target_category=desktop* && "$selected" == *selected_category=desktop* && -n "$page" && "$mapped_page" == *visible=1* && "$mapped_page" == *mapped=1* && "$mapped_page" == *selected=desktop* ]]; then echo SETTINGS_KEYBOARD_FOCUS=verified; else echo SETTINGS_KEYBOARD_FOCUS=failed; fi}
				run_serial_check $keyboard_focus_check_command {SETTINGS_KEYBOARD_FOCUS=verified} {SETTINGS_KEYBOARD_FOCUS=failed} "verify keyboard focus left search and reached the Desktop & Dock sidebar row before activation" 10
			}
			if {$last_serial_check_result ne "pass"} {
				puts "SETTINGS_KEYBOARD_ACTIVATION=SKIPPED reason=focus-or-selection-failed"
				puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=keyboard-focus-failed"
				exit 1
			}
			if {$trace_window_width < 760} {
				qmp_key_chord $qmp {} home
				qmp_key_chord $qmp {} down
				qmp_key_chord $qmp {} down
				qmp_key_chord $qmp {} ret
			}
			set keyboard_focus_ok 0
			if {$last_serial_check_result eq "pass"} {
				set keyboard_focus_ok 1
				after 3000
				qmp_hmp $qmp "screendump $run_dir/settings-render-keyboard-desktop.ppm"
				set keyboard_trace_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); grep -F "pid=$pid event=gtk_" /tmp/seyrix-compositor.log | tail -n 45; echo SETTINGS_KEYBOARD_TRACE_CAPTURE=complete}
				run_serial_check $keyboard_trace_command {SETTINGS_KEYBOARD_TRACE_CAPTURE=complete} {SETTINGS_KEYBOARD_TRACE_CAPTURE=failed} "record GTK activation and selection after verified keyboard focus" 10
				if {$trace_window_width < 760} {
					set keyboard_transition_check_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; selected=$(grep -F "pid=$pid event=gtk_category_selector_changed page=windows " "$trace" | tail -n 1); page=$(grep -F "pid=$pid event=gtk_page_selection page=windows selected=windows" "$trace" | tail -n 1); mapped_page=$(grep -F "pid=$pid event=gtk_page_bounds page=windows " "$trace" | tail -n 1); unmapped_page=$(grep -F "pid=$pid event=gtk_page_unmap page=desktop " "$trace" | tail -n 1); printf "SETTINGS_KEYBOARD_SELECTOR=%s\nSETTINGS_KEYBOARD_STACK_PAGE=%s\nSETTINGS_KEYBOARD_MAPPED_PAGE=%s\nSETTINGS_KEYBOARD_OUTGOING_PAGE=%s\n" "$selected" "$page" "$mapped_page" "$unmapped_page"; if [[ "$selected" == *category_sync_active=0* && -n "$page" && "$mapped_page" == *visible=1* && "$mapped_page" == *mapped=1* && "$mapped_page" == *selected=windows* && "$unmapped_page" == *page=desktop* && "$unmapped_page" == *mapped=0* ]]; then echo SETTINGS_KEYBOARD_TRANSITION=passed; else echo SETTINGS_KEYBOARD_TRANSITION=failed; fi; grep -E 'wl_surface[@#].*(damage|attach|commit)' /tmp/seyrix-compositor.log | tail -n 20}
				} else {
					set keyboard_transition_check_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; baseline=$(cat /tmp/seyrix-settings-keyboard-trace-baseline); delta=$(tail -n +$((baseline + 1)) "$trace"); selected=$(grep -F "pid=$pid event=gtk_sidebar_row_selected page=desktop " <<< "$delta" | tail -n 1); page=$(grep -F "pid=$pid event=gtk_page_selection page=desktop selected=desktop" <<< "$delta" | tail -n 1); if [[ "$selected" == *category_sync_active=0* && "$selected" == *target_category=desktop* && -n "$page" ]]; then echo SETTINGS_KEYBOARD_TRANSITION=passed; else echo SETTINGS_KEYBOARD_TRANSITION=failed; fi; printf 'SETTINGS_KEYBOARD_ROW_SELECTED=%s\nSETTINGS_KEYBOARD_STACK_PAGE=%s\n' "${selected:-missing}" "${page:-missing}"; grep -E 'wl_surface[@#].*(damage|attach|commit)' <<< "$delta" | tail -n 20}
				}
				run_serial_check $keyboard_transition_check_command {SETTINGS_KEYBOARD_TRANSITION=passed} {SETTINGS_KEYBOARD_TRANSITION=failed} "verify keyboard category activation and visible Settings stack selection" 10
				if {$last_serial_check_result ne "pass"} {
					puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=keyboard-transition-failed"
					exit 1
				}
				if {$trace_window_width < 760} {
					if {[catch {exec python3 $render_helper $run_dir/settings-render-mouse-desktop.ppm $run_dir/settings-render-keyboard-desktop.ppm $output_width} keyboard_pixel_result]} {
						puts stderr "Compact keyboard navigation did not change the visible Settings page. $keyboard_pixel_result"
						puts "SETTINGS_KEYBOARD_PAGE_PIXELS=INCOMPLETE"
						puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=keyboard-page-pixels-unchanged"
						exit 1
					}
					puts "SETTINGS_KEYBOARD_PAGE_PIXELS=passed $keyboard_pixel_result"
				} elseif {[catch {exec python3 $render_helper $run_dir/settings-render-keyboard-before.ppm $run_dir/settings-render-keyboard-desktop.ppm $output_width} keyboard_pixel_result]} {
					puts stderr "Desktop & Dock pixels did not change after keyboard category navigation. $keyboard_pixel_result"
					puts "SETTINGS_KEYBOARD_PAGE_PIXELS=INCOMPLETE"
					puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=keyboard-page-pixels-unchanged"
					exit 1
				} else {
					puts "SETTINGS_KEYBOARD_PAGE_PIXELS=passed $keyboard_pixel_result"
				}
			} else {
				puts "SETTINGS_KEYBOARD_ACTIVATION=SKIPPED reason=focus-verification-failed"
				qmp_hmp $qmp "screendump $run_dir/settings-render-keyboard-focus-failed.ppm"
			}
			qmp_mouse_move_pixel $qmp 70 500 $output_width $output_height
			after 250
			qmp_hmp $qmp "screendump $run_dir/settings-render-desktop.ppm"
			set render_trace_summary_command {trace=/tmp/seyrix-compositor.log; baseline=$(cat /tmp/seyrix-settings-wayland-trace-baseline); delta=$(tail -n +$((baseline + 1)) "$trace"); selection=$(grep -F 'event=gtk_page_selection' "$trace" | tail -n 1 || true); pointer=$(grep -F 'Pointer button press button=272' /tmp/seyrix-compositor.log | tail -n 1 || true); settings_pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); printf 'WAYLAND_TRACE_DELTA_LINES=%s\n' "$(printf '%s\n' "$delta" | wc -l)"; printf 'WAYLAND_TRACE_GTK_EVENTS_BEGIN pid=%s\n' "$settings_pid"; grep -F "pid=$settings_pid " "$trace" | grep -E 'SEYRIX_SETTINGS_RAW_INPUT|event=gtk_(sidebar_row_activated|sidebar_row_selected|sidebar_row_selected_suppressed|page_selection|page_map|page_unmap|window_map|window_unmap|input_)' | tail -n 60 || true; printf 'WAYLAND_TRACE_GTK_EVENTS_END\n'; printf 'WAYLAND_TRACE_GTK_PAGE_SELECTION=%s\n' "${selection:-missing}"; printf 'WAYLAND_TRACE_COMPOSITOR_POINTER=%s\n' "${pointer:-missing}"; printf 'WAYLAND_TRACE_CLIENT_PROTOCOL_BEGIN\n%s\nWAYLAND_TRACE_CLIENT_PROTOCOL_END\n' "$delta"; printf 'WAYLAND_TRACE_COMPOSITOR_RENDER_BEGIN\n'; grep -F "pid=$settings_pid " /tmp/seyrix-compositor.log | grep 'SETTINGS_RENDER_TRACE event=' | tail -n 40 || true; printf 'WAYLAND_TRACE_COMPOSITOR_RENDER_END\n'; printf 'WAYLAND_TRACE_SURFACE_DAMAGE=%s\n' "$(printf '%s\n' "$delta" | grep -Ec 'wl_surface[@#].*damage(_buffer)?[(]' || true)"; printf 'WAYLAND_TRACE_SURFACE_ATTACH=%s\n' "$(printf '%s\n' "$delta" | grep -Ec 'wl_surface[@#].*attach[(]' || true)"; printf 'WAYLAND_TRACE_SURFACE_COMMIT=%s\n' "$(printf '%s\n' "$delta" | grep -Ec 'wl_surface[@#].*commit[(]' || true)"; printf 'WAYLAND_TRACE_FRAME_REQUEST=%s\n' "$(printf '%s\n' "$delta" | grep -Ec 'wl_surface[@#].*frame[(]' || true)"; if grep -Fq 'event=gtk_page_selection page=desktop selected=desktop' "$trace"; then echo WAYLAND_TRACE_PAGE_SELECTION=desktop; else echo WAYLAND_TRACE_PAGE_SELECTION=failed; fi; echo WAYLAND_TRACE_SUMMARY=complete}
			run_serial_check $render_trace_summary_command {WAYLAND_TRACE_SUMMARY=complete} {WAYLAND_TRACE_SUMMARY=failed} "collect GTK page-selection state and wl_surface damage after selecting Desktop & Dock" 20
			if {$last_serial_check_result eq "pass"} {
				run_serial_check {if grep -Fq 'event=gtk_page_selection page=desktop selected=desktop' /tmp/seyrix-compositor.log; then echo WAYLAND_TRACE_PAGE_SELECTION=desktop; else echo WAYLAND_TRACE_PAGE_SELECTION=failed; fi} {WAYLAND_TRACE_PAGE_SELECTION=desktop} {WAYLAND_TRACE_PAGE_SELECTION=failed} "verify GTK selected the Desktop & Dock stack page" 10
			}
			if {[catch {exec python3 $render_helper $run_dir/settings-render-appearance.ppm $run_dir/settings-render-desktop.ppm $output_width} render_pixel_result]} {
				puts "SETTINGS_RENDER_PIXEL_COMPARISON=$render_pixel_result"
			} else {
				puts "SETTINGS_RENDER_PIXEL_COMPARISON=$render_pixel_result"
			}
			qmp_key_chord $qmp {meta_l} q
			set traced_app_exit_command {pid=$(cat /tmp/seyrix-settings-trace-pid 2>/dev/null || true); for n in $(seq 1 30); do if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && [[ ! -d "/proc/$pid" ]] && ! pgrep -u 1000 -x seyrix-settings >/dev/null; then echo WAYLAND_TRACE_APP_EXIT=passed PID=$pid; break; fi; sleep 0.2; done; if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && [[ ! -d "/proc/$pid" ]] && ! pgrep -u 1000 -x seyrix-settings >/dev/null; then :; else echo WAYLAND_TRACE_APP_EXIT=failed PID=$pid; fi}
			run_serial_check $traced_app_exit_command {WAYLAND_TRACE_APP_EXIT=passed} {WAYLAND_TRACE_APP_EXIT=failed} "verify the fresh traced Settings process exits after category capture" 10
			if {$last_serial_check_result ne "pass"} {
				puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=traced-app-exit-not-confirmed"
				exit 1
			}
			run_serial_check {if test -r /etc/os-release; then echo GUEST_CONTROL_SHELL_FOLLOWUP=passed; else echo GUEST_CONTROL_SHELL_FOLLOWUP=failed; fi} {GUEST_CONTROL_SHELL_FOLLOWUP=passed} {GUEST_CONTROL_SHELL_FOLLOWUP=failed} "verify the persistent guest control shell accepts a command after traced Settings exit" 10
			if {$last_serial_check_result ne "pass"} {
				puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=guest-control-shell-did-not-survive-traced-app-exit"
				exit 1
			}
			puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=PASS"
			finish_guest_shutdown $qmp "clean guest shutdown after targeted rendering diagnostic" 45 0
			puts "FULL_GRAPHICAL_ACCEPTANCE=NOT_RUN reason=targeted-diagnostic-only"
			exit 0
		}
		set manual_map_baseline_command {before=$(grep -c 'Layer shell surface mapped namespace=seyrix-manual' /tmp/seyrix-compositor.log || true); printf '%s\n' "$before" > /tmp/seyrix-phase2d2-manual-map-baseline; echo PHASE2D2_MANUAL_BASELINE=ready}
		run_serial_check $manual_map_baseline_command {PHASE2D2_MANUAL_BASELINE=ready} {PHASE2D2_MANUAL_BASELINE=failed} "record Manual overlay baseline before desktop click" 10
		qmp_mouse_click_pixel $qmp 58 [expr {$output_height - 180}] $output_width $output_height
		after 500
		qmp_hmp $qmp "screendump $run_dir/phase2d2-manual-open.ppm"
		set manual_open_command {before=$(cat /tmp/seyrix-phase2d2-manual-map-baseline); after=$(grep -c 'Layer shell surface mapped namespace=seyrix-manual' /tmp/seyrix-compositor.log || true); if [[ "$after" -gt "$before" ]] && test -s /usr/share/seyrix/Manual.txt && grep -q '^SEYRIX-LINUX OPTIONAL SOFTWARE' /usr/share/seyrix/Manual.txt; then echo PHASE2D2_MANUAL_OPEN=passed; else echo PHASE2D2_MANUAL_OPEN=failed; fi}
		run_serial_check $manual_open_command {PHASE2D2_MANUAL_OPEN=passed} {PHASE2D2_MANUAL_OPEN=failed} "open the installed Manual.txt from the desktop item" 15
		qmp_key_chord $qmp {} esc
		after 300
		qmp_hmp $qmp "screendump $run_dir/phase2d2-desktop-after-manual.ppm"

		qmp_key_chord $qmp {meta_l} ret
		set first_terminal_command {for n in $(seq 1 60); do terminal_pid=$(pgrep -u 1000 -x weston-terminal | head -n 1); count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -eq 1 && -n "$terminal_pid" ]] && grep -Fq "Window mapped: pid=$terminal_pid " /tmp/seyrix-compositor.log && grep -Fq "Window focused: pid=$terminal_pid " /tmp/seyrix-compositor.log; then break; fi; sleep 0.2; done; if [[ "$count" -eq 1 && -n "$terminal_pid" ]] && grep -Fq "Window mapped: pid=$terminal_pid " /tmp/seyrix-compositor.log && grep -Fq "Window focused: pid=$terminal_pid " /tmp/seyrix-compositor.log; then echo PHASE2D2_TERMINAL_RESTORED=passed; else echo PHASE2D2_TERMINAL_RESTORED=failed; pgrep -a -u 1000 -x weston-terminal || true; grep -E "Window mapped:|Window focused:" /tmp/seyrix-compositor.log | tail -n 10; fi}
		run_serial_check $first_terminal_command {PHASE2D2_TERMINAL_RESTORED=passed} {PHASE2D2_TERMINAL_RESTORED=failed} "open an unprivileged terminal after desktop input checks" 20
		after 500
		set first_terminal_directory_command {install -d -m 700 /home/seyrix/.seyrix-first && test -d /home/seyrix/.seyrix-first && echo PHASE2D2_FIRST_TERMINAL_DIRECTORY=ready}
		run_serial_check $first_terminal_directory_command {PHASE2D2_FIRST_TERMINAL_DIRECTORY=ready} {PHASE2D2_FIRST_TERMINAL_DIRECTORY=failed} "prepare the first terminal working directory" 10
		qmp_type_slow $qmp "cd /home/seyrix/.seyrix-first;\n" 500
		after 1500
		qmp_type_slow $qmp "touch .seyrix-cwd-verified;\n" 500
		set first_terminal_identity_command {ready=0; for n in $(seq 1 60); do if test -f /home/seyrix/.seyrix-first/.seyrix-cwd-verified; then ready=1; break; fi; sleep 0.25; done; if [[ "$ready" -eq 1 ]]; then echo PHASE2D2_FIRST_TERMINAL_IDENTITY=passed; else echo PHASE2D2_FIRST_TERMINAL_IDENTITY=failed; ls -la /home/seyrix/.seyrix-first; fi}
		run_serial_check $first_terminal_identity_command {PHASE2D2_FIRST_TERMINAL_IDENTITY=passed} {PHASE2D2_FIRST_TERMINAL_IDENTITY=failed} "mark the first terminal's private working directory" 30
		qmp_hmp $qmp "screendump $run_dir/phase2d2-terminal-first-window.ppm"
		set background_marker_reset_command {rm -f /tmp/seyrix-bg; echo PHASE2D2_BACKGROUND_MARKER_RESET=ready}
		run_serial_check $background_marker_reset_command {PHASE2D2_BACKGROUND_MARKER_RESET=ready} {PHASE2D2_BACKGROUND_MARKER_RESET=failed} "clear background-input marker before pointer test" 10
		qmp_mouse_click_pixel $qmp 4 120 $output_width $output_height
		qmp_hmp $qmp "screendump $run_dir/phase2d2-background-click.ppm"
		qmp_type_slow $qmp "touch /tmp/seyrix-bg\n" 500
		after 1000
		set background_focus_command {ready=0; for n in $(seq 1 120); do if test -f /tmp/seyrix-bg; then ready=1; break; fi; sleep 0.25; done; if [[ "$ready" -eq 1 ]]; then echo PHASE2D2_BACKGROUND_FOCUS=passed; else echo PHASE2D2_BACKGROUND_FOCUS=failed; grep -E 'Pointer button press|Window focused:' /tmp/seyrix-compositor.log | tail -n 8; fi}
		run_serial_check $background_focus_command {PHASE2D2_BACKGROUND_FOCUS=passed} {PHASE2D2_BACKGROUND_FOCUS=failed} "click exposed wallpaper beside the tiled window without losing its keyboard focus" 45

		set launcher_window_map_baseline_command {grep -c 'Window mapped:' /tmp/seyrix-compositor.log > /tmp/seyrix-phase2d2-launcher-window-map-baseline || true; echo PHASE2D2_LAUNCHER_WINDOW_BASELINE=ready}
		run_serial_check $launcher_window_map_baseline_command {PHASE2D2_LAUNCHER_WINDOW_BASELINE=ready} {PHASE2D2_LAUNCHER_WINDOW_BASELINE=failed} "record mapped-window baseline before valid launcher execution" 10
		qmp_key_chord $qmp {meta_l} spc
		after 600
		qmp_hmp $qmp "screendump $run_dir/phase2d2-launcher-empty.ppm"
		qmp_type $qmp "Acceptance"
		after 600
		qmp_hmp $qmp "screendump $run_dir/phase2d2-launcher-search.ppm"
		qmp_key_chord $qmp {} down
		qmp_key_chord $qmp {} ret
		set launcher_launch_command {before=$(cat /tmp/seyrix-phase2d2-launcher-window-map-baseline); for n in $(seq 1 20); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); if [[ "$count" -eq 2 && "$mapped" -gt "$before" ]]; then break; fi; sleep 1; done; count=$(pgrep -u 1000 -x weston-terminal | wc -l); mapped=$(grep -c 'Window mapped:' /tmp/seyrix-compositor.log || true); shell_pid=$(pgrep -u 1000 -x seyrix-shell | head -n 1); shell_uid=$(test -n "$shell_pid" && awk '/^Uid:/ {print $2}' "/proc/$shell_pid/status"); printf 'PHASE2D2_TERMINAL_COUNT=%s\nPHASE2D2_MAPPED_BEFORE=%s\nPHASE2D2_MAPPED_AFTER=%s\n' "$count" "$before" "$mapped"; if [[ "$count" -eq 2 && "$mapped" -gt "$before" && "$shell_uid" == 1000 ]] && grep -q 'Layer shell surface mapped namespace=seyrix-launcher' /tmp/seyrix-compositor.log; then echo PHASE2D2_LAUNCHER_SEARCH_LAUNCH=passed; else echo PHASE2D2_LAUNCHER_SEARCH_LAUNCH=failed; pgrep -a -u 1000 -x weston-terminal || true; tail -n 40 /tmp/seyrix-compositor.log; fi}
		run_serial_check $launcher_launch_command {PHASE2D2_LAUNCHER_SEARCH_LAUNCH=passed} {PHASE2D2_LAUNCHER_SEARCH_LAUNCH=failed} "search and launch a valid XDG desktop entry with keyboard navigation" 30
		qmp_hmp $qmp "screendump $run_dir/phase2d2-after-launch.ppm"
		if {$phase2d3b} {
			qmp_key_chord $qmp {meta_l} spc
			after 700
			qmp_type_slow $qmp "Settings" 400
			after 1200
			qmp_hmp $qmp "screendump $run_dir/phase2d3b-launcher-search.ppm"
			qmp_key_chord $qmp {} ret
			after 1800
			qmp_hmp $qmp "screendump $run_dir/phase2d3b-settings-after-launch.ppm"
			set settings_launcher_command {ready=0; pid=; uid=; for n in $(seq 1 120); do pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); if [[ -n "$pid" ]]; then uid=$(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true); if [[ "$uid" == 1000 ]] && grep -Fq "Window mapped: pid=$pid " /tmp/seyrix-compositor.log && grep -Fq "Window focused: pid=$pid " /tmp/seyrix-compositor.log; then ready=1; break; fi; fi; sleep 0.25; done; if [[ "$ready" -eq 1 ]]; then echo "SETTINGS_PID=$pid UID=$uid MAP=yes FOCUS=yes"; echo PHASE2D3B_LAUNCHER=passed; else echo PHASE2D3B_LAUNCHER=failed; pgrep -a -u 1000 -x seyrix-settings || true; fi}
			set settings_launcher_timeout 120
			if {[info exists env(SEYRIX_QEMU_SMP)] && $env(SEYRIX_QEMU_SMP) eq "1"} {
				set settings_launcher_timeout 120
			}
			run_serial_check $settings_launcher_command {PHASE2D3B_LAUNCHER=passed} {PHASE2D3B_LAUNCHER=failed} "launch and verify the focused, visible Settings xdg-toplevel from the Seyrix launcher as the unprivileged user" $settings_launcher_timeout
			if {$last_serial_check_result ne "pass"} {
				puts stderr "Settings did not pass the launcher/toplevel assertion; page screenshots were not captured."
				exit 1
			}
			set settings_geometry_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); geometry=$(grep -E "GEOMETRY_EVIDENCE event=(map|commit|state) pid=$pid " /tmp/seyrix-compositor.log | tail -n 1); output=$(grep -E 'Output .* active at [0-9]+x[0-9]+' /tmp/seyrix-compositor.log | tail -n 1); rect=$(sed -nE 's/.* x=(-?[0-9]+) y=(-?[0-9]+) width=([0-9]+) height=([0-9]+).*/\1 \2 \3 \4/p' <<< "$geometry"); read -r x y width height <<< "$rect"; output_width=$(sed -nE 's/.* active at ([0-9]+)x([0-9]+).*/\1/p' <<< "$output"); output_height=$(sed -nE 's/.* active at ([0-9]+)x([0-9]+).*/\2/p' <<< "$output"); if [[ "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ && "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ && "$output_width" =~ ^[0-9]+$ && "$output_height" =~ ^[0-9]+$ ]] && (( x >= 0 && y >= 0 && x + width <= output_width && y + height <= output_height && width >= 600 && height >= 400 )); then printf 'SETTINGS_WINDOW_GEOMETRY=%s,%s,%s,%s\n' "$x" "$y" "$width" "$height"; else echo SETTINGS_WINDOW_GEOMETRY=failed; fi}
			set settings_geometry_capture [run_serial_capture $settings_geometry_command {SETTINGS_WINDOW_GEOMETRY=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)} {SETTINGS_WINDOW_GEOMETRY=failed} "read the mapped Settings geometry for responsive navigation" 10]
			if {[lindex $settings_geometry_capture 0] ne "pass"} {
				puts stderr "Could not read the mapped Settings geometry before category navigation."
				exit 1
			}
			set settings_window_x [lindex $settings_geometry_capture 1]
			set settings_window_y [lindex $settings_geometry_capture 2]
			set settings_window_width [lindex $settings_geometry_capture 3]
			set settings_window_height [lindex $settings_geometry_capture 4]
			set settings_environment_command {
pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
manager=$(cat /run/user/1000/seyrix-settings-supervisor.pid 2>/dev/null || true)
compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1)
shell_pid=$(pgrep -u 1000 -x seyrix-shell | head -n 1)
app_env=$(tr '\0' '\n' < "/proc/$pid/environ")
shell_env=$(tr '\0' '\n' < "/proc/$shell_pid/environ")
runtime=$(printf '%s\n' "$app_env" | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n 1)
wayland=$(printf '%s\n' "$app_env" | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n 1)
session_type=$(printf '%s\n' "$app_env" | sed -n 's/^XDG_SESSION_TYPE=//p' | head -n 1)
trace=$(printf '%s\n' "$app_env" | sed -n 's/^SEYRIX_SETTINGS_RENDER_TRACE=//p' | head -n 1)
shell_runtime=$(printf '%s\n' "$shell_env" | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n 1)
shell_wayland=$(printf '%s\n' "$shell_env" | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n 1)
app_bus=$(printf '%s\n' "$app_env" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1)
shell_bus=$(printf '%s\n' "$shell_env" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1)
uid=$(awk '/^Uid:/ {print $2}' "/proc/$pid/status")
app_parent=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status")
app_sid=$(ps -o sid= -p "$pid" | tr -d ' ')
manager_sid=$(ps -o sid= -p "$manager" | tr -d ' ')
compositor_sid=$(ps -o sid= -p "$compositor_pid" | tr -d ' ')
runtime_mode=$(stat -c '%u:%g:%a' "$runtime")
wayland_socket="$runtime/$wayland"
wayland_socket_owner=$(stat -c '%u:%g' "$wayland_socket" 2>/dev/null || true)
wayland_socket_mode=$(stat -c '%a' "$wayland_socket" 2>/dev/null || true)
wayland_mode_safe=no
if [[ "$wayland_socket_mode" =~ ^[0-7]{3,4}$ ]] && (( (8#$wayland_socket_mode & 022) == 0 )); then wayland_mode_safe=yes; fi
supervisor_socket=/run/user/1000/seyrix-settings-supervisor.sock
settings_socket=/run/user/1000/seyrix/settings-v1.sock
entry=/usr/share/applications/seyrix-settings.desktop
entry_mode=$(stat -c '%U:%G:%a' "$entry")
binary_mode=$(stat -c '%U:%G:%a' /usr/bin/seyrix-settings)
manager_exe=$(readlink -f "/proc/$manager/exe")
manager_mode=$(stat -c '%U:%G:%a' /usr/bin/seyrix-session-supervisor)
printf 'SETTINGS_LAUNCH_IDENTITY pid=%s uid=%s parent=%s manager=%s manager_exe=%s manager_sid=%s sid=%s compositor_sid=%s runtime=%s runtime_mode=%s wayland=%s shell_wayland=%s session_type=%s trace=%s app_bus=%s shell_bus=%s wayland_owner=%s wayland_mode=%s settings_socket=%s supervisor_socket=%s entry_mode=%s binary_mode=%s manager_mode=%s\n' \
  "$pid" "$uid" "$app_parent" "$manager" "$manager_exe" "$manager_sid" "$app_sid" "$compositor_sid" "$runtime" "$runtime_mode" "$wayland" "$shell_wayland" "$session_type" "$trace" "${app_bus:-unset}" "${shell_bus:-unset}" "$wayland_socket_owner" "$wayland_socket_mode" "$(stat -c '%u:%g:%a' "$settings_socket" 2>/dev/null || echo missing)" "$(stat -c '%u:%g:%a' "$supervisor_socket" 2>/dev/null || echo missing)" "$entry_mode" "$binary_mode" "$manager_mode"
if [[ "$(pgrep -u 1000 -x seyrix-settings | wc -l)" == 1 && "$uid" == 1000 && "$app_parent" == "$manager" && "$manager_exe" == /usr/bin/seyrix-session-supervisor && "$manager_sid" == "$compositor_sid" && "$app_sid" == "$compositor_sid" && "$runtime" == "$shell_runtime" && "$wayland" == "$shell_wayland" && "$runtime_mode" == 1000:1000:700 && "$wayland_socket_owner" == 1000:1000 && "$wayland_mode_safe" == yes && "$session_type" == wayland && "$trace" == 1 && "$entry_mode" == root:root:644 && "$binary_mode" == root:root:755 && "$manager_mode" == root:root:755 && "$(stat -c '%u:%g:%a' "$settings_socket" 2>/dev/null)" == 1000:1000:600 && "$(stat -c '%u:%g:%a' "$supervisor_socket" 2>/dev/null)" == 1000:1000:600 ]] && grep -Fxq 'Exec=seyrix-settings-launch' "$entry" && grep -Fxq 'TryExec=seyrix-settings-launch' "$entry"; then echo SETTINGS_LAUNCH_IDENTITY=passed; else echo SETTINGS_LAUNCH_IDENTITY=failed; fi
}
			run_serial_check $settings_environment_command {SETTINGS_LAUNCH_IDENTITY=passed} {SETTINGS_LAUNCH_IDENTITY=failed} "verify the supervised production launcher, process ownership, session environment, and Wayland permissions" 15
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The Settings process does not match the active unprivileged Wayland session."
				exit 1
			}
			set settings_dbus_diagnostic_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); app_env=$(tr '\0' '\n' < "/proc/$pid/environ"); dbus_address=$(printf '%s\n' "$app_env" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1); bus_socket=$(stat -c '%F:%u:%g:%a' /run/user/1000/bus 2>/dev/null || echo missing); if [[ -n "$dbus_address" ]]; then owner=$(timeout 3s env XDG_RUNTIME_DIR=/run/user/1000 DBUS_SESSION_BUS_ADDRESS="$dbus_address" busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus NameHasOwner s org.seyrix.settings 2>/dev/null || echo unavailable); else owner=$(timeout 3s env XDG_RUNTIME_DIR=/run/user/1000 busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus NameHasOwner s org.seyrix.settings 2>/dev/null || echo unavailable); fi; printf 'SETTINGS_DBUS address=%s socket=%s name_owner=%s\n' "${dbus_address:-unset}" "$bus_socket" "$owner"; echo SETTINGS_DBUS_DIAGNOSTIC=recorded}
			run_serial_check $settings_dbus_diagnostic_command {SETTINGS_DBUS_DIAGNOSTIC=recorded} {SETTINGS_DBUS_DIAGNOSTIC=failed} "record the Settings session-bus and unique application-name state" 10
			set settings_single_instance_baseline {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); maps=$(grep -F "Window mapped: pid=$pid " /tmp/seyrix-compositor.log | grep -Fc 'app_id=org.seyrix.settings title=System Settings' || true); echo "$pid $maps" > /tmp/seyrix-settings-single-instance-before; echo SETTINGS_SINGLE_INSTANCE_BASELINE=ready}
			run_serial_check $settings_single_instance_baseline {SETTINGS_SINGLE_INSTANCE_BASELINE=ready} {SETTINGS_SINGLE_INSTANCE_BASELINE=failed} "record the Settings process before a second normal launcher activation" 10
			qmp_key_chord $qmp {meta_l} spc
			after 600
			qmp_type_slow $qmp "Settings" 400
			after 600
			qmp_key_chord $qmp {} ret
			after 1500
			set settings_single_instance_command {
read -r before_pid before_maps < /tmp/seyrix-settings-single-instance-before
stable=0
duplicate_window=0
for attempt in $(seq 1 120); do
	pids=$(pgrep -u 1000 -x seyrix-settings || true)
	count=$(printf '%s\n' "$pids" | sed '/^$/d' | wc -l)
	pid=$(printf '%s\n' "$pids" | head -n 1)
	maps=$(grep -F 'Window mapped:' /tmp/seyrix-compositor.log | grep -Fc 'app_id=org.seyrix.settings title=System Settings' || true)
	if [[ "$maps" -gt "$before_maps" ]]; then duplicate_window=1; break; fi
	if [[ "$count" == 1 && "$pid" == "$before_pid" && "$maps" == "$before_maps" ]]; then stable=$((stable + 1)); else stable=0; fi
	if [[ "$stable" -ge 5 ]]; then break; fi
	sleep 1
done
printf 'SETTINGS_SINGLE_INSTANCE_BEFORE=%s AFTER=%s COUNT=%s MAPS_BEFORE=%s MAPS_AFTER=%s STABLE_SECONDS=%s DUPLICATE_WINDOW=%s\n' "$before_pid" "$pid" "$count" "$before_maps" "$maps" "$stable" "$duplicate_window"
if [[ "$stable" -ge 5 && "$duplicate_window" == 0 ]]; then echo SETTINGS_SINGLE_INSTANCE=passed; else
echo SETTINGS_SINGLE_INSTANCE=failed
ps -o pid,ppid,sid,stat,etimes,comm,args -p $(printf '%s ' "$pids") 2>/dev/null || true
for app_pid in $pids; do
	app_env=$(tr '\0' '\n' < "/proc/$app_pid/environ")
	app_bus=$(printf '%s\n' "$app_env" | sed -n 's/^DBUS_SESSION_BUS_ADDRESS=//p' | head -n 1)
	app_runtime=$(printf '%s\n' "$app_env" | sed -n 's/^XDG_RUNTIME_DIR=//p' | head -n 1)
	app_wayland=$(printf '%s\n' "$app_env" | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n 1)
	app_sid=$(ps -o sid= -p "$app_pid" | tr -d ' ')
	if [[ -n "$app_bus" ]]; then bus_owner=$(timeout 3s env XDG_RUNTIME_DIR="$app_runtime" DBUS_SESSION_BUS_ADDRESS="$app_bus" busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus GetConnectionUnixProcessID s org.seyrix.settings 2>/dev/null || echo unavailable); else bus_owner=$(timeout 3s env XDG_RUNTIME_DIR="$app_runtime" busctl --user call org.freedesktop.DBus /org/freedesktop/DBus org.freedesktop.DBus GetConnectionUnixProcessID s org.seyrix.settings 2>/dev/null || echo unavailable); fi
	printf 'SETTINGS_INSTANCE_PROCESS pid=%s sid=%s runtime=%s wayland=%s bus=%s bus_owner_pid=%s\n' "$app_pid" "$app_sid" "${app_runtime:-unset}" "${app_wayland:-unset}" "${app_bus:-unset}" "$bus_owner"
done
grep -E 'Window mapped:.*app_id=org\.seyrix\.settings' /tmp/seyrix-compositor.log | tail -n 5 || true
fi
}
			run_serial_check $settings_single_instance_command {SETTINGS_SINGLE_INSTANCE=passed} {SETTINGS_SINGLE_INSTANCE=failed} "activate Settings a second time from the Seyrix Shell launcher without creating a duplicate window or process" 135
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The normal launcher created a duplicate Settings instance or window."
				exit 1
			}
			set supervisor_wrong_sid_command {
before_pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); before_count=$(pgrep -u 1000 -x seyrix-settings | wc -l); manager=$(cat /run/user/1000/seyrix-settings-supervisor.pid 2>/dev/null || true); manager_start=$(awk '{print $22}' "/proc/$manager/stat" 2>/dev/null || true); manager_sid=$(ps -o sid= -p "$manager" 2>/dev/null | tr -d ' '); request_log=/tmp/seyrix-settings-wrong-sid.log; request_status=0; env HOME=/home/seyrix XDG_RUNTIME_DIR=/run/user/1000 setsid --wait /bin/bash -c 'uid=$(id -u); sid=$(ps -o sid= -p "$$" | tr -d " "); manager=$(cat /run/user/1000/seyrix-settings-supervisor.pid); manager_sid=$(ps -o sid= -p "$manager" | tr -d " "); printf "SETTINGS_SUPERVISOR_WRONG_SID_PEER uid=%s sid=%s manager_sid=%s\n" "$uid" "$sid" "$manager_sid"; exec /usr/bin/seyrix-session-supervisor --open' >"$request_log" 2>&1 || request_status=$?; after_pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); after_count=$(pgrep -u 1000 -x seyrix-settings | wc -l); manager_after=$(cat /run/user/1000/seyrix-settings-supervisor.pid 2>/dev/null || true); manager_start_after=$(awk '{print $22}' "/proc/$manager_after/stat" 2>/dev/null || true); cat "$request_log"; printf 'SETTINGS_SUPERVISOR_WRONG_SID status=%s before_pid=%s after_pid=%s before_count=%s after_count=%s manager=%s/%s manager_start=%s/%s manager_sid=%s\n' "$request_status" "${before_pid:-missing}" "${after_pid:-missing}" "$before_count" "$after_count" "${manager:-missing}" "${manager_after:-missing}" "${manager_start:-missing}" "${manager_start_after:-missing}" "${manager_sid:-missing}"; peer=$(sed -nE 's/^SETTINGS_SUPERVISOR_WRONG_SID_PEER uid=([0-9]+) sid=([0-9]+) manager_sid=([0-9]+)$/\1 \2 \3/p' "$request_log"); read -r peer_uid peer_sid peer_manager_sid <<< "$peer"; if [[ "$peer_uid" == 1000 && "$peer_sid" =~ ^[0-9]+$ && "$peer_manager_sid" == "$manager_sid" && "$peer_sid" != "$manager_sid" && "$request_status" -ne 0 && "$before_pid" == "$after_pid" && "$before_count" == 1 && "$after_count" == 1 && "$manager" == "$manager_after" && "$manager_start" == "$manager_start_after" ]]; then echo SETTINGS_SUPERVISOR_WRONG_SID=passed; else echo SETTINGS_SUPERVISOR_WRONG_SID=failed; fi
}
			run_serial_check $supervisor_wrong_sid_command {SETTINGS_SUPERVISOR_WRONG_SID=passed} {SETTINGS_SUPERVISOR_WRONG_SID=failed} "deny Settings launch control from same-UID peer in a different session" 15
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The Settings supervisor accepted or mishandled launch control from another session."
				exit 1
			}
			after 1000
			qmp_hmp $qmp "screendump $run_dir/phase2d3b-appearance.ppm"
		# Launch probes through the shell so SO_PEERCRED's session check sees the
		# compositor session. A terminal's shell runs under a separate PTY session.
		set settings_probe_launch_command {rm -f /tmp/seyrix-settings-endpoint-probe.log; echo SETTINGS_PROBE_LOG=cleared; ps -eo pid,ppid,sid,pgid,uid,comm,args | awk 'NR == 1 || /seyrix-compositor|seyrix-shell|seyrix-settings/ { print }'}
		run_serial_check $settings_probe_launch_command {SETTINGS_PROBE_LOG=cleared} {SETTINGS_PROBE_LOG=failed} "clear read-only endpoint probe result" 10
		qmp_key_chord $qmp {meta_l} spc
		after 300
		qmp_type_slow $qmp "Seyrix IPC Read Probe"
		after 1500
		qmp_key_chord $qmp {} ret
		set settings_probe_command {ready=0; for n in $(seq 1 80); do if grep -q '^SETTINGS_ENDPOINT_PROBE=passed$' /tmp/seyrix-settings-endpoint-probe.log 2>/dev/null; then ready=1; break; fi; if grep -q '^SETTINGS_ENDPOINT_PROBE=failed$' /tmp/seyrix-settings-endpoint-probe.log 2>/dev/null; then break; fi; sleep 0.25; done; if [[ "$ready" -eq 1 ]]; then cat /tmp/seyrix-settings-endpoint-probe.log; echo SETTINGS_ENDPOINT_PROBE_STAGE=passed; else cat /tmp/seyrix-settings-endpoint-probe.log 2>/dev/null || true; echo SETTINGS_ENDPOINT_PROBE_STAGE=failed; fi; grep 'Settings endpoint' /tmp/seyrix-compositor.log | tail -n 40 || true}
		run_serial_check $settings_probe_command {SETTINGS_ENDPOINT_PROBE_STAGE=passed} {SETTINGS_ENDPOINT_PROBE_STAGE=failed} "verify authenticated read-only Settings IPC, snapshots, bounds, revisions, subscriptions, and reconnect" 30
		if {$last_serial_check_result ne "pass"} { exit 1 }
		qmp_key_chord $qmp {meta_l} spc
		after 300
		qmp_type_slow $qmp "Seyrix IPC FD Stability" 500
		after 1800
		qmp_key_chord $qmp {} ret
		set settings_fd_recovery_command {ready=0; for n in $(seq 1 240); do if grep -Fxq 'SETTINGS_ENDPOINT_FD_STABILITY=passed cycles=10' /tmp/seyrix-settings-endpoint-fd-stability.log 2>/dev/null; then ready=1; break; fi; if grep -Fxq 'SETTINGS_ENDPOINT_FD_STABILITY=failed' /tmp/seyrix-settings-endpoint-fd-stability.log 2>/dev/null; then break; fi; sleep 0.5; done; cat /tmp/seyrix-settings-endpoint-fd-stability.log 2>/dev/null || true; if [[ "$ready" == 1 ]]; then echo SETTINGS_ENDPOINT_FD_STABILITY_STAGE=passed; else echo SETTINGS_ENDPOINT_FD_STABILITY_STAGE=failed; fi}
		run_serial_check $settings_fd_recovery_command {SETTINGS_ENDPOINT_FD_STABILITY_STAGE=passed} {SETTINGS_ENDPOINT_FD_STABILITY_STAGE=failed} "repeat authenticated Settings endpoint connections from the compositor session and require exact server FD baseline after every cycle" 150
		if {$last_serial_check_result ne "pass"} { exit 1 }
			set wrong_session_command {setsid env XDG_RUNTIME_DIR=/run/user/1000 /usr/lib/seyrix-tests/settings-endpoint-probe --wrong-session; result=$?; if [[ "$result" -eq 0 ]]; then echo SETTINGS_ENDPOINT_WRONG_SESSION_STAGE=passed; else echo SETTINGS_ENDPOINT_WRONG_SESSION_STAGE=failed; fi}
			run_serial_check $wrong_session_command {SETTINGS_ENDPOINT_WRONG_SESSION_STAGE=passed} {SETTINGS_ENDPOINT_WRONG_SESSION_STAGE=failed} "reject a same-uid client from a different session" 10
		set subscription_log_reset_command {rm -f /tmp/seyrix-settings-subscription.log; echo SETTINGS_SUBSCRIPTION_LOG=cleared}
		run_serial_check $subscription_log_reset_command {SETTINGS_SUBSCRIPTION_LOG=cleared} {SETTINGS_SUBSCRIPTION_LOG=failed} "clear subscription probe result" 10
		qmp_key_chord $qmp {meta_l} spc
		after 300
		qmp_type_slow $qmp "Seyrix IPC Change Watch" 500
		after 1800
		qmp_key_chord $qmp {} ret
		set subscription_ready_command {ready=0; for n in $(seq 1 80); do if grep -q '^SETTINGS_ENDPOINT_SUBSCRIPTION_READY=passed$' /tmp/seyrix-settings-subscription.log 2>/dev/null; then ready=1; break; fi; if grep -q '^SETTINGS_ENDPOINT_SUBSCRIPTION_DETAIL=' /tmp/seyrix-settings-subscription.log 2>/dev/null; then break; fi; sleep 0.25; done; if [[ "$ready" -eq 1 ]]; then cat /tmp/seyrix-settings-subscription.log; echo SETTINGS_ENDPOINT_SUBSCRIPTION_READY_STAGE=passed; else cat /tmp/seyrix-settings-subscription.log 2>/dev/null || true; echo SETTINGS_ENDPOINT_SUBSCRIPTION_READY_STAGE=failed; fi}
		run_serial_check $subscription_ready_command {SETTINGS_ENDPOINT_SUBSCRIPTION_READY_STAGE=passed} {SETTINGS_ENDPOINT_SUBSCRIPTION_READY_STAGE=failed} "verify the bounded subscription is active before changing state" 45
		qmp_key_chord $qmp {meta_l} 2
		set subscription_change_command {ready=0; for n in $(seq 1 140); do if grep -q '^SETTINGS_ENDPOINT_SUBSCRIPTION_CHANGE=passed$' /tmp/seyrix-settings-subscription.log 2>/dev/null; then ready=1; break; fi; if grep -q '^SETTINGS_ENDPOINT_SUBSCRIPTION_CHANGE=failed$' /tmp/seyrix-settings-subscription.log 2>/dev/null; then break; fi; sleep 0.2; done; if [[ "$ready" -eq 1 ]]; then cat /tmp/seyrix-settings-subscription.log; echo SETTINGS_ENDPOINT_SUBSCRIPTION_STAGE=passed; else cat /tmp/seyrix-settings-subscription.log 2>/dev/null || true; echo SETTINGS_ENDPOINT_SUBSCRIPTION_STAGE=failed; fi}
		run_serial_check $subscription_change_command {SETTINGS_ENDPOINT_SUBSCRIPTION_STAGE=passed} {SETTINGS_ENDPOINT_SUBSCRIPTION_STAGE=failed} "deliver a bounded read-only subscription revision notification" 45
		qmp_key_chord $qmp {meta_l} 1
		after 500
		set settings_config_snapshot_command {root=/home/seyrix/.config; manifest=/tmp/seyrix-settings-config-before; : > "$manifest"; if [[ -d "$root" ]]; then find "$root" -printf '%y %m %u:%g %p\n' | LC_ALL=C sort > "$manifest"; find "$root" -type f -print0 | LC_ALL=C sort -z | xargs -0r sha256sum >> "$manifest"; fi; echo SETTINGS_CONFIG_BASELINE=ready}
		run_serial_check $settings_config_snapshot_command {SETTINGS_CONFIG_BASELINE=ready} {SETTINGS_CONFIG_BASELINE=failed} "record user configuration before Settings interaction" 10
		if {$last_serial_check_result ne "pass"} {
			puts stderr "Could not record the configuration baseline for the Settings read-only check."
			exit 1
		}
			puts "STAGE_BEGIN name={Settings category, search, and responsive layout} timeout_s=300"
			qmp_key_chord $qmp {ctrl} f
			qmp_type_slow $qmp "system information"
			after 400
			qmp_hmp $qmp "screendump $run_dir/phase2d3b-search.ppm"
			qmp_key_chord $qmp {ctrl} a
			qmp_type_slow $qmp "no-such-setting-zz99"
			after 400
			qmp_hmp $qmp "screendump $run_dir/phase2d3b-search-no-match.ppm"
			# Ctrl+F and the query input leave focus in GtkSearchEntry. Clear it with
			# the standard text-editing sequence instead of guessing the clear icon's
