		qmp_hmp $qmp "screendump $run_dir/phase2d2-launcher-missing-entry.ppm"
		qmp_key_chord $qmp {} ret
		qmp_key_chord $qmp {} esc
		set missing_entry_command {count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -eq 2 ]] && ! pgrep -u 1000 -f 'seyrix-missing-app' >/dev/null && pgrep -u 1000 -x seyrix-shell >/dev/null; then echo PHASE2D2_LAUNCHER_MISSING_ENTRY=passed; else echo PHASE2D2_LAUNCHER_MISSING_ENTRY=failed; fi}
		run_serial_check $missing_entry_command {PHASE2D2_LAUNCHER_MISSING_ENTRY=passed} {PHASE2D2_LAUNCHER_MISSING_ENTRY=failed} "reject a launcher entry whose TryExec target is missing" 20
		set launcher_escape_map_baseline_command {grep -c 'Layer shell surface mapped namespace=seyrix-launcher' /tmp/seyrix-compositor.log > /tmp/seyrix-phase2d2-launcher-escape-map-baseline || true; echo PHASE2D2_LAUNCHER_ESCAPE_BASELINE=ready}
		run_serial_check $launcher_escape_map_baseline_command {PHASE2D2_LAUNCHER_ESCAPE_BASELINE=ready} {PHASE2D2_LAUNCHER_ESCAPE_BASELINE=failed} "record launcher map count before Escape input" 10
		qmp_key_chord $qmp {meta_l} spc
		set launcher_escape_map_wait_command {before=$(cat /tmp/seyrix-phase2d2-launcher-escape-map-baseline); ready=0; for n in $(seq 1 40); do after=$(grep -c 'Layer shell surface mapped namespace=seyrix-launcher' /tmp/seyrix-compositor.log || true); if [[ "$after" -gt "$before" ]]; then ready=1; break; fi; sleep 0.1; done; printf 'PHASE2D2_LAUNCHER_ESCAPE_MAPS before=%s after=%s ready=%s\n' "$before" "$after" "$ready"; if [[ "$ready" -eq 1 ]]; then echo PHASE2D2_LAUNCHER_ESCAPE_MAP=passed; else echo PHASE2D2_LAUNCHER_ESCAPE_MAP=failed; fi}
		run_serial_check $launcher_escape_map_wait_command {PHASE2D2_LAUNCHER_ESCAPE_MAP=passed} {PHASE2D2_LAUNCHER_ESCAPE_MAP=failed} "wait for the launcher to map before Escape input" 10
