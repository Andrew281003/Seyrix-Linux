			set recovery_click_x [expr {round([lindex $target_recovery_bounds 1] + [lindex $target_recovery_bounds 3] + [lindex $target_recovery_bounds 5] / 2.0)}]
			set recovery_click_y [expr {round([lindex $target_recovery_bounds 2] + [lindex $target_recovery_bounds 4] + [lindex $target_recovery_bounds 6] / 2.0)}]
