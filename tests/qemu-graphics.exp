			set target_recovery_bounds [run_serial_capture $target_recovery_bounds_command {SETTINGS_RECOVERY_INPUT_TARGET=(-?[0-9]+) (-?[0-9]+) ([-0-9.]+) ([-0-9.]+) ([0-9.]+) ([0-9.]+) compact=([01])} {SETTINGS_RECOVERY_INPUT_TARGET=missing} "resolve live Settings category coordinates for state restoration" 15]
