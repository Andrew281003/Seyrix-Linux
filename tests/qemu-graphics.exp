			set settings_closed_command {for n in $(seq 1 20); do if ! pgrep -u 1000 -x seyrix-settings >/dev/null; then break; fi; sleep 0.1; done; if ! pgrep -u 1000 -x seyrix-settings >/dev/null; then echo PHASE2D3B_WINDOW_CLOSED=passed; else echo PHASE2D3B_WINDOW_CLOSED=failed; fi}
			run_serial_check $settings_closed_command {PHASE2D3B_WINDOW_CLOSED=passed} {PHASE2D3B_WINDOW_CLOSED=failed} "close Settings before compositor shell regression checks" 10
			set settings_config_compare_command {root=/home/seyrix/.config; manifest=/tmp/seyrix-settings-config-after; : > "$manifest"; if [[ -d "$root" ]]; then find "$root" -printf '%y %m %u:%g %p\n' | LC_ALL=C sort > "$manifest"; find "$root" -type f -print0 | LC_ALL=C sort -z | xargs -0r sha256sum >> "$manifest"; fi; if cmp -s /tmp/seyrix-settings-config-before "$manifest"; then echo SETTINGS_CONFIG_READ_ONLY=passed; else echo SETTINGS_CONFIG_READ_ONLY=failed; diff -u /tmp/seyrix-settings-config-before "$manifest" || true; fi}
			run_serial_check $settings_config_compare_command {SETTINGS_CONFIG_READ_ONLY=passed} {SETTINGS_CONFIG_READ_ONLY=failed} "verify Settings interaction wrote no user configuration" 10
			if {$last_serial_check_result ne "pass"} {
				puts stderr "Settings interaction changed files under the user's configuration directory."
				exit 1
			}
			for {set reopen_cycle 1} {$reopen_cycle <= 3} {incr reopen_cycle} {
				qmp_key_chord $qmp {meta_l} spc
				after 500
				qmp_type_slow $qmp "Settings"
				after 250
				qmp_key_chord $qmp {} ret
