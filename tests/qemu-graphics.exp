				set appearance_y [expr {round($trace_window_y + [lindex $appearance_bounds 2] + [lindex $appearance_bounds 4] / 2.0)}]
				qmp_mouse_click_pixel $qmp $appearance_x $appearance_y $output_width $output_height
				after 1000
