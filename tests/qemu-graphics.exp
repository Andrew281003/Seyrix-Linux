			set target_user_close_baseline_command {bash /tmp/seyrix-qemu-guest-helper.sh settings-recovery-baseline}
			run_serial_check $target_user_close_baseline_command {SETTINGS_SUPERVISOR_BASELINE=passed} {QEMU_GUEST_HELPER=failed reason=[^\r\n]*} "record state before intentional Settings closure" 45
			qmp_key_chord $qmp {meta_l} q
			set target_user_close_command {bash /tmp/seyrix-qemu-guest-helper.sh settings-user-close-verify}
			run_serial_check $target_user_close_command {SETTINGS_USER_CLOSE_NO_REOPEN=passed} {SETTINGS_USER_CLOSE_NO_REOPEN=failed|QEMU_GUEST_HELPER=failed reason=[^\r\n]*} "verify intentional Settings closure disables automatic relaunch through the maximum backoff" 40
			if {$last_serial_check_result ne "pass"} { exit 1 }
