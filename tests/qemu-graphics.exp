				if {$last_serial_check_result ne "pass"} {
					puts stderr "Settings failed to close during lifecycle cycle $reopen_cycle."
					exit 1
				}
			}
			qmp_mouse_click_pixel $qmp 450 100 $output_width $output_height
			after 300
		}
		set launcher_cwd_reset_command {rm -f /tmp/seyrix-phase2d2-launcher-terminal-cwd; echo PHASE2D2_LAUNCHER_CWD_RESET=ready}
		run_serial_check $launcher_cwd_reset_command {PHASE2D2_LAUNCHER_CWD_RESET=ready} {PHASE2D2_LAUNCHER_CWD_RESET=failed} "clear foreground identity marker after launcher app launch" 10
		qmp_type $qmp "pwd > /tmp/seyrix-phase2d2-launcher-terminal-cwd\n"
		set launcher_window_result [run_serial_capture {ready=0; for n in $(seq 1 40); do if [[ -s /tmp/seyrix-phase2d2-launcher-terminal-cwd ]]; then ready=1; break; fi; sleep 0.25; done; if [[ "$ready" -eq 1 ]]; then printf 'PHASE2D2_LAUNCHER_TERMINAL_CWD=%s\n' "$(cat /tmp/seyrix-phase2d2-launcher-terminal-cwd)"; else echo PHASE2D2_LAUNCHER_TERMINAL_CWD=missing; fi} {PHASE2D2_LAUNCHER_TERMINAL_CWD=(/tmp/seyrix-(first|second))\r?\n} {PHASE2D2_LAUNCHER_TERMINAL_CWD=missing} "read the focused terminal after launcher execution" 15]
		if {[lindex $launcher_window_result 0] ne "pass" ||
