		qmp_key_chord $qmp {meta_l} q
		set close_initial_terminal_command {for n in $(seq 1 20); do count=$(pgrep -u 1000 -x weston-terminal | wc -l); if [[ "$count" -eq 0 ]]; then break; fi; sleep 0.2; done; if [[ "$count" -eq 0 ]] && pgrep -u 1000 -x seyrix-shell >/dev/null; then echo PHASE2D2_DESKTOP_REVEALED=passed; else echo PHASE2D2_DESKTOP_REVEALED=failed; fi}
		run_serial_check $close_initial_terminal_command {PHASE2D2_DESKTOP_REVEALED=passed} {PHASE2D2_DESKTOP_REVEALED=failed} "close the initial terminal to expose the desktop surface" 15
		qmp_hmp $qmp "screendump $run_dir/phase2d2-wallpaper-and-desktop-item.ppm"

		set output_size_command {size=$(sed -n 's/.* active at \([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1x\2/p' /tmp/seyrix-compositor.log | head -n 1); if [[ -n "$size" ]]; then echo "PHASE2D2_OUTPUT_SIZE=$size"; else echo PHASE2D2_OUTPUT_SIZE=unknown; fi}
		set output_size_result [run_serial_capture $output_size_command {PHASE2D2_OUTPUT_SIZE=([0-9]+)x([0-9]+)} {PHASE2D2_OUTPUT_SIZE=unknown} "read active output dimensions for pointer interaction" 10]
		if {[lindex $output_size_result 0] ne "pass"} {
			puts stderr "Could not determine the output dimensions for graphical input."
			exit 1
		}
		set output_width [lindex $output_size_result 1]
		set output_height [lindex $output_size_result 2]
		if {$requested_resolution ne ""} {
			set output_mode_command [string map [list @MODE@ $requested_resolution] {
requested=@MODE@
output_name=$(sed -n 's/.*Output \([^ ]*\) active at.*/\1/p' /tmp/seyrix-compositor.log | tail -n 1)
wayland_display=$(sed -n 's/.*WAYLAND_DISPLAY=\([^ ]*\).*/\1/p' /tmp/seyrix-compositor.log | tail -n 1)
active_size=$(sed -n 's/.* active at \([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1x\2/p' /tmp/seyrix-compositor.log | tail -n 1)
mode_applied=0
if [[ "$active_size" == "$requested" ]]; then
  mode_applied=1
elif [[ -n "$output_name" && -n "$wayland_display" ]]; then
  mode_listing=$(env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY="$wayland_display" wlr-randr 2>&1)
  printf 'PHASE2D3B_OUTPUT_MODES_BEGIN\n%s\nPHASE2D3B_OUTPUT_MODES_END\n' "$mode_listing"
  if env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY="$wayland_display" wlr-randr --dryrun --output "$output_name" --mode "$requested" --pos 0,0 --scale 1.0 &&
      env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY="$wayland_display" wlr-randr --output "$output_name" --mode "$requested" --pos 0,0 --scale 1.0; then
    for n in $(seq 1 30); do
      active_size=$(sed -n 's/.* active at \([0-9][0-9]*\)x\([0-9][0-9]*\).*/\1x\2/p' /tmp/seyrix-compositor.log | tail -n 1)
      [[ "$active_size" == "$requested" ]] && { mode_applied=1; break; }
      sleep 0.2
    done
  fi
fi
if [[ "$mode_applied" -eq 1 ]]; then
  printf 'PHASE2D3B_OUTPUT_MODE=passed requested=%s active=%s\n' "$requested" "$active_size"
else
  printf 'PHASE2D3B_OUTPUT_MODE=failed requested=%s active=%s output=%s\n' "$requested" "${active_size:-missing}" "${output_name:-missing}"
  tail -n 30 /tmp/seyrix-compositor.log
  echo PHASE2D3B_DRM_DIAGNOSTICS_BEGIN
  for drm_card in /sys/class/drm/card[0-9]*; do
    [[ -e "$drm_card/device/driver" ]] && printf 'DRM_DRIVER %s=%s\n' "${drm_card##*/}" "$(readlink -f "$drm_card/device/driver")"
    for drm_modes in "$drm_card"-*/modes; do [[ -r "$drm_modes" ]] && { echo "DRM_MODES $drm_modes"; cat "$drm_modes"; }; done
  done
  dmesg | grep -Ei 'drm|bochs|virtio|framebuffer|mode' | tail -n 80 || true
  echo PHASE2D3B_DRM_DIAGNOSTICS_END
fi
}]
			run_serial_check $output_mode_command {PHASE2D3B_OUTPUT_MODE=passed} {PHASE2D3B_OUTPUT_MODE=failed} "apply and verify the requested $requested_resolution mode before Settings navigation" 20
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The compositor rejected the requested $requested_resolution output mode."
				exit 1
			}
			set output_width [lindex [split $requested_resolution x] 0]
			set output_height [lindex [split $requested_resolution x] 1]
		}
		if {$output_width < 760} {
			set settings_window_x 0
			set settings_window_y 0
			set settings_window_width $output_width
			set settings_window_height $output_height
		} else {
			set settings_window_width [expr {min(720, $output_width)}]
			set settings_window_height [expr {min(560, $output_height)}]
			set settings_window_x [expr {($output_width - $settings_window_width) / 2}]
			set settings_window_y [expr {($output_height - $settings_window_height) / 2}]
		}
		if {$settings_render_diagnostic} {
			puts "STAGE_BEGIN name={targeted GTK Wayland surface damage and QMP presentation diagnostic} timeout_s=90"
			set render_helper [file join [file dirname [file normalize [info script]]] qemu-settings-page-check.py]
			qmp_hmp $qmp "screendump $run_dir/settings-render-desktop-baseline.ppm"
			set render_desktop_stable_count 0
			for {set render_desktop_attempt 0} {$render_desktop_attempt < 20 && $render_desktop_stable_count < 3} {incr render_desktop_attempt} {
				after 250
				qmp_hmp $qmp "screendump $run_dir/settings-render-desktop-stability.ppm"
				if {[catch {exec python3 $render_helper $run_dir/settings-render-desktop-baseline.ppm $run_dir/settings-render-desktop-stability.ppm $output_width}]} {
					incr render_desktop_stable_count
				} else {
					set render_desktop_stable_count 0
				}
				file copy -force $run_dir/settings-render-desktop-stability.ppm $run_dir/settings-render-desktop-baseline.ppm
			}
			if {$render_desktop_stable_count < 3} {
				puts "SETTINGS_RENDER_DESKTOP_BASELINE=INCOMPLETE"
				puts stderr "The desktop did not produce three stable QMP frames before Settings launch."
				exit 1
			}
			puts "SETTINGS_RENDER_DESKTOP_BASELINE=stable frames=$render_desktop_stable_count"
			set launcher_map_baseline_command {before=$(grep -cF 'Layer shell surface mapped namespace=seyrix-launcher' /tmp/seyrix-compositor.log || true); printf '%s\n' "$before" > /tmp/seyrix-settings-render-launcher-map-before; echo SETTINGS_RENDER_LAUNCHER_MAP_BASELINE=ready}
			run_serial_check $launcher_map_baseline_command {SETTINGS_RENDER_LAUNCHER_MAP_BASELINE=ready} {SETTINGS_RENDER_LAUNCHER_MAP_BASELINE=failed} "record launcher visibility baseline before pointer activation" 10
			if {$last_serial_check_result ne "pass"} { exit 1 }
			set launcher_button_x [expr {$output_width / 2 + 78}]
			set launcher_button_y [expr {$output_height - 29}]
			qmp_mouse_click_pixel $qmp $launcher_button_x $launcher_button_y $output_width $output_height
			after 700
			qmp_hmp $qmp "screendump $run_dir/settings-render-launcher-menu.ppm"
			set launcher_visibility_command {before=$(cat /tmp/seyrix-settings-render-launcher-map-before 2>/dev/null || echo invalid); ready=0; after_count=0; if [[ "$before" =~ ^[0-9]+$ ]]; then for n in $(seq 1 30); do after_count=$(grep -cF 'Layer shell surface mapped namespace=seyrix-launcher' /tmp/seyrix-compositor.log || true); if [[ "$after_count" -gt "$before" ]]; then ready=1; break; fi; sleep 0.1; done; fi; printf 'SETTINGS_RENDER_LAUNCHER_MAP_COUNTS before=%s after=%s\n' "$before" "$after_count"; if [[ "$ready" -eq 1 ]]; then echo SETTINGS_RENDER_LAUNCHER_VISIBLE=passed; else echo SETTINGS_RENDER_LAUNCHER_VISIBLE=failed; fi}
			run_serial_check $launcher_visibility_command {SETTINGS_RENDER_LAUNCHER_VISIBLE=passed} {SETTINGS_RENDER_LAUNCHER_VISIBLE=failed} "verify the pointer opened a newly mapped production launcher before selecting Settings" 10
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The production launcher did not map after the panel click; refusing to click the Settings row."
				exit 1
			}
			set launcher_card_height [expr {$output_height - 100}]
			if {$launcher_card_height > 700} { set launcher_card_height 700 }
			set launcher_card_top [expr {($output_height - $launcher_card_height) / 2}]
			set settings_entry_x [expr {$output_width / 2}]
			set settings_entry_y [expr {$launcher_card_top + 110 + 2 * 58 + 26}]
			qmp_mouse_click_pixel $qmp $settings_entry_x $settings_entry_y $output_width $output_height
			after 1800
			qmp_hmp $qmp "screendump $run_dir/settings-render-launcher-open.ppm"
			set render_trace_prior_pid_command {trace=/tmp/seyrix-compositor.log; manager=$(cat /run/user/1000/seyrix-settings-supervisor.pid 2>/dev/null || true); pid=; candidate_pid=; mapped=0; count=0; for n in $(seq 1 120); do settings_pids=$(pgrep -u 1000 -x seyrix-settings || true); count=$(awk 'NF {n++} END {print n+0}' <<< "$settings_pids"); candidate_pid=; if [[ "$count" == 1 ]]; then candidate_pid=$(head -n 1 <<< "$settings_pids"); if grep -Fq "SEYRIX_SETTINGS_SUPERVISOR event=launch pid=$candidate_pid " "$trace" && grep -Fq "Window mapped: pid=$candidate_pid " "$trace"; then pid=$candidate_pid; mapped=1; break; fi; fi; sleep 0.25; done; pid=${pid:-${candidate_pid:-}}; parent=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true); exe=$(readlink -f "/proc/$manager/exe" 2>/dev/null || true); sid=$(ps -o sid= -p "$pid" 2>/dev/null | tr -d ' '); manager_sid=$(ps -o sid= -p "$manager" 2>/dev/null | tr -d ' '); launch_marker=$(grep -F "SEYRIX_SETTINGS_SUPERVISOR event=launch pid=$pid " "$trace" | tail -n 1 || true); mapped_marker=$(grep -F "Window mapped: pid=$pid " "$trace" | tail -n 1 || true); count=$(pgrep -u 1000 -x seyrix-settings | wc -l); if [[ "$pid" =~ ^[1-9][0-9]*$ && "$manager" =~ ^[1-9][0-9]*$ && "$parent" == "$manager" && "$exe" == /usr/bin/seyrix-session-supervisor && "$sid" == "$manager_sid" && "$mapped" -eq 1 && -n "$launch_marker" && -n "$mapped_marker" && "$count" == 1 ]]; then printf '%s\n' "$pid" > /tmp/seyrix-settings-prior-pid; printf 'WAYLAND_TRACE_PRIOR_PID=ready PID=%s manager=%s parent=%s mapped=%s count=%s launch=%s mapped_marker=%s\n' "$pid" "$manager" "$parent" "$mapped" "$count" "$launch_marker" "$mapped_marker"; ps -o pid,ppid,stat,etimes,comm -p "$pid"; else echo WAYLAND_TRACE_PRIOR_PID=failed reason=not-a-single-manager-owned-mapped-process pid=${pid:-missing} manager=${manager:-missing} parent=${parent:-missing} mapped=$mapped count=$count launch=${launch_marker:-missing} mapped_marker=${mapped_marker:-missing}; ps -o pid,ppid,stat,wchan,etimes,cmd -p "$pid" 2>/dev/null || true; grep -E 'SEYRIX_SETTINGS|Settings endpoint|Window mapped|Window focused' "$trace" | tail -n 30; fi}
			run_serial_check $render_trace_prior_pid_command {WAYLAND_TRACE_PRIOR_PID=ready} {WAYLAND_TRACE_PRIOR_PID=failed} "select visible Settings result in the production launcher and verify its manager-owned process" 40
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The existing Settings process PID could not be recorded."
				exit 1
			}
			set render_trace_launch_command {trace=/tmp/seyrix-compositor.log; app_pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); manager=$(cat /run/user/1000/seyrix-settings-supervisor.pid 2>/dev/null || true); parent=$(awk '/^PPid:/ {print $2}' "/proc/$app_pid/status" 2>/dev/null || true); prior_pid=$(cat /tmp/seyrix-settings-prior-pid 2>/dev/null || true); uid=$(awk '/^Uid:/ {print $2}' "/proc/$app_pid/status" 2>/dev/null || true); exe=$(readlink -f "/proc/$app_pid/exe" 2>/dev/null || true); app_env=$(tr '\0' '\n' < "/proc/$app_pid/environ" 2>/dev/null || true); trace_env=$(printf '%s\n' "$app_env" | sed -n 's/^SEYRIX_SETTINGS_RENDER_TRACE=//p' | head -n 1); debug_env=$(printf '%s\n' "$app_env" | sed -n 's/^WAYLAND_DEBUG=//p' | head -n 1); mapped=0; for n in $(seq 1 120); do if grep -Fq "Window mapped: pid=$app_pid " "$trace" && grep -Fq "source=client-stderr pid=$app_pid " "$trace"; then mapped=1; break; fi; sleep 0.25; done; count=$(pgrep -u 1000 -x seyrix-settings | wc -l); printf 'SETTINGS_GSK_RENDERER=default\n'; if [[ "$app_pid" =~ ^[1-9][0-9]*$ && "$app_pid" == "$prior_pid" && "$uid" == 1000 && "$exe" == /usr/bin/seyrix-settings && "$parent" == "$manager" && "$trace_env" == 1 && "$debug_env" == client && "$mapped" -eq 1 && "$count" == 1 ]]; then printf '%s\n' "$app_pid" > /tmp/seyrix-settings-trace-pid; ps -o pid,ppid,stat,etimes,comm -p "$app_pid"; echo WAYLAND_TRACE_APP=ready PID=$app_pid MANAGER=$manager PARENT=$parent TRACE=$trace_env DEBUG=$debug_env DISPLAY=${WAYLAND_DISPLAY:-unknown} RUNTIME=${XDG_RUNTIME_DIR:-unknown}; else echo WAYLAND_TRACE_APP=failed PID=${app_pid:-missing} prior=${prior_pid:-missing} manager=${manager:-missing} parent=${parent:-missing} uid=${uid:-missing} trace=$trace_env debug=$debug_env mapped=$mapped count=$count; fi}
			run_serial_check $render_trace_launch_command {WAYLAND_TRACE_APP=ready} {WAYLAND_TRACE_APP=failed} "verify manager-launched Settings exposes captured GTK and Wayland client traces" 40
			if {$last_serial_check_result ne "pass"} {
				puts stderr "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=Settings-app-not-ready"
				exit 1
			}
			set trace_first_frame_command {trace=/tmp/seyrix-compositor.log; ready=0; for n in $(seq 1 120); do if awk '/wl_surface[@#][0-9]+\.attach\(/ { attached=1 } attached && /wl_surface[@#][0-9]+\.commit\(/ { ready=1 } END { exit !ready }' "$trace"; then ready=1; break; fi; sleep 0.25; done; if [[ "$ready" -eq 1 ]]; then echo WAYLAND_TRACE_FIRST_FRAME=passed; else echo WAYLAND_TRACE_FIRST_FRAME=failed; tail -n 25 "$trace" 2>/dev/null || true; fi}
			run_serial_check $trace_first_frame_command {WAYLAND_TRACE_FIRST_FRAME=passed} {WAYLAND_TRACE_FIRST_FRAME=failed} "wait for GTK to attach and commit its first visible Wayland buffer" 40
			if {$last_serial_check_result ne "pass"} {
				puts stderr "Settings did not produce a visible Wayland buffer before the category interaction."
				exit 1
			}
			after 1500
			set render_pixel_delta_observed 0
			for {set render_pixel_delta_attempt 0} {$render_pixel_delta_attempt < 80 && !$render_pixel_delta_observed} {incr render_pixel_delta_attempt} {
				after 250
				qmp_hmp $qmp "screendump $run_dir/settings-render-appearance.ppm"
				if {![catch {exec python3 $render_helper $run_dir/settings-render-desktop-baseline.ppm $run_dir/settings-render-appearance.ppm $output_width} render_visibility_result]} {
					set render_pixel_delta_observed 1
				}
			}
			if {!$render_pixel_delta_observed} {
				puts "SETTINGS_RENDER_QMP_PIXEL_DELTA=INCOMPLETE"
				puts stderr "No large page-area QMP pixel delta was observed after the first client buffer."
				exit 1
			}
			puts "SETTINGS_RENDER_QMP_PIXEL_DELTA=observed attempts=$render_pixel_delta_attempt $render_visibility_result"
			set trace_baseline_command {wc -l < /tmp/seyrix-compositor.log > /tmp/seyrix-settings-wayland-trace-baseline; printf 'WAYLAND_TRACE_BASELINE_LINES=%s\n' "$(cat /tmp/seyrix-settings-wayland-trace-baseline)"; echo WAYLAND_TRACE_BASELINE=ready}
			run_serial_check $trace_baseline_command {WAYLAND_TRACE_BASELINE=ready} {WAYLAND_TRACE_BASELINE=failed} "record the GTK client trace before category input" 10
			set trace_geometry_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); previous=; stable=0; rect=; for n in $(seq 1 100); do geometry=$(grep -E "GEOMETRY_EVIDENCE event=(map|commit|state) pid=$pid " /tmp/seyrix-compositor.log | tail -n 1); rect=$(sed -nE 's/.* x=(-?[0-9]+) y=(-?[0-9]+) width=([0-9]+) height=([0-9]+).*/\1,\2,\3,\4/p' <<< "$geometry"); if [[ -n "$rect" && "$rect" == "$previous" ]]; then stable=$((stable + 1)); else stable=0; fi; if (( stable >= 20 )); then printf 'SETTINGS_DIAGNOSTIC_STABLE_GEOMETRY=%s\n' "$rect"; break; fi; previous=$rect; sleep 0.25; done; if (( stable >= 20 )); then echo SETTINGS_DIAGNOSTIC_GEOMETRY=ready; else echo SETTINGS_DIAGNOSTIC_GEOMETRY=unstable; fi}
			set trace_geometry [run_serial_capture $trace_geometry_command {SETTINGS_DIAGNOSTIC_STABLE_GEOMETRY=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+)} {SETTINGS_DIAGNOSTIC_STABLE_GEOMETRY=missing} "wait for the final Settings geometry after GTK responsive layout changes" 30]
			if {[lindex $trace_geometry 0] ne "pass"} {
				puts stderr "Could not read the live Settings window geometry for the rendering diagnostic."
				exit 1
			}
			set trace_window_x [lindex $trace_geometry 1]
			set trace_window_y [lindex $trace_geometry 2]
			set trace_window_width [lindex $trace_geometry 3]
			after 10000
			qmp_hmp $qmp "screendump $run_dir/settings-render-appearance.ppm"
			if {[catch {exec python3 $render_helper $run_dir/settings-render-desktop-baseline.ppm $run_dir/settings-render-appearance.ppm $output_width} appearance_ready_result]} {
				puts stderr "The stable Settings Appearance page did not reach the QMP framebuffer. $appearance_ready_result"
				puts "SETTINGS_APPEARANCE_RENDER=INCOMPLETE"
				exit 1
			}
			puts "SETTINGS_APPEARANCE_RENDER=passed $appearance_ready_result"
			set mouse_trace_baseline_command {wc -l < /tmp/seyrix-compositor.log > /tmp/seyrix-settings-mouse-trace-baseline; wc -l < /tmp/seyrix-compositor.log > /tmp/seyrix-settings-mouse-compositor-baseline; echo SETTINGS_MOUSE_TRACE_BASELINE=ready}
			run_serial_check $mouse_trace_baseline_command {SETTINGS_MOUSE_TRACE_BASELINE=ready} {SETTINGS_MOUSE_TRACE_BASELINE=failed} "record GTK state before category pointer input" 10
			set qmp_button_monitor_command "nohup timeout 60s evtest /dev/input/$input_device_event >/tmp/seyrix-settings-qmp-evtest.log 2>&1 </dev/null & echo SETTINGS_QMP_EVTEST=started"
			run_serial_check $qmp_button_monitor_command {SETTINGS_QMP_EVTEST=started} {SETTINGS_QMP_EVTEST=failed} "record QMP tablet button press and release events" 10
			if {$trace_window_width < 760} {
				set selector_bounds_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); line=$(grep -F "pid=$pid event=gtk_category_selector_bounds page=category-selector " /tmp/seyrix-compositor.log | tail -n 1); bounds=$(sed -nE 's/.*bounds_valid=1 bounds=([0-9.]+),([0-9.]+),([0-9.]+),([0-9.]+).*/\1,\2,\3,\4/p' <<< "$line"); if [[ "$line" == *visible=1* && "$line" == *mapped=1* && "$line" == *target_widget=GtkDropDown* && -n "$bounds" ]]; then printf 'SETTINGS_DIAGNOSTIC_CONTROL=compact-selector visible=1 mapped=1 bounds=%s\n' "$bounds"; printf 'SETTINGS_DIAGNOSTIC_CATEGORY_SELECTOR_BOUNDS=%s\n' "$bounds"; else echo SETTINGS_DIAGNOSTIC_CATEGORY_SELECTOR_BOUNDS=missing; fi}
				set selector_bounds [run_serial_capture $selector_bounds_command {SETTINGS_DIAGNOSTIC_CATEGORY_SELECTOR_BOUNDS=([0-9.]+),([0-9.]+),([0-9.]+),([0-9.]+)} {SETTINGS_DIAGNOSTIC_CATEGORY_SELECTOR_BOUNDS=missing} "read the allocated compact category selector bounds" 10]
				if {[lindex $selector_bounds 0] ne "pass"} {
					set selector_debug_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); grep -F "pid=$pid event=gtk_" /tmp/seyrix-compositor.log | grep -E 'layout_state|category_selector|sidebar_row|page_selection|window_map' | tail -n 45; echo SETTINGS_DIAGNOSTIC_SELECTOR_CONTEXT=complete}
					run_serial_check $selector_debug_command {SETTINGS_DIAGNOSTIC_SELECTOR_CONTEXT=complete} {SETTINGS_DIAGNOSTIC_SELECTOR_CONTEXT=failed} "preserve GTK state when compact selector bounds are unavailable" 10
				puts stderr "The stable compact Settings category selector has no allocated bounds."
					exit 1
				}
				set selector_x [expr {round($trace_window_x + [lindex $selector_bounds 1] + [lindex $selector_bounds 3] / 2)}]
				set selector_y [expr {round($trace_window_y + [lindex $selector_bounds 2] + [lindex $selector_bounds 4] / 2)}]
				set trace_click_x $selector_x
				set trace_click_y $selector_y
				puts "SETTINGS_DIAGNOSTIC_INPUT=pointer mode=compact-dropdown selector=$trace_click_x,$trace_click_y"
				qmp_mouse_click_pixel $qmp $trace_click_x $trace_click_y $output_width $output_height
				set popup_trace_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; baseline=$(cat /tmp/seyrix-settings-mouse-trace-baseline); ready=0; for attempt in $(seq 1 60); do delta=$(tail -n +$((baseline + 1)) "$trace"); popup_line=$(grep -E "source=client-stderr pid=$pid .*xdg_surface[@#][0-9]+\.get_popup\(new id xdg_popup[@#][0-9]+" <<< "$delta" | tail -n 1); if [[ -n "$popup_line" ]]; then read -r xdg_surface_id popup_id <<< "$(sed -nE 's/.*xdg_surface[@#]([0-9]+)\.get_popup\(new id xdg_popup[@#]([0-9]+),.*/\1 \2/p' <<< "$popup_line")"; configured_line=$(grep -E "xdg_popup[@#]$popup_id\.configure\(" <<< "$delta" | tail -n 1); bounds=$(sed -nE 's/.*\.configure\((-?[0-9]+),[[:space:]]*(-?[0-9]+),[[:space:]]*([0-9]+),[[:space:]]*([0-9]+)\).*/\1 \2 \3 \4/p' <<< "$configured_line"); surface_id=$(grep -E "get_xdg_surface\(new id xdg_surface[@#]$xdg_surface_id, wl_surface[@#][0-9]+\)" "$trace" | tail -n 1 | sed -nE 's/.*wl_surface[@#]([0-9]+)\).*/\1/p'); ack_line=$(grep -E "xdg_surface[@#]$xdg_surface_id\.ack_configure\(" <<< "$delta" | tail -n 1); attach_line=$(grep -E "wl_surface[@#]$surface_id\.attach\(wl_buffer[@#]" <<< "$delta" | tail -n 1); commit_line=$(grep -E "wl_surface[@#]$surface_id\.commit\(\)" <<< "$delta" | tail -n 1); config_n=$(grep -nF "$configured_line" <<< "$delta" | tail -n 1 | cut -d: -f1); ack_n=$(grep -nF "$ack_line" <<< "$delta" | tail -n 1 | cut -d: -f1); attach_n=$(grep -nF "$attach_line" <<< "$delta" | tail -n 1 | cut -d: -f1); commit_n=$(grep -nF "$commit_line" <<< "$delta" | tail -n 1 | cut -d: -f1); if [[ -n "$popup_id" && -n "$bounds" && -n "$surface_id" && -n "$ack_line" && -n "$attach_line" && -n "$commit_line" ]] && (( config_n < ack_n && ack_n < attach_n && attach_n < commit_n )); then read -r popup_x popup_y popup_width popup_height <<< "$bounds"; printf 'SETTINGS_DIAGNOSTIC_POPUP_GEOMETRY=%s,%s,%s,%s SURFACE=%s XDGSURFACE=%s XDGPOPUP=%s\n' "$popup_x" "$popup_y" "$popup_width" "$popup_height" "$surface_id" "$xdg_surface_id" "$popup_id"; ready=1; break; fi; fi; sleep 0.25; done; if [[ "$ready" -eq 1 ]]; then echo SETTINGS_DIAGNOSTIC_POPUP_READY=passed; else grep -F "source=client-stderr pid=$pid " "$trace" | grep -E 'xdg_surface|xdg_popup|wl_surface.*(attach|commit)' | tail -n 45; echo SETTINGS_DIAGNOSTIC_POPUP_READY=failed; fi}
				set popup_result [run_serial_capture $popup_trace_command {SETTINGS_DIAGNOSTIC_POPUP_GEOMETRY=(-?[0-9]+),(-?[0-9]+),([0-9]+),([0-9]+) SURFACE=([0-9]+) XDGSURFACE=([0-9]+) XDGPOPUP=([0-9]+)} {SETTINGS_DIAGNOSTIC_POPUP_READY=failed} "prove the GTK category popup configured and committed a buffer" 20]
				if {[lindex $popup_result 0] ne "pass"} {
					puts stderr "The compact category selector did not map its GTK popup after pointer activation."
					puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=category-popup-not-mapped"
					exit 1
				}
				set popup_x [lindex $popup_result 1]
				set popup_y [lindex $popup_result 2]
				set popup_width [lindex $popup_result 3]
				set popup_height [lindex $popup_result 4]
				qmp_hmp $qmp "screendump $run_dir/settings-render-category-popup.ppm"
				set trace_click_x [expr {round($trace_window_x + $popup_x + $popup_width / 2.0)}]
				set trace_click_y [expr {round($trace_window_y + $popup_y + $popup_height / 4.0)}]
				if {$trace_click_x < 0 || $trace_click_x >= $output_width || $trace_click_y < 0 || $trace_click_y >= $output_height} {
					puts stderr "The GTK Desktop & Dock popup row lies outside the QEMU display."
					exit 1
				}
				puts "SETTINGS_DIAGNOSTIC_CATEGORY_OPTION=desktop target=$trace_click_x,$trace_click_y"
				set click_abs_x [expr {int(($trace_click_x * 32767.0) / ($output_width - 1))}]
				set click_abs_y [expr {int(($trace_click_y * 32767.0) / ($output_height - 1))}]
				qmp_mouse_move $qmp $click_abs_x $click_abs_y
				after 100
				set click_press_reply [qmp_mouse_button $qmp left 1]
				after 100
				set click_release_reply [qmp_mouse_button $qmp left 0]
				if {[string first {"return"} $click_press_reply] >= 0 && [string first {"return"} $click_release_reply] >= 0} {
					puts "SETTINGS_QMP_BUTTON_CYCLE=passed press=acknowledged release=acknowledged"
				} else {
					puts stderr "SETTINGS_QMP_BUTTON_CYCLE=failed press=$click_press_reply release=$click_release_reply"
					exit 1
				}
			} else {
				set sidebar_bounds_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; line=$(grep -F "pid=$pid event=gtk_sidebar_row_bounds page=desktop " "$trace" | tail -n 1); bounds=$(sed -nE 's/.*bounds_space=GtkWindow bounds_valid=1 bounds=([0-9.]+),([0-9.]+),([0-9.]+),([0-9.]+).*/\1,\2,\3,\4/p' <<< "$line"); if [[ "$line" == *visible=1* && "$line" == *mapped=1* && "$line" == *selected_category=appearance* && "$line" == *target_category=desktop* && -n "$bounds" ]]; then printf 'SETTINGS_DIAGNOSTIC_CONTROL=sidebar category=desktop space=GtkWindow visible=1 mapped=1 bounds=%s\n' "$bounds"; printf 'SETTINGS_DIAGNOSTIC_SIDEBAR_BOUNDS=%s\n' "$bounds"; else echo SETTINGS_DIAGNOSTIC_SIDEBAR_BOUNDS=missing; fi}
				set sidebar_bounds [run_serial_capture $sidebar_bounds_command {SETTINGS_DIAGNOSTIC_SIDEBAR_BOUNDS=([0-9.]+),([0-9.]+),([0-9.]+),([0-9.]+)} {SETTINGS_DIAGNOSTIC_SIDEBAR_BOUNDS=missing} "read the mapped Desktop & Dock row bounds from GTK" 10]
				if {[lindex $sidebar_bounds 0] ne "pass"} {
					puts stderr "The Desktop & Dock sidebar row is not visible and mapped."
					exit 1
				}
				set trace_click_x [expr {round($trace_window_x + [lindex $sidebar_bounds 1] + [lindex $sidebar_bounds 3] / 2.0)}]
				set trace_click_y [expr {round($trace_window_y + [lindex $sidebar_bounds 2] + [lindex $sidebar_bounds 4] / 2.0)}]
				if {$trace_click_x < 0 || $trace_click_x >= $output_width || $trace_click_y < 0 || $trace_click_y >= $output_height} {
					puts stderr "The GTK row center lies outside the QEMU display."
					exit 1
				}
				puts "SETTINGS_DIAGNOSTIC_SIDEBAR_TARGET=Desktop-and-Dock source=gtk-bounds screen=$trace_click_x,$trace_click_y"
				puts "SETTINGS_DIAGNOSTIC_INPUT=pointer target_category=desktop screen=$trace_click_x,$trace_click_y"
				qmp_mouse_click_pixel $qmp $trace_click_x $trace_click_y $output_width $output_height
			}
			after 3000
			qmp_hmp $qmp "screendump $run_dir/settings-render-mouse-desktop.ppm"
			set mouse_trace_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; baseline=$(cat /tmp/seyrix-settings-mouse-trace-baseline); delta=$(tail -n +$((baseline + 1)) "$trace"); grep -F "pid=$pid event=gtk_" <<< "$delta" | tail -n 35; printf 'SETTINGS_MOUSE_WL_SURFACE_COUNTS damage=%s attach=%s commit=%s\n' "$(grep -Ec 'wl_surface[@#].*damage(_buffer)?[(]' <<< "$delta" || true)" "$(grep -Ec 'wl_surface[@#].*attach[(]' <<< "$delta" || true)" "$(grep -Ec 'wl_surface[@#].*commit[(]' <<< "$delta" || true)"; grep -E 'wl_surface[@#].*(damage|attach|commit)' <<< "$delta" | tail -n 24; printf 'SETTINGS_MOUSE_COMPOSITOR_RENDER_BEGIN\n'; grep -F "pid=$pid " /tmp/seyrix-compositor.log | grep 'SETTINGS_RENDER_TRACE event=' | tail -n 40 || true; printf 'SETTINGS_MOUSE_COMPOSITOR_RENDER_END\n'; echo SETTINGS_MOUSE_TRACE_CAPTURE=complete}
			run_serial_check $mouse_trace_command {SETTINGS_MOUSE_TRACE_CAPTURE=complete} {SETTINGS_MOUSE_TRACE_CAPTURE=failed} "record GTK focus, pointer target, row signals, guard, and stack after mouse click" 10
			if {$trace_window_width >= 760} {
				set mouse_coordinates_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; baseline=$(cat /tmp/seyrix-settings-mouse-trace-baseline); delta=$(tail -n +$((baseline + 1)) "$trace"); raw=$(grep -F "SEYRIX_SETTINGS_RAW_INPUT pid=$pid type=button-press " <<< "$delta" | tail -n 1); input=$(grep -F "pid=$pid event=gtk_input_button_press " <<< "$delta" | tail -n 1); raw_xy=$(sed -nE 's/.*positioned=1 x=([-0-9.]+) y=([-0-9.]+).*/\1 \2/p' <<< "$raw"); bounds=$(sed -nE 's/.*bounds_space=GtkWindow bounds_valid=1 bounds=([-0-9.]+),([-0-9.]+),([-0-9.]+),([-0-9.]+).*/\1 \2 \3 \4/p' <<< "$input"); read -r raw_x raw_y <<< "$raw_xy"; read -r left top width height <<< "$bounds"; printf 'SETTINGS_MOUSE_RAW_INPUT=%s\nSETTINGS_MOUSE_PICKED_WIDGET=%s\nSETTINGS_MOUSE_COORDINATE_INPUTS=%s\n' "${raw:-missing}" "${input:-missing}" "$raw_xy|$bounds|@SX@,@SY@|@WX@,@WY@"; if [[ "$input" == *target_category=desktop* && -n "$raw_x" && -n "$left" ]] && awk -v x="$raw_x" -v y="$raw_y" -v left="$left" -v top="$top" -v width="$width" -v height="$height" -v sx=@SX@ -v sy=@SY@ -v wx=@WX@ -v wy=@WY@ 'BEGIN { dx=x+wx-sx; dy=y+wy-sy; inside=(x>=left && x<=left+width && y>=top && y<=top+height); printf "SETTINGS_MOUSE_COORDINATE_MATH=dx:%s dy:%s inside:%d\\n",dx,dy,inside; exit !(dx<=1 && dx>=-1 && dy<=1 && dy>=-1 && inside) }'; then echo SETTINGS_MOUSE_COORDINATE_TRANSLATION=passed; else echo SETTINGS_MOUSE_COORDINATE_TRANSLATION=failed; fi}
				set mouse_coordinates_command [string map [list @SX@ $trace_click_x @SY@ $trace_click_y @WX@ $trace_window_x @WY@ $trace_window_y] $mouse_coordinates_command]
				run_serial_check $mouse_coordinates_command {SETTINGS_MOUSE_COORDINATE_TRANSLATION=passed} {SETTINGS_MOUSE_COORDINATE_TRANSLATION=failed} "verify QMP screen coordinates map to the GTK picked widget in GtkWindow space" 10
				if {$last_serial_check_result ne "pass"} {
					puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=mouse-coordinate-translation-failed"
					exit 1
				}
			}
			if {$trace_window_width < 760} {
				set mouse_transition_check_command {
pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
trace=/tmp/seyrix-compositor.log
baseline=$(cat /tmp/seyrix-settings-mouse-trace-baseline)
delta=$(tail -n +$((baseline + 1)) "$trace")
compositor_baseline=$(cat /tmp/seyrix-settings-mouse-compositor-baseline)
compositor_delta=$(tail -n +$((compositor_baseline + 1)) /tmp/seyrix-compositor.log)
input=$(grep -F "pid=$pid event=gtk_input_button_press" <<< "$delta" | tail -n 1)
release=$(grep -F "pid=$pid event=gtk_input_button_release page=button-1 " <<< "$delta" | tail -n 1)
raw_release=$(grep -F "SEYRIX_SETTINGS_RAW_INPUT pid=$pid type=button-release " <<< "$delta" | tail -n 1)
selected=$(grep -F "pid=$pid event=gtk_category_selector_changed page=desktop " <<< "$delta" | tail -n 1)
page=$(grep -F "pid=$pid event=gtk_page_selection page=desktop selected=desktop" <<< "$delta" | tail -n 1)
mapped_page=$(grep -F "pid=$pid event=gtk_page_bounds page=desktop " <<< "$delta" | tail -n 1)
unmapped_page=$(grep -F "pid=$pid event=gtk_page_unmap page=appearance " <<< "$delta" | tail -n 1)
pointer=$(grep -F 'Pointer button press button=272' <<< "$compositor_delta" | tail -n 1)
printf 'SETTINGS_MOUSE_COMPOSITOR_POINTER=%s\n' "${pointer:-missing}"
printf 'SETTINGS_MOUSE_GTK_RELEASE=%s\nSETTINGS_MOUSE_RAW_RELEASE=%s\n' "${release:-missing}" "${raw_release:-missing}"
if [[ "$input" == *bounds_valid=1* && "$input" == *visible=1* && "$input" == *mapped=1* &&
      "$release" == *page=button-1* && "$release" == *bounds_valid=1* && "$release" == *target_category=desktop* &&
      "$raw_release" == *positioned=1* && "$raw_release" == *target_widget=GtkLabel* &&
      "$selected" == *category_sync_active=0* && "$selected" == *selected_category=appearance* && -n "$page" &&
      "$mapped_page" == *visible=1* && "$mapped_page" == *mapped=1* && "$mapped_page" == *selected=desktop* &&
      "$unmapped_page" == *page=appearance* && "$pointer" == *Pointer\ button\ press\ button=272* ]]; then
  echo SETTINGS_MOUSE_TRANSITION=passed
else
  echo SETTINGS_MOUSE_TRANSITION=failed
fi
printf 'SETTINGS_MOUSE_GTK_INPUT=%s\nSETTINGS_MOUSE_SELECTOR_CHANGED=%s\nSETTINGS_MOUSE_STACK_PAGE=%s\nSETTINGS_MOUSE_PAGE_MAPPED=%s\nSETTINGS_MOUSE_OUTGOING_PAGE=%s\n' "$input" "$selected" "$page" "$mapped_page" "$unmapped_page"
}
			} else {
				set mouse_transition_check_command {
pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
trace=/tmp/seyrix-compositor.log
baseline=$(cat /tmp/seyrix-settings-mouse-trace-baseline)
delta=$(tail -n +$((baseline + 1)) "$trace")
input=$(grep -F "pid=$pid event=gtk_input_button_press" <<< "$delta" | tail -n 1)
release=$(grep -F "pid=$pid event=gtk_input_button_release page=button-1 " <<< "$delta" | tail -n 1)
raw_release=$(grep -F "SEYRIX_SETTINGS_RAW_INPUT pid=$pid type=button-release " <<< "$delta" | tail -n 1)
selected=$(grep -F "pid=$pid event=gtk_sidebar_row_selected page=desktop " <<< "$delta" | tail -n 1)
page=$(grep -F "pid=$pid event=gtk_page_selection page=desktop selected=desktop" <<< "$delta" | tail -n 1)
printf 'SETTINGS_MOUSE_GTK_RELEASE=%s\nSETTINGS_MOUSE_RAW_RELEASE=%s\n' "${release:-missing}" "${raw_release:-missing}"
if [[ "$input" == *target_widget=GtkLabel* && "$release" == *page=button-1* &&
      "$release" == *bounds_valid=1* && "$release" == *target_category=desktop* &&
      "$raw_release" == *positioned=1* && "$raw_release" == *target_widget=GtkLabel* &&
      "$selected" == *category_sync_active=0* && "$selected" == *selected_category=desktop* && -n "$page" ]]; then
  echo SETTINGS_MOUSE_TRANSITION=passed
else
  echo SETTINGS_MOUSE_TRANSITION=failed
fi
printf 'SETTINGS_MOUSE_GTK_INPUT=%s\nSETTINGS_MOUSE_ROW_SELECTED=%s\nSETTINGS_MOUSE_STACK_PAGE=%s\n' "${input:-missing}" "${selected:-missing}" "${page:-missing}"
grep -E 'Pointer button press button=272' /tmp/seyrix-compositor.log | tail -n 2
printf 'SETTINGS_QMP_EVTEST_BEGIN\n'
tail -n 20 /tmp/seyrix-settings-qmp-evtest.log 2>/dev/null || true
printf 'SETTINGS_QMP_EVTEST_END\n'
}
			}
			run_serial_check $mouse_transition_check_command {SETTINGS_MOUSE_TRANSITION=passed} {SETTINGS_MOUSE_TRANSITION=failed} "verify actual mouse event, GTK row activation, and Desktop stack transition" 10
			if {$last_serial_check_result ne "pass"} {
				puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=mouse-selection-failed"
