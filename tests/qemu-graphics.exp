#!/usr/bin/expect -f

if {$argc < 4} {
    puts stderr {Usage: qemu-graphics.exp run-dir monitor-port qemu [qemu arguments...]}
    exit 2
}

set run_dir [lindex $argv 0]
set monitor_port [lindex $argv 1]
set qemu [lindex $argv 2]
set qemu_args [lrange $argv 3 end]
if {![info exists env(SEYRIX_QEMU_LOCK_HELD)] ||
		$env(SEYRIX_QEMU_LOCK_HELD) ne "1"} {
	puts stderr "QEMU graphics tests must run through qemu-graphics.sh so the ownership lock is held."
	exit 2
}
set qemu_identity ""
for {set index 0} {$index + 1 < [llength $qemu_args]} {incr index} {
	if {[lindex $qemu_args $index] eq "-name"} {
		set qemu_identity [lindex $qemu_args [expr {$index + 1}]]
		break
	}
}
if {$qemu_identity eq ""} {
	puts stderr "QEMU arguments have no run-specific -name identity."
	exit 2
}
set qemu_pid -1
set qemu_spawn_id -1
set qemu_process_spawn_id -1
set acceptance_failures 0
set last_serial_check_result incomplete
set serial_log "$run_dir/expect-session.log"
set timeout 360
set boot_control_timeout_ms 600000
if {[info exists env(SEYRIX_QEMU_BOOT_CONTROL_TIMEOUT_MS)]} {
	set requested_boot_control_timeout_ms $env(SEYRIX_QEMU_BOOT_CONTROL_TIMEOUT_MS)
	if {![regexp {^[1-9][0-9]{0,5}$} $requested_boot_control_timeout_ms] ||
		$requested_boot_control_timeout_ms > 900000} {
		puts stderr "SEYRIX_QEMU_BOOT_CONTROL_TIMEOUT_MS must be between 1 and 900000."
		exit 2
	}
	set boot_control_timeout_ms $requested_boot_control_timeout_ms
}
set phase2b 0
set phase2c 0
set phase2d2 0
set phase2d3b 0
set sanitizers_enabled 0
set sanitizer_only 0
set settings_ipc_only 0
set renderer_request ""
set egl_lifecycle_control 0
if {[info exists env(SEYRIX_QEMU_WORKFLOW)] &&
		($env(SEYRIX_QEMU_WORKFLOW) eq "phase2b" ||
		$env(SEYRIX_QEMU_WORKFLOW) eq "phase2c" ||
		$env(SEYRIX_QEMU_WORKFLOW) eq "phase2d2")} {
	set phase2b 1
}
if {[info exists env(SEYRIX_QEMU_WORKFLOW)] &&
		$env(SEYRIX_QEMU_WORKFLOW) eq "phase2d3b"} {
	set phase2b 1
	set phase2c 1
	set phase2d2 1
	set phase2d3b 1
}
if {[info exists env(SEYRIX_QEMU_SETTINGS_IPC_ONLY)] &&
		$env(SEYRIX_QEMU_SETTINGS_IPC_ONLY) eq "1"} {
	if {!$phase2d3b} {
		puts stderr "Settings IPC-only diagnostics require the phase2d3b workflow."
		exit 2
	}
	set settings_ipc_only 1
}
if {[info exists env(SEYRIX_QEMU_WORKFLOW)] &&
		($env(SEYRIX_QEMU_WORKFLOW) eq "phase2d2" ||
		$env(SEYRIX_QEMU_WORKFLOW) eq "phase2d3b")} {
	set phase2d2 1
	set phase2c 1
}
if {[info exists env(SEYRIX_QEMU_WORKFLOW)] &&
		$env(SEYRIX_QEMU_WORKFLOW) eq "phase2c"} {
	set phase2c 1
}
if {[info exists env(SEYRIX_QEMU_SANITIZERS)] &&
		$env(SEYRIX_QEMU_SANITIZERS) eq "1"} {
	set sanitizers_enabled 1
}
if {[info exists env(SEYRIX_QEMU_SANITIZER_ONLY)] &&
		$env(SEYRIX_QEMU_SANITIZER_ONLY) eq "1"} {
	if {!$phase2d3b || !$sanitizers_enabled} {
		puts stderr "Sanitizer-only diagnostics require the phase2d3b workflow and an instrumented compositor."
		exit 2
	}
	set sanitizer_only 1
}
if {[info exists env(SEYRIX_QEMU_RENDERER)]} {
	set renderer_request $env(SEYRIX_QEMU_RENDERER)
}
if {[info exists env(SEYRIX_QEMU_EGL_LIFECYCLE_CONTROL)] &&
		$env(SEYRIX_QEMU_EGL_LIFECYCLE_CONTROL) eq "1"} {
	set egl_lifecycle_control 1
}

proc qemu_cmdline {pid} {
	set path "/proc/$pid/cmdline"
	if {![file readable $path]} {
		return ""
	}
	if {[catch {set channel [open $path r]}]} {
		return ""
	}
	fconfigure $channel -translation binary -encoding binary
	set command_line [read $channel]
	close $channel
	return $command_line
}

proc qemu_is_owned {pid} {
	global qemu_identity
	set command_line [qemu_cmdline $pid]
	return [expr {$command_line ne "" &&
		[string first $qemu_identity $command_line] >= 0}]
}

proc wait_for_owned_qemu_exit {timeout_s} {
	global qemu_pid
	set attempts [expr {$timeout_s * 4}]
	for {set attempt 0} {$attempt < $attempts} {incr attempt} {
		if {![qemu_is_owned $qemu_pid]} {
			return 1
		}
		after 250
	}
	return [expr {![qemu_is_owned $qemu_pid]}]
}

proc finish_guest_shutdown {qmp stage_name initial_timeout_s {request_poweroff 1}} {
	global qemu_pid qemu_process_spawn_id qemu_spawn_id
	puts "STAGE_BEGIN name={$stage_name} timeout_s=$initial_timeout_s"
	if {$request_poweroff} {
		send -i $qemu_spawn_id -- "loginctl poweroff\r"
	}
	if {![wait_for_owned_qemu_exit $initial_timeout_s]} {
		puts "GUEST_SHUTDOWN=acpi-request"
		if {[catch {qmp_exec $qmp {{"execute":"system_powerdown"}}} powerdown_error]} {
			if {[qemu_is_owned $qemu_pid]} {
				puts stderr "Could not request ACPI guest poweroff: $powerdown_error"
			}
		}
		if {![wait_for_owned_qemu_exit 90]} {
			puts stderr "STAGE_RESULT name={$stage_name} result=INCOMPLETE reason=timeout"
			puts stderr "Guest shutdown did not stop the owned QEMU process within the bounded wait."
			exit 1
		}
	}
	set wait_result [wait -i $qemu_process_spawn_id]
	set qemu_exit [lindex $wait_result 3]
	if {$qemu_exit != 0} {
		puts stderr "STAGE_RESULT name={$stage_name} result=FAIL exit=$qemu_exit"
		puts stderr "QEMU exited with status $qemu_exit after the guest shutdown request."
		exit 1
	}
	puts "CLEAN_SHUTDOWN=passed"
	puts "STAGE_RESULT name={$stage_name} result=PASS"
}

proc cleanup_owned_qemu {reason} {
	global qemu_pid qemu_spawn_id qemu_process_spawn_id run_dir qemu_identity
	if {$qemu_pid <= 0} {
		return
	}
	if {![qemu_is_owned $qemu_pid]} {
		if {$qemu_process_spawn_id ne -1} {catch {wait -i $qemu_process_spawn_id}}
		if {$qemu_spawn_id ne -1} {
			catch {close -i $qemu_spawn_id}
			catch {wait -i $qemu_spawn_id}
		}
		return
	}
	set command_line [qemu_cmdline $qemu_pid]
	if {[catch {set channel [open "$run_dir/qemu-process-before-cleanup.txt" w]}]} {
		set channel ""
	}
	if {$channel ne ""} {
		set printable [string map [list "\x00" " "] $command_line]
		puts $channel "Cleanup reason: $reason"
		puts $channel "QEMU PID: $qemu_pid"
		puts $channel "Expected run identity: $qemu_identity"
		puts $channel "Command line: $printable"
		catch {puts $channel [exec ps -p $qemu_pid -o pid=,ppid=,stat=,etimes=,comm=]}
		close $channel
	}
	puts stderr "Stopping QEMU owned by this run: PID $qemu_pid ($reason)."
	if {[catch {exec kill -TERM $qemu_pid} kill_error]} {
		puts stderr "Could not send SIGTERM to owned QEMU PID $qemu_pid: $kill_error"
		return
	}
	for {set attempt 0} {$attempt < 20} {incr attempt} {
		after 250
		if {![qemu_is_owned $qemu_pid]} {
			if {$qemu_process_spawn_id ne -1} {catch {wait -i $qemu_process_spawn_id}}
			if {$qemu_spawn_id ne -1} {
				catch {close -i $qemu_spawn_id}
				catch {wait -i $qemu_spawn_id}
			}
			return
		}
	}
	if {[qemu_is_owned $qemu_pid]} {
		puts stderr "Owned QEMU PID $qemu_pid did not stop within 5 seconds; sending SIGKILL after identity recheck."
		if {[catch {exec kill -KILL $qemu_pid} kill_error]} {
			puts stderr "Could not send SIGKILL to owned QEMU PID $qemu_pid: $kill_error"
		}
	}
	for {set attempt 0} {$attempt < 8} {incr attempt} {
		after 250
		if {![qemu_is_owned $qemu_pid]} {
			break
		}
	}
	if {$qemu_process_spawn_id ne -1} {
		catch {wait -i $qemu_process_spawn_id}
	}
	if {$qemu_spawn_id ne -1} {
		catch {close -i $qemu_spawn_id}
		catch {wait -i $qemu_spawn_id}
	}
}

rename exit expect_exit
proc exit {{status 0}} {
	global qemu_pid
	if {$status != 0 && $qemu_pid > 0} {
		cleanup_owned_qemu "test-exit-$status"
	}
	expect_exit $status
}
trap {cleanup_owned_qemu "SIGINT"; expect_exit 130} SIGINT
trap {cleanup_owned_qemu "SIGTERM"; expect_exit 143} SIGTERM
trap {cleanup_owned_qemu "SIGHUP"; expect_exit 129} SIGHUP
log_file -noappend $serial_log
log_user 1
set boot_started [clock milliseconds]

proc qmp_read_line {channel timeout_s} {
	set deadline [expr {[clock milliseconds] + ($timeout_s * 1000)}]
	while {[clock milliseconds] < $deadline} {
		if {[gets $channel line] >= 0} {
			return $line
		}
		if {[eof $channel]} {
			error "QMP connection closed before a complete line."
		}
		after 50
	}
	error "QMP line timed out after ${timeout_s}s."
}

proc qmp_reply {channel} {
	set deadline [expr {[clock milliseconds] + 15000}]
	while {[clock milliseconds] < $deadline} {
		if {[gets $channel line] >= 0} {
			if {[string first {"return"} $line] >= 0 || [string first {"error"} $line] >= 0} {
				if {[string first {"error"} $line] >= 0} {
					error "QMP error: $line"
				}
				return $line
			}
		} elseif {[eof $channel]} {
			error "QMP connection closed before reply."
		}
		after 50
	}
	error "QMP reply timed out after 15s."
}

proc qmp_exec {channel json} {
    puts $channel $json
    flush $channel
    return [qmp_reply $channel]
}

proc qmp_hmp {channel command} {
    set screenshot_path ""
    if {[regexp {^screendump[ \t]+(.+)$} $command -> screenshot_path]} {
        if {[file exists $screenshot_path] &&
                [catch {file delete -force -- $screenshot_path} delete_error]} {
            puts stderr "Could not remove stale QMP screenshot $screenshot_path: $delete_error"
            exit 1
        }
    }
    set escaped [string map [list "\\" "\\\\" "\"" "\\\""] $command]
    set result [qmp_exec $channel "{\"execute\":\"human-monitor-command\",\"arguments\":{\"command-line\":\"$escaped\"}}"]
    if {$screenshot_path ne ""} {
        set screenshot_ready 0
        for {set attempt 0} {$attempt < 20} {incr attempt} {
            if {[file isfile $screenshot_path] && [file size $screenshot_path] > 16} {
                set screenshot_ready 1
                break
            }
            after 100
        }
        if {!$screenshot_ready} {
            puts stderr "QMP screendump did not create a nonempty image at $screenshot_path; reply=$result"
            exit 1
        }
    }
    return $result
}
proc wait_for_boot_control {control_channel serial_path timeout_ms} {
    global timeout
    set saved_timeout $timeout
    set deadline [expr {[clock milliseconds] + $timeout_ms}]
    while {[clock milliseconds] < $deadline} {
        if {[file readable $serial_path] && ![catch {set channel [open $serial_path r]}]} {
            fconfigure $channel -translation binary -encoding binary
            set content [read $channel]
            close $channel
            if {[string first "Kernel panic - not syncing" $content] >= 0} {
                set timeout $saved_timeout
                return kernel-panic
            }
        }
        set ::seyrix_boot_control_result waiting
        set timeout 1
        expect -i $control_channel \
            -re {SEYRIX-USER#} {set ::seyrix_boot_control_result ready} \
            timeout {set ::seyrix_boot_control_result waiting} \
            eof {
                set timeout $saved_timeout
                set ::seyrix_boot_control_result qemu-exit
            }
        if {$::seyrix_boot_control_result eq "ready"} {
            set timeout $saved_timeout
            return ready
        }
        if {$::seyrix_boot_control_result eq "qemu-exit"} {
            set timeout $saved_timeout
            return qemu-exit
        }
    }
    set timeout $saved_timeout
    return timeout
}

proc keycode_for {character} {
    set shift 0
    if {[regexp {^[A-Z]$} $character]} {
        set character [string tolower $character]
        set shift 1
    }
    if {[regexp {^[a-z0-9]$} $character]} {
        return [list $character $shift]
    }
    switch -- $character {
        " " { return [list "spc" 0] }
        "/" { return [list "slash" 0] }
        "-" { return [list "minus" 0] }
        "_" { return [list "minus" 1] }
        "=" { return [list "equal" 0] }
        "," { return [list "comma" 0] }
        ";" { return [list "semicolon" 0] }
        ":" { return [list "semicolon" 1] }
        "@" { return [list "2" 1] }
        "." { return [list "dot" 0] }
        ">" { return [list "dot" 1] }
        "\n" { return [list "ret" 0] }
        default { error "Unsupported QEMU key character: $character" }
    }
}

proc qmp_type {channel value} {
    foreach character [split $value ""] {
        lassign [keycode_for $character] code shift
        set keys [list]
        if {$shift} {
            lappend keys [format {{"type":"qcode","data":"%s"}} "shift"]
        }
        lappend keys [format {{"type":"qcode","data":"%s"}} $code]
        set json [format {{"execute":"send-key","arguments":{"keys":[%s],"hold-time":50}}} [join $keys ","]]
        qmp_exec $channel $json
        # TCG guests can lag host wall clock; allow QEMU's send-key hold timer
        # to release the key before the next character arrives.
        after 350
    }
}

proc qmp_type_slow {channel value {delay_ms 320}} {
    foreach character [split $value ""] {
        if {$character eq "\n"} {
            qmp_key_chord $channel {} ret
            after $delay_ms
            continue
        }
        lassign [keycode_for $character] code shift
        set events [list]
        if {$shift} {
            lappend events [format {{"type":"key","data":{"down":true,"key":{"type":"qcode","data":"%s"}}}} "shift"]
        }
        lappend events [format {{"type":"key","data":{"down":true,"key":{"type":"qcode","data":"%s"}}}} $code]
        lappend events [format {{"type":"key","data":{"down":false,"key":{"type":"qcode","data":"%s"}}}} $code]
        if {$shift} {
            lappend events [format {{"type":"key","data":{"down":false,"key":{"type":"qcode","data":"%s"}}}} "shift"]
        }
        qmp_exec $channel [format {{"execute":"input-send-event","arguments":{"events":[%s]}}} [join $events ","]]
        after $delay_ms
    }
}

proc qmp_mouse_move {channel x y} {
    set json [format {{"execute":"input-send-event","arguments":{"events":[{"type":"abs","data":{"axis":"x","value":%s}},{"type":"abs","data":{"axis":"y","value":%s}}]}}} $x $y]
    return [qmp_exec $channel $json]
}

proc qmp_mouse_click_pixel {channel x y width height} {
	set absolute_x [expr {int(($x * 32767.0) / ($width - 1))}]
	set absolute_y [expr {int(($y * 32767.0) / ($height - 1))}]
	qmp_mouse_move $channel $absolute_x $absolute_y
	qmp_mouse_click $channel
}

proc qmp_mouse_move_pixel {channel x y width height} {
	set absolute_x [expr {int(($x * 32767.0) / ($width - 1))}]
	set absolute_y [expr {int(($y * 32767.0) / ($height - 1))}]
	qmp_mouse_move $channel $absolute_x $absolute_y
}

proc qmp_mouse_click {channel} {
    # Let the compositor process the last absolute motion before hit-testing.
    after 100
    qmp_exec $channel {{"execute":"input-send-event","arguments":{"events":[{"type":"btn","data":{"down":true,"button":"left"}}]}}}
    after 100
    qmp_exec $channel {{"execute":"input-send-event","arguments":{"events":[{"type":"btn","data":{"down":false,"button":"left"}}]}}}
}

proc qmp_key_transition {channel key down} {
    set state "false"
    if {$down} {
        set state "true"
    }
    set json [format {{"execute":"input-send-event","arguments":{"events":[{"type":"key","data":{"down":%s,"key":{"type":"qcode","data":"%s"}}}]}}} $state $key]
    return [qmp_exec $channel $json]
}

proc qmp_key_chord {channel modifiers key} {
    foreach modifier $modifiers {
        qmp_key_transition $channel $modifier 1
        after 80
    }
    qmp_key_transition $channel $key 1
    after 100
    qmp_key_transition $channel $key 0
    after 80
    foreach modifier [lreverse $modifiers] {
        qmp_key_transition $channel $modifier 0
        after 80
    }
}

proc qmp_mouse_button {channel button down} {
    set state "false"
    if {$down} {
        set state "true"
    }
    set json [format {{"execute":"input-send-event","arguments":{"events":[{"type":"btn","data":{"down":%s,"button":"%s"}}]}}} $state $button]
    return [qmp_exec $channel $json]
}

proc qmp_mouse_wheel {channel direction steps} {
	if {$direction ne "wheel-up" && $direction ne "wheel-down"} {
		error "Unsupported QEMU wheel direction: $direction"
	}
	for {set step 0} {$step < $steps} {incr step} {
		qmp_mouse_button $channel $direction 1
		after 50
		qmp_mouse_button $channel $direction 0
		after 100
	}
}

proc qmp_mouse_drag {channel x1 y1 x2 y2 button} {
    qmp_mouse_move $channel $x1 $y1
    after 100
    qmp_mouse_button $channel $button 1
    after 100
    qmp_mouse_move $channel $x2 $y2
    after 250
    qmp_mouse_button $channel $button 0
    after 100
}

proc install_guest_helper {helper_path} {
    global qemu_spawn_id timeout
    set saved_timeout $timeout
    set timeout 30
    set channel [open $helper_path r]
    set helper_source [read $channel]
    close $channel
    set helper_source [string map [list "\r" ""] $helper_source]
    send -i $qemu_spawn_id -- "cat > /tmp/seyrix-qemu-guest-helper.sh <<'SEYRIX_GUEST_HELPER_EOF'\r"
    set helper_payload $helper_source
    send -i $qemu_spawn_id -- $helper_payload
    send -i $qemu_spawn_id -- "\rSEYRIX_GUEST_HELPER_EOF\rif chmod +x /tmp/seyrix-qemu-guest-helper.sh && bash -n /tmp/seyrix-qemu-guest-helper.sh; then echo QEMU_GUEST_HELPER_UPLOAD=passed; else echo QEMU_GUEST_HELPER_UPLOAD=failed; fi\r"
    expect -i $qemu_spawn_id \
        -re {QEMU_GUEST_HELPER_UPLOAD=passed} {} \
        -re {QEMU_GUEST_HELPER_UPLOAD=failed} {
            set timeout $saved_timeout
            puts stderr "The QEMU guest helper failed its shell syntax check."
            exit 1
        } \
        timeout {
            set timeout $saved_timeout
            puts stderr "Timed out installing the QEMU guest helper."
            exit 1
        } \
        eof {
            puts stderr "QEMU exited while installing the guest helper."
            exit 1
        }
    set timeout $saved_timeout
}

proc configure_guest_control_shell {} {
	global qemu_spawn_id timeout
	set saved_timeout $timeout
	set timeout 8
	send -i $qemu_spawn_id -- "export PS1='SEYRIX-USER# '\r"
	expect -i $qemu_spawn_id -re {SEYRIX-USER#} {} timeout {
		set timeout $saved_timeout
		puts stderr "Timed out configuring the unprivileged QEMU control shell."
		exit 1
	}
	set timeout $saved_timeout
}

proc ensure_guest_control_shell {} {
	global qemu_spawn_id timeout
	set saved_timeout $timeout
	set timeout 8
	send -i $qemu_spawn_id -- "\r"
	expect -i $qemu_spawn_id -re {SEYRIX-USER#} {} timeout {
		set timeout $saved_timeout
		puts stderr "Timed out locating the unprivileged QEMU control shell."
		exit 1
	}
	set timeout $saved_timeout
}

proc run_serial_capture {command success_pattern failure_pattern description stage_timeout} {
    global qemu_spawn_id timeout expect_out
    set saved_timeout $timeout
    set timeout $stage_timeout
    set started_ms [clock milliseconds]
    set timestamp [clock format [clock seconds] -gmt 1 -format {%Y-%m-%dT%H:%M:%SZ}]
    puts "STAGE_BEGIN name={$description} utc=$timestamp timeout_s=$timeout"
    ensure_guest_control_shell
    send -i $qemu_spawn_id -- "$command\r"
    set result incomplete
    set captured {}
    set timeout $stage_timeout
    set timeout $stage_timeout
    expect -i $qemu_spawn_id \
        -re $success_pattern {
            set result pass
            for {set index 1} {$index < 20} {incr index} {
                if {[info exists expect_out($index,string)]} {
                    lappend captured $expect_out($index,string)
                }
            }
        } \
        -re $failure_pattern {set result fail} \
        timeout {set result incomplete} \
        eof {
            puts stderr "STAGE_RESULT name={$description} result=INCOMPLETE reason=qemu-eof"
            puts stderr "QEMU exited during $description."
            exit 1
        }
	set timeout $stage_timeout
	expect -i $qemu_spawn_id -re {SEYRIX-USER#} {} timeout {
		puts stderr "The unprivileged control shell did not return after $description."
		exit 1
	}
    set duration_ms [expr {[clock milliseconds] - $started_ms}]
        if {$result eq "pass"} {
        puts "STAGE_RESULT name={$description} result=PASS duration_ms=$duration_ms"
    } elseif {$result eq "fail"} {
        puts stderr "STAGE_RESULT name={$description} result=FAIL duration_ms=$duration_ms"
        incr ::acceptance_failures
    } else {
        puts stderr "STAGE_RESULT name={$description} result=INCOMPLETE reason=timeout duration_ms=$duration_ms timeout_s=$timeout"
        incr ::acceptance_failures
    }
    set timeout $saved_timeout
    return [list $result {*}$captured]
}

proc run_serial_check {command success_pattern failure_pattern description {stage_timeout ""}} {
    global qemu_spawn_id timeout acceptance_failures last_serial_check_result
    set saved_timeout $timeout
    if {$stage_timeout ne ""} {
        set timeout $stage_timeout
    }
    set started_ms [clock milliseconds]
    set timestamp [clock format [clock seconds] -gmt 1 -format {%Y-%m-%dT%H:%M:%SZ}]
    puts "STAGE_BEGIN name={$description} utc=$timestamp timeout_s=$timeout"
	ensure_guest_control_shell
    send -i $qemu_spawn_id -- "$command\r"
    expect -i $qemu_spawn_id \
        -re $success_pattern {
            set last_serial_check_result pass
            set duration_ms [expr {[clock milliseconds] - $started_ms}]
            puts "STAGE_RESULT name={$description} result=PASS duration_ms=$duration_ms"
        } \
        -re $failure_pattern {
            set last_serial_check_result fail
            set duration_ms [expr {[clock milliseconds] - $started_ms}]
            puts stderr "STAGE_RESULT name={$description} result=FAIL duration_ms=$duration_ms"
            puts stderr "$description failed."
            incr acceptance_failures
        } \
        timeout {
            set last_serial_check_result incomplete
            set duration_ms [expr {[clock milliseconds] - $started_ms}]
            puts stderr "STAGE_RESULT name={$description} result=INCOMPLETE reason=timeout duration_ms=$duration_ms timeout_s=$timeout"
            puts stderr "Timed out: $description."
            incr acceptance_failures
        } \
        eof {
            puts stderr "STAGE_RESULT name={$description} result=INCOMPLETE reason=qemu-eof"
            puts stderr "QEMU exited: $description."
            exit 1
        }
    set timeout $stage_timeout
	expect -i $qemu_spawn_id -re {SEYRIX-USER#} {} timeout {
		puts stderr "The unprivileged control shell did not return after $description."
		exit 1
	}
    set timeout $saved_timeout
}

spawn -noecho $qemu {*}$qemu_args
set qemu_process_spawn_id $spawn_id
set qemu_pid [exp_pid -i $qemu_process_spawn_id]
set pid_channel [open "$run_dir/qemu.pid" w]
puts $pid_channel $qemu_pid
close $pid_channel
puts "QEMU_PID=$qemu_pid"
set control_pty ""
set control_pty_timeout_saved $timeout
set timeout 30
expect -i $qemu_process_spawn_id -re {char device redirected to (/dev/pts/[0-9]+)} {
	set control_pty $expect_out(1,string)
} timeout {
	set timeout $control_pty_timeout_saved
	puts stderr "QEMU did not create the named virtio-serial PTY fallback."
	exit 1
} eof {
	set timeout $control_pty_timeout_saved
	puts stderr "QEMU exited before creating the named virtio-serial PTY fallback."
	exit 1
}
set timeout $control_pty_timeout_saved
set control_pty_channel [open $control_pty r+]
fconfigure $control_pty_channel -translation binary -encoding binary -buffering none
if {[catch {exec stty -F $control_pty raw -echo} control_pty_error]} {
	puts stderr "Could not put the named virtio-serial PTY in raw mode: $control_pty_error"
	exit 1
}
spawn -open $control_pty_channel
set qemu_spawn_id $spawn_id
puts "GUEST_CONTROL_PTY=$control_pty"
# virtserialport exposes a byte stream, not a TTY line discipline. Preserve
# the harness's existing Enter keys by translating carriage returns to LF.
rename send qemu_control_send
proc send {args} {
	set last [expr {[llength $args] - 1}]
	set payload [string map [list "\r" "\n"] [lindex $args $last]]
	set args [lreplace $args $last $last $payload]
	uplevel 1 [linsert $args 0 qemu_control_send]
}
set qmp ""
set qmp_error ""
for {set attempt 0} {$attempt < 40 && $qmp eq ""} {incr attempt} {
    if {[catch {set qmp [socket 127.0.0.1 $monitor_port]} qmp_error]} {
        set qmp ""
        after 250
    }
}
if {$qmp eq ""} {
    puts stderr "Could not connect to QMP on localhost port $monitor_port: $qmp_error"
    exit 1
}
fconfigure $qmp -buffering line -blocking 0
set greeting [qmp_read_line $qmp 15]
if {[string first {"QMP"} $greeting] < 0} {
    puts stderr "Unexpected QMP greeting: $greeting"
    exit 1
}
qmp_exec $qmp {{"execute":"qmp_capabilities"}}
puts "QMP_CONNECTED=passed"
	set requested_resolution ""
	set output_width 640
	set output_height 480
	if {[info exists env(SEYRIX_QEMU_RESOLUTION_PROFILE)]} {
		switch -- $env(SEYRIX_QEMU_RESOLUTION_PROFILE) {
			640x480 - 800x600 - 1280x720 - 1920x1080 { set requested_resolution $env(SEYRIX_QEMU_RESOLUTION_PROFILE) }
		}
	}
	if {$requested_resolution ne ""} {
		set output_width [lindex [split $requested_resolution x] 0]
		set output_height [lindex [split $requested_resolution x] 1]
	}
	set video_mode ""
	if {$requested_resolution ne ""} {
		set video_mode [format {video=Virtual-1:%se} $requested_resolution]
		set video_mode_stage "wait for live GRUB menu and request a $requested_resolution framebuffer and DRM mode"
		puts "STAGE_BEGIN name={$video_mode_stage} timeout_s=10"
	set grub_menu_seen 0
	for {set attempt 0} {$attempt < 400 && !$grub_menu_seen} {incr attempt} {
		if {[file readable "$run_dir/serial.log"] && ![catch {set menu_channel [open "$run_dir/serial.log" r]}]} {
			fconfigure $menu_channel -translation binary -encoding binary
			set menu_text [read $menu_channel]
			close $menu_channel
			if {[string first {Seyrix Linux (x86_64, UEFI)} $menu_text] >= 0 &&
					[string first {Booting `Seyrix Linux} $menu_text] < 0} {
				set grub_menu_seen 1
			}
		}
		if {!$grub_menu_seen} {after 25}
	}
	if {!$grub_menu_seen} {
		puts stderr "STAGE_RESULT name={$video_mode_stage} result=INCOMPLETE reason=grub-menu-not-ready"
		puts stderr "GRUB did not present the boot menu before its automatic boot."
		exit 1
	}
	qmp_hmp $qmp "screendump $run_dir/grub-menu-$requested_resolution.ppm"
	qmp_key_transition $qmp e 1
	after 70
	qmp_key_transition $qmp e 0
	set grub_editor_ready 0
	for {set attempt 0} {$attempt < 200 && !$grub_editor_ready} {incr attempt} {
		if {[file readable "$run_dir/serial.log"] && ![catch {set editor_channel [open "$run_dir/serial.log" r]}]} {
			fconfigure $editor_channel -translation binary -encoding binary
			set editor_text [read $editor_channel]
			close $editor_channel
			if {[string first {linux /seyrix/boot/x86_64/vmlinuz-linux} $editor_text] >= 0} {
				set grub_editor_ready 1
			}
		}
		if {!$grub_editor_ready} {after 25}
	}
	if {!$grub_editor_ready} {
		puts stderr "STAGE_RESULT name={$video_mode_stage} result=FAIL reason=grub-editor-not-ready"
		puts stderr "The QMP edit key did not open the selected GRUB entry."
		exit 1
	}
	qmp_hmp $qmp "screendump $run_dir/grub-editor-before-$requested_resolution.ppm"
	for {set line 0} {$line < 2} {incr line} {
		qmp_key_transition $qmp down 1
		after 50
		qmp_key_transition $qmp down 0
		after 50
	}
	qmp_key_transition $qmp end 1
	after 50
	qmp_key_transition $qmp end 0
	for {set character 0} {$character < 4} {incr character} {
		qmp_key_transition $qmp backspace 1
		after 50
		qmp_key_transition $qmp backspace 0
		after 50
	}
	qmp_type $qmp $requested_resolution
	qmp_key_transition $qmp down 1
	after 50
	qmp_key_transition $qmp down 0
	after 50
	qmp_key_transition $qmp end 1
	after 50
	qmp_key_transition $qmp end 0
	qmp_type $qmp " $video_mode"
	after 150
	qmp_hmp $qmp "screendump $run_dir/grub-editor-$requested_resolution-requested.ppm"
	qmp_key_transition $qmp f10 1
	after 100
	qmp_key_transition $qmp f10 0
	puts "GRUB_VIDEO_REQUEST_SENT=kernel_arg=$video_mode kernel_line=linux"
	puts "STAGE_RESULT name={$video_mode_stage} result=PASS"
}
set pci_info [qmp_hmp $qmp "info pci"]
puts "QEMU_PCI_INVENTORY=$pci_info"

set control_timeout_saved $timeout
set control_timeout_s [expr {int(($boot_control_timeout_ms + 999) / 1000)}]
puts "STAGE_BEGIN name={UEFI boot to unprivileged graphical control shell} timeout_s=$control_timeout_s"
set control_wait_result [wait_for_boot_control $qemu_spawn_id "$run_dir/serial.log" $boot_control_timeout_ms]
if {$control_wait_result eq "ready"} {
    set control_ready_ms [expr {[clock milliseconds] - $boot_started}]
    puts "BOOT_TO_USER_CONTROL_MS=$control_ready_ms"
    puts "STAGE_RESULT name={UEFI boot to unprivileged graphical control shell} result=PASS duration_ms=$control_ready_ms"
} elseif {$control_wait_result eq "kernel-panic"} {
    puts stderr "STAGE_RESULT name={UEFI boot to unprivileged graphical control shell} result=FAIL reason=kernel-panic"
    puts stderr "The guest kernel panicked before its graphical control shell became ready."
    exit 1
} elseif {$control_wait_result eq "qemu-exit"} {
    puts stderr "STAGE_RESULT name={UEFI boot to unprivileged graphical control shell} result=FAIL reason=qemu-exited"
    puts stderr "QEMU exited before the unprivileged control shell appeared."
    exit 1
} else {
    puts stderr "STAGE_RESULT name={UEFI boot to unprivileged graphical control shell} result=INCOMPLETE reason=control-timeout"
    puts stderr "Timed out waiting for the bounded, unprivileged QEMU control shell."
    exit 1
}
set timeout $control_timeout_saved
configure_guest_control_shell
puts "USER_CONTROL_SHELL=passed"

set settings_render_diagnostic 0
if {[info exists env(SEYRIX_QEMU_SETTINGS_RENDER_DIAGNOSTIC)] && $env(SEYRIX_QEMU_SETTINGS_RENDER_DIAGNOSTIC) eq "1"} {
	set settings_render_diagnostic 1
}
puts "QEMU_UART_LOGIN_PROMPT_DIAGNOSTIC=not-required control=virtio-serial unprivileged-shell=verified"


set baseline_command {
  printf 'SEYRIX_GRAPHICS_CHECK_BEGIN\n'
  printf 'LOGIN_USER='; id -un
  printf 'KERNEL='; uname -r
  printf 'KERNEL_CMDLINE='; cat /proc/cmdline
  printf 'SERIAL_TTY_NODES='; ls -l /dev/ttyS* 2>&1 || true
  printf 'SERIAL_TTY_SYSFS='; ls -d /sys/class/tty/ttyS* 2>&1 || true
  printf 'SERIAL_GETTY_ENABLED='; systemctl is-enabled serial-getty@ttyS0.service 2>&1 || true
  printf 'SERIAL_GETTY_STATE='; systemctl is-active serial-getty@ttyS0.service 2>&1 || true
  printf 'SERIAL_GETTY_STATUS_BEGIN\n'; systemctl status serial-getty@ttyS0.service --no-pager --full 2>&1 || true; printf 'SERIAL_GETTY_STATUS_END\n'
  printf 'SERIAL_KERNEL_LOG_BEGIN\n'; journalctl -b -k --no-pager 2>&1 | grep -Ei 'ttyS0|8250|serial' | tail -n 30 || true; printf 'SERIAL_KERNEL_LOG_END\n'
  printf 'VIRTIO_PORTS_BEGIN\n'; find /sys/class/virtio-ports -maxdepth 2 -type f -name name -exec sh -c 'printf "%s=" "$1"; cat "$1"' _ {} \; 2>&1; printf 'VIRTIO_PORTS_END\n'
  printf 'VIRTIO_PORT_NODES='; ls -l /dev/vport* /dev/virtio-ports/* 2>&1 || true
  printf 'QEMU_CONTROL_SERVICE_STATE='; systemctl is-active seyrix-qemu-control.service 2>&1 || true
  printf 'QEMU_CONTROL_SERVICE_STATUS_BEGIN\n'; systemctl status seyrix-qemu-control.service --no-pager --full 2>&1 || true; printf 'QEMU_CONTROL_SERVICE_STATUS_END\n'
  printf 'QEMU_CONTROL_SERVICE_UID='; qemu_control_pid=$(systemctl show -p MainPID --value seyrix-qemu-control.service); if [[ "$qemu_control_pid" =~ ^[1-9][0-9]*$ ]]; then awk '/^Uid:/ {print $2}' "/proc/$qemu_control_pid/status"; else echo missing; fi
  printf 'ROOT_FS='; findmnt -n -o FSTYPE /
  printf 'PID1='; ps -p 1 -o comm= | tr -d ' '
  printf 'SYSTEMD='; systemctl is-system-running
  printf 'LOGIND='; systemctl is-active systemd-logind
  printf 'NETWORKD='; systemctl is-active systemd-networkd
  printf 'RESOLVED='; systemctl is-active systemd-resolved
  printf 'MEM_TOTAL_KB='; awk '/MemTotal/ {print $2}' /proc/meminfo
  printf 'MEM_AVAILABLE_KB='; awk '/MemAvailable/ {print $2}' /proc/meminfo
  printf 'RUNNING_SERVICES='; systemctl list-units --type=service --state=running --no-legend | wc -l
  printf 'PACKAGE_COUNT='; pacman --config /dev/null -Q | wc -l
  printf 'GRAPHICS_USER_UID='; id -u seyrix
  printf 'GRAPHICS_USER_GROUPS='; id -nG seyrix
  printf 'GPU_MODULES='; lsmod | grep -E 'virtio_gpu|virtio_pci' || true
  printf 'DRM_DEVICE='; ls -l /dev/dri/card* 2>&1
  printf 'DRM_DRIVER_LINKS_BEGIN\n'
  for sys_card in /sys/class/drm/card[0-9]*; do
    if [[ -e "$sys_card/device/driver" ]]; then printf '%s=' "${sys_card##*/}"; readlink -f "$sys_card/device/driver"; fi
  done
  printf 'DRM_DRIVER_LINKS_END\n'
  printf 'PCI_INVENTORY_BEGIN\n'; lspci -nn
  printf 'PCI_INVENTORY_END\n'
  printf 'PCI_GPU='; lspci -nn | grep -Ei 'VGA|Display|3D' | head -1
  printf 'INPUT_DEVICE_HANDLERS_BEGIN\n'; grep -E '^N: Name=|^H: Handlers=' /proc/bus/input/devices
  printf 'INPUT_DEVICE_HANDLERS_END\n'
  printf 'INPUT_EVENT_COUNT='; find /dev/input -maxdepth 1 -type c -name 'event*' 2>/dev/null | wc -l
  if find /dev/input -maxdepth 1 -type c -name 'event*' 2>/dev/null | grep -q .; then echo INPUT_DEVICE_CHECK=passed; else echo INPUT_DEVICE_CHECK=failed; fi
  supported_drm_driver=0
  for sys_card in /sys/class/drm/card[0-9]*; do
    driver_path=$(readlink -f "$sys_card/device/driver" 2>/dev/null || true)
    driver_name=${driver_path##*/}
    printf 'DRM_DRIVER %s=%s\n' "${sys_card##*/}" "${driver_name:-missing}"
    if [[ "$driver_name" == bochs-drm || "$driver_name" == bochs_drm ]] ||
        { [[ "$driver_name" == virtio-pci || "$driver_name" == virtio_gpu ]] && lsmod | grep -Eq '^virtio_gpu '; }; then
      supported_drm_driver=1
    fi
  done
  if compgen -G '/dev/dri/card[0-9]*' >/dev/null && [[ "$supported_drm_driver" -eq 1 ]]; then echo GRAPHICS_DEVICE_CHECK=passed; else echo GRAPHICS_DEVICE_CHECK=failed; fi
  printf 'SEYRIX_GRAPHICS_CHECK_END\n'
}
send -- "$baseline_command\r"
foreach {label pattern} {
    login_user {LOGIN_USER=seyrix}
    kernel {KERNEL=[0-9]+\.[0-9]+}
    qemu_control_service {QEMU_CONTROL_SERVICE_STATE=active}
    qemu_control_uid {QEMU_CONTROL_SERVICE_UID=1000}
    root_fs {ROOT_FS=overlay}
    pid1 {PID1=systemd}
    systemd {SYSTEMD=running}
    logind {LOGIND=active}
    networkd {NETWORKD=active}
    resolved {RESOLVED=active}
    memory {MEM_TOTAL_KB=[1-9][0-9]+}
    services {RUNNING_SERVICES=[1-9][0-9]*}
    packages {PACKAGE_COUNT=[1-9][0-9]*}
    graphics_user {GRAPHICS_USER_UID=[1-9][0-9]*}
    drm_device {DRM_DEVICE=.*}
    pci_inventory {PCI_INVENTORY_END}
    pci_gpu {PCI_GPU=.*}
    input_events {INPUT_EVENT_COUNT=[0-9]+}
} {
    expect {
        -re $pattern {}
        timeout {
            puts stderr "Missing graphics boot verification output for $label."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before graphics boot verification for $label."
            exit 1
        }
    }
}
expect {
    -re {INPUT_DEVICE_CHECK=passed} {}
    -re {INPUT_DEVICE_CHECK=failed} {
        puts stderr "The guest did not expose input event devices. See INPUT_EVENT_COUNT in test.log."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for the guest input device check."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the guest input device check."
        exit 1
    }
}
expect {
    -re {GRAPHICS_DEVICE_CHECK=passed} {}
    -re {GRAPHICS_DEVICE_CHECK=failed} {
        puts stderr "The guest did not expose a supported DRM device. See GPU_MODULES, PCI_INVENTORY and DRM_DEVICE in test.log."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for the guest DRM device check."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the guest DRM device check."
        exit 1
    }
}
expect {
    -re {SEYRIX_GRAPHICS_CHECK_END} {}
    timeout {
        puts stderr "Timed out waiting for the guest graphics diagnostics to finish."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before graphics diagnostics finished."
        exit 1
    }
}

	if {$video_mode ne ""} {
		set video_cmdline_command "if grep -Fqw -- '$video_mode' /proc/cmdline; then echo PHASE2D3B_VIDEO_CMDLINE=passed; else echo PHASE2D3B_VIDEO_CMDLINE=failed; cat /proc/cmdline; fi"
		run_serial_check $video_cmdline_command {PHASE2D3B_VIDEO_CMDLINE=passed} {PHASE2D3B_VIDEO_CMDLINE=failed} "verify GRUB passed the $requested_resolution mode request to the running kernel" 10
	if {$last_serial_check_result ne "pass"} {
		puts stderr "The running kernel did not receive the requested $requested_resolution DRM mode."
		exit 1
	}
}

qmp_hmp $qmp "screendump $run_dir/tty1-login-screen.ppm"
qmp_type $qmp "\n"
set tty_ready_command {for n in $(seq 1 20); do test -f /home/seyrix/.tty1-ready && break; sleep 1; done; printf 'TTY1_MARKER='; test -f /home/seyrix/.tty1-ready && echo present || echo missing; printf 'TTY1_SESSION_INFO='; cat /home/seyrix/.tty1-session-info 2>/dev/null || echo missing; printf 'TTY1_GETTY_ACTIVE='; systemctl is-active getty@tty1; printf 'TTY1_GETTY_EXEC='; systemctl show -p ExecStart getty@tty1; printf 'SEYRIX_PROCESSES='; pgrep -a -u 1000 || true; printf 'TTY1_GETTY_STATUS_BEGIN\n'; systemctl status getty@tty1 --no-pager --full || true; printf 'TTY1_GETTY_STATUS_END\n'; printf 'TTY1_JOURNAL_BEGIN\n'; journalctl -b -u getty@tty1 --no-pager -n 30; printf 'TTY1_JOURNAL_END\n'; printf 'LOGINCTL_SESSIONS_BEGIN\n'; loginctl list-sessions --no-legend; printf 'LOGINCTL_SESSIONS_END\n'; if test -f /home/seyrix/.tty1-ready; then echo TTY1_DEV_SESSION_READY=passed; else echo TTY1_DEV_SESSION_READY=failed; fi}
send -- "$tty_ready_command\r"
expect {
    -re {TTY1_DEV_SESSION_READY=passed} {}
    -re {TTY1_DEV_SESSION_READY=failed} {
        puts stderr "The development-only tty1 login did not become ready. See TTY1_GETTY and SEYRIX_PROCESSES in test.log."
        exit 1
    }
    timeout {
        puts stderr "Timed out waiting for the development-only tty1 login."
        exit 1
    }
    eof {
        puts stderr "QEMU exited before the tty1 login became ready."
        exit 1
    }
}

set input_device_command {mouse_event="$(awk '/^N: Name="QEMU QEMU USB Tablet"/ { found=1; next } found && /^H: Handlers=/ { if (match($0, /event[0-9]+/)) { print substr($0, RSTART, RLENGTH); exit } }' /proc/bus/input/devices)"; if [[ "$mouse_event" =~ ^event[0-9]+$ ]]; then echo "MOUSE_DEVICE=$mouse_event"; else echo MOUSE_DEVICE=missing; fi}
set input_device_result [run_serial_capture $input_device_command {MOUSE_DEVICE=(event[0-9]+)} {MOUSE_DEVICE=missing} "identify the QEMU USB tablet event device" 10]
if {[lindex $input_device_result 0] ne "pass"} {
    puts stderr "Could not identify the QEMU USB tablet event device."
    exit 1
}
set input_device_event [lindex $input_device_result 1]
if {!$phase2d2} {
	set input_monitor_command "nohup timeout 900s evtest /dev/input/$input_device_event >/tmp/seyrix-evtest-mouse.log 2>&1 </dev/null & echo MOUSE_MONITOR_STARTED=passed"
	run_serial_check $input_monitor_command {MOUSE_MONITOR_STARTED=passed} {MOUSE_MONITOR_STARTED=failed} "start the QEMU USB tablet event recorder" 10
}

qmp_key_chord $qmp {ctrl alt} f1
after 1000
set tty_switch_command {printf 'TTY_BEFORE_SWITCH='; cat /sys/class/tty/tty0/active; printf 'TTY_ACTIVE_AFTER_SWITCH='; cat /sys/class/tty/tty0/active; printf '\n'}
send -i $qemu_spawn_id -- "$tty_switch_command\r"
expect {
    -re {TTY_ACTIVE_AFTER_SWITCH=tty1} {}
    timeout {
        puts stderr "Could not switch the active virtual terminal to Seyrix tty1."
        exit 1
    }
    eof {
        puts stderr "QEMU exited while switching to Seyrix tty1."
        exit 1
    }
}
if {$phase2b} {
    qmp_hmp $qmp "screendump $run_dir/tty1-before-seyrix.ppm"
    if {$phase2d2} {
		set test_app_command {install -d /home/seyrix/.local/share/applications /home/seyrix/.local/bin && printf '%s\n' '#!/usr/bin/env bash' 'cd /tmp/seyrix-second' 'exec /usr/bin/weston-terminal' > /home/seyrix/.local/bin/seyrix-acceptance-terminal-second && chmod 755 /home/seyrix/.local/bin/seyrix-acceptance-terminal-second && printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Acceptance Terminal' 'Exec=/usr/bin/weston-terminal' 'TryExec=/usr/bin/weston-terminal' 'Icon=utilities-terminal' 'Categories=Utility;' > /home/seyrix/.local/share/applications/seyrix-acceptance.desktop && printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Acceptance Terminal Backup' 'Exec=/home/seyrix/.local/bin/seyrix-acceptance-terminal-second' 'TryExec=/home/seyrix/.local/bin/seyrix-acceptance-terminal-second' 'Icon=utilities-terminal' 'Categories=Utility;' > /home/seyrix/.local/share/applications/seyrix-acceptance-backup.desktop && printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Missing Acceptance App' 'Exec=/usr/bin/seyrix-missing-app' 'TryExec=/usr/bin/seyrix-missing-app' 'Icon=utilities-terminal' 'Categories=Utility;' > /home/seyrix/.local/share/applications/seyrix-acceptance-missing.desktop && echo PHASE2D2_TEST_APPS=installed}
		run_serial_check $test_app_command {PHASE2D2_TEST_APPS=installed} {PHASE2D2_TEST_APPS=failed} "install two unprivileged temporary XDG launcher entries" 20
		if {$settings_ipc_only} {
			set production_settings_entry_command {rm -f /home/seyrix/.local/share/applications/seyrix-settings.desktop; entry=/usr/share/applications/seyrix-settings.desktop; if grep -Fxq 'Exec=seyrix-settings-launch' "$entry" && grep -Fxq 'TryExec=seyrix-settings-launch' "$entry"; then echo SETTINGS_PRODUCTION_ENTRY=passed; else echo SETTINGS_PRODUCTION_ENTRY=failed; fi}
			run_serial_check $production_settings_entry_command {SETTINGS_PRODUCTION_ENTRY=passed} {SETTINGS_PRODUCTION_ENTRY=failed} "use the packaged Settings entry through the production session supervisor" 10
			if {$last_serial_check_result ne "pass"} { exit 1 }
		}
	}
    if {$phase2c} {
        set wm_config_home "/tmp/seyrix-wm-config-$qemu_identity"
		set wm_probe_config_command "mkdir -p $wm_config_home/seyrix && chmod 755 $wm_config_home $wm_config_home/seyrix && printf 'version=1\\ndefault_mode=hybrid\\napp_id.7365797269782e706861736532632d70726f6265=floating\\n' > $wm_config_home/seyrix/window-management.conf && chmod 644 $wm_config_home/seyrix/window-management.conf && echo WM_TEST_CONFIG=ready"
        run_serial_check $wm_probe_config_command {WM_TEST_CONFIG=ready} {WM_TEST_CONFIG=failed} "prepare explicit floating rule for the Phase 2C state-cycle probe" 20
    }
    set compositor_launch_command "start-seyrix"
    if {$phase2d3b} {
        set compositor_launch_command "SEYRIX_SETTINGS_RENDER_TRACE=1 $compositor_launch_command"
    }
    if {$sanitizers_enabled} {
        set compositor_launch_command "SEYRIX_SETTINGS_RENDER_TRACE=1 ASAN_OPTIONS=detect_leaks=1 UBSAN_OPTIONS=halt_on_error=1 start-seyrix"
    }
    if {$settings_ipc_only} {
        set compositor_launch_command "SEYRIX_SETTINGS_IPC_TRACE=1 $compositor_launch_command"
    }
    if {$settings_render_diagnostic || $settings_ipc_only} {
        set compositor_launch_command "WAYLAND_DEBUG=client $compositor_launch_command"
    }
    if {$phase2c} {
        set compositor_launch_command "XDG_CONFIG_HOME=$wm_config_home $compositor_launch_command"
    }
    if {$renderer_request ne ""} {
        set compositor_launch_command "WLR_RENDERER=$renderer_request $compositor_launch_command"
    }
    if {$settings_ipc_only} {
        set ipc_trace_launcher_lines [list {#!/usr/bin/env bash}]
        lappend ipc_trace_launcher_lines {export SEYRIX_SETTINGS_RENDER_TRACE=1}
        lappend ipc_trace_launcher_lines {export SEYRIX_SETTINGS_IPC_TRACE=1}
        lappend ipc_trace_launcher_lines {export WAYLAND_DEBUG=client}
        lappend ipc_trace_launcher_lines "export XDG_CONFIG_HOME=$wm_config_home"
        if {$renderer_request ne ""} {
            lappend ipc_trace_launcher_lines "export WLR_RENDERER=$renderer_request"
        }
        if {$sanitizers_enabled} {
            lappend ipc_trace_launcher_lines {export ASAN_OPTIONS=detect_leaks=1}
            lappend ipc_trace_launcher_lines {export UBSAN_OPTIONS=halt_on_error=1}
        }
        lappend ipc_trace_launcher_lines {exec start-seyrix}
        set ipc_trace_launcher_command "cat > /tmp/seyrix-ipc-launch <<'SEYRIX_IPC_LAUNCH'\n[join $ipc_trace_launcher_lines \n]\nSEYRIX_IPC_LAUNCH\nchmod 755 /tmp/seyrix-ipc-launch && echo SETTINGS_IPC_LAUNCHER=ready"
        run_serial_check $ipc_trace_launcher_command {SETTINGS_IPC_LAUNCHER=ready} {SETTINGS_IPC_LAUNCHER=failed} "prepare short Settings IPC launch command" 10
        if {$last_serial_check_result ne "pass"} { exit 1 }
        set compositor_launch_command {bash /tmp/seyrix-ipc-launch}
    }
    qmp_type $qmp $compositor_launch_command
    set compositor_command_started [clock milliseconds]
    qmp_key_transition $qmp ret 1
    after 80
    qmp_key_transition $qmp ret 0
    after 2000
    qmp_hmp $qmp "screendump $run_dir/tty1-after-seyrix-command.ppm"

    puts "STAGE_BEGIN name={Seyrix compositor and shell graphical readiness} timeout_s=70"
    set compositor_ready_command {for n in $(seq 1 60); do compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1); runtime=/run/user/1000; socket=; if [[ -n "$compositor_pid" ]]; then tr '\0' '\n' <"/proc/$compositor_pid/environ" | grep -Fxq 'XDG_RUNTIME_DIR=/run/user/1000' || compositor_pid=; fi; for candidate in "$runtime"/wayland-*; do [[ -S "$candidate" ]] && socket="$candidate" && break; done; if [[ -n "$compositor_pid" && -n "$socket" ]] && grep -q 'SEYRIX_COMPOSITOR_READY=1' /tmp/seyrix-compositor.log 2>/dev/null && grep -q 'Layer shell surface mapped namespace=seyrix-panel' /tmp/seyrix-compositor.log 2>/dev/null && pgrep -u 1000 -x seyrix-shell >/dev/null && timeout 5s env XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY="${socket##*/}" wlr-randr >/dev/null 2>&1; then break; fi; sleep 1; done; session_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1); display="${socket##*/}"; uid=$(awk '/^Uid:/ {print $2}' "/proc/$session_pid/status" 2>/dev/null || true); exe=$(readlink -f "/proc/$session_pid/exe" 2>/dev/null || true); state=$(awk '/^State:/ {print $2}' "/proc/$session_pid/status" 2>/dev/null || true); socket_meta=$(stat -c '%U:%G:%a' "$socket" 2>/dev/null || true); runtime_meta=$(stat -c '%U:%G:%a' "$runtime" 2>/dev/null || true); socket_mode="${socket_meta##*:}"; safe_socket=0; if [[ "$socket_meta" == seyrix:seyrix:* && "$socket_mode" =~ ^[0-7]{3,4}$ && "$runtime_meta" == seyrix:seyrix:700 ]] && (( (8#$socket_mode & 0200) != 0 && (8#$socket_mode & 0022) == 0 )); then safe_socket=1; fi; if [[ "$safe_socket" -eq 1 ]]; then echo WAYLAND_SOCKET_PERMISSIONS=passed; else echo WAYLAND_SOCKET_PERMISSIONS=failed; fi; shell_pid=$(pgrep -u 1000 -x seyrix-shell | head -n 1); printf 'GRAPHICAL_SESSION pid=%s uid=%s exe=%s state=%s runtime=%s socket=%s socket_owner_mode=%s runtime_owner_mode=%s shell_pid=%s\n' "${session_pid:-missing}" "${uid:-missing}" "${exe:-missing}" "${state:-missing}" "$runtime" "${socket:-missing}" "${socket_meta:-missing}" "${runtime_meta:-missing}" "${shell_pid:-missing}"; if [[ -n "$session_pid" && "$uid" == 1000 && "$exe" == /usr/bin/seyrix-compositor && "$state" != Z && "$state" != X && "$safe_socket" -eq 1 && -n "$shell_pid" ]] && timeout 5s env XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY="$display" wlr-randr >/dev/null 2>&1; then echo COMPOSITOR_READY=passed; echo WAYLAND_SOCKET_CONNECTED=passed; else echo COMPOSITOR_READY=failed; cat /tmp/seyrix-compositor.log 2>/dev/null || true; tail -n 40 /tmp/seyrix-weston-gl.log /tmp/seyrix-weston-pixman.log 2>/dev/null || true; fi; printf 'WLROOTS_PACKAGE='; pacman -Q wlroots0.20; printf 'COMPOSITOR_PROCESSES='; pgrep -a -u 1000 -f '^/usr/bin/seyrix-compositor$' || true; printf 'COMPOSITOR_RSS_KB='; if [[ -n "$session_pid" ]]; then awk '/VmRSS:/ {print $2}' "/proc/$session_pid/status"; else echo unavailable; fi; printf 'SHELL_PROCESSES='; pgrep -a -u 1000 -x seyrix-shell || true; printf 'COMPOSITOR_LOG_END\n'}
    send -- "$compositor_ready_command\r"
    set compositor_ready 0
    expect {
    -re {COMPOSITOR_READY=passed} {
            set compositor_ready 1
        }
        -re {COMPOSITOR_READY=failed} {set compositor_ready 0}
        timeout {
            puts stderr "Timed out waiting for Seyrix compositor startup."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before the Seyrix compositor became ready."
            exit 1
        }
    }
    expect {
        -re {COMPOSITOR_LOG_END} {}
        timeout {
            puts stderr "Timed out collecting Seyrix compositor startup diagnostics."
            exit 1
        }
        eof {
            puts stderr "QEMU exited before compositor diagnostics were collected."
            exit 1
        }
    }
    if {!$compositor_ready} {
        puts stderr "STAGE_RESULT name={Seyrix compositor and shell graphical readiness} result=FAIL"
        puts stderr "Seyrix compositor did not start or create a Wayland socket."
        exit 1
    }
    puts "GRAPHICAL_READY=passed"
    puts "STAGE_RESULT name={Seyrix compositor and shell graphical readiness} result=PASS"
    if {$phase2c || $phase2d2} {
        set guest_helper [file join [file dirname [file normalize [info script]]] qemu-guest-helper.sh]
        install_guest_helper $guest_helper
        set run_identity_path "/tmp/seyrix-qemu-test-run-id-$qemu_identity"
		set run_identity_command "touch $run_identity_path; if test -e $run_identity_path; then echo QEMU_TEST_RUN_ID=passed; else echo QEMU_TEST_RUN_ID=failed; fi"
        run_serial_check $run_identity_command \
			{QEMU_TEST_RUN_ID=passed} \
            {QEMU_TEST_RUN_ID=failed} "record current QEMU test identity" 10
    }
    set compositor_startup_ms [expr {[clock milliseconds] - $compositor_command_started}]
    puts "COMPOSITOR_STARTUP_MS=$compositor_startup_ms"
    puts "APPLICATION_LAUNCH=passed"
    set graphics_ms [expr {[clock milliseconds] - $boot_started}]
    puts "GRAPHICAL_BOOT_MS=$graphics_ms"
    if {$sanitizer_only} {
        qmp_hmp $qmp "screendump $run_dir/graphical-ready.ppm"
        puts "STAGE_RESULT name={full Phase 2D.3B acceptance} result=INCOMPLETE reason=sanitizer-only"
        qmp_key_chord $qmp {meta_l shift} q
        set sanitizer_shutdown_command {for n in $(seq 1 60); do if ! pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null; then break; fi; sleep 1; done; if ! pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' >/dev/null && systemctl is-active --quiet getty@tty1 && pgrep -a -u 1000 | grep -Eq ' [-]?bash$' && grep -q 'Seyrix compositor stopped cleanly' /tmp/seyrix-compositor.log && ! grep -q 'No outputs remain; stopping compositor' /tmp/seyrix-compositor.log; then echo COMPOSITOR_EXIT=passed; else echo COMPOSITOR_EXIT=failed; fi}
        run_serial_check $sanitizer_shutdown_command {COMPOSITOR_EXIT=passed} {COMPOSITOR_EXIT=failed} "stop instrumented compositor and verify return to tty1" 75
        set sanitizer_shutdown_result $last_serial_check_result

        set sanitizer_log_command {printf 'COMPOSITOR_SANITIZER_LOG_BEGIN\n'; if grep -Eq 'AddressSanitizer:|LeakSanitizer:|runtime error:' /tmp/seyrix-compositor.log; then cat /tmp/seyrix-compositor.log; echo SANITIZER_FINDINGS=present; else tail -n 50 /tmp/seyrix-compositor.log 2>/dev/null || true; echo SANITIZER_FINDINGS=none; fi; printf 'COMPOSITOR_SANITIZER_LOG_END\n'}
        run_serial_check $sanitizer_log_command {SANITIZER_FINDINGS=none} {SANITIZER_FINDINGS=present} "Mesa EGL compositor sanitizer diagnostic" 20
        set sanitizer_findings $last_serial_check_result

        finish_guest_shutdown $qmp "clean guest shutdown after sanitizer diagnostic" 45
        if {$sanitizer_shutdown_result ne "pass" || $sanitizer_findings ne "pass"} {
            exit 1
        }
        exit 0
    }
    if {[info exists env(SEYRIX_QEMU_READINESS_ONLY)] &&
            $env(SEYRIX_QEMU_READINESS_ONLY) eq "1"} {
        qmp_hmp $qmp "screendump $run_dir/graphical-ready.ppm"
        puts "STAGE_RESULT name={full Phase 2D.3B acceptance} result=INCOMPLETE reason=readiness-only"
        finish_guest_shutdown $qmp "clean guest shutdown after graphical readiness" 45
        exit 0
    }
	if {$phase2d2} {
		set timeout 240
		set shell_ready_command {mkdir -p /tmp/seyrix-first /tmp/seyrix-second; shell_pid=$(pgrep -u 1000 -x seyrix-shell | head -n 1); terminal_pid=$(pgrep -u 1000 -x weston-terminal | head -n 1); shell_uid=$(test -n "$shell_pid" && awk '/^Uid:/ {print $2}' "/proc/$shell_pid/status"); printf 'PHASE2D2_SHELL_PID=%s\nPHASE2D2_SHELL_UID=%s\n' "$shell_pid" "$shell_uid"; if [[ -n "$shell_pid" && "$shell_uid" == 1000 && -n "$terminal_pid" && -r /usr/share/seyrix/Manual.txt ]]; then echo PHASE2D2_SHELL_READY=passed; else echo PHASE2D2_SHELL_READY=failed; fi}
		run_serial_check $shell_ready_command {PHASE2D2_SHELL_READY=passed} {PHASE2D2_SHELL_READY=failed} "verify native shell and terminal run as the seyrix user" 20
		if {$phase2d3b} {
			set settings_probe_apps_command {mkdir -p /home/seyrix/.local/share/applications && printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Seyrix IPC Read Probe' 'Exec=env XDG_RUNTIME_DIR=/run/user/1000 SEYRIX_SETTINGS_PROBE_LOG=/tmp/seyrix-settings-endpoint-probe.log SEYRIX_SETTINGS_PROBE_TRACE=1 /usr/lib/seyrix-tests/settings-endpoint-probe' 'TryExec=/usr/lib/seyrix-tests/settings-endpoint-probe' 'Icon=preferences-system' 'Categories=System;' > /home/seyrix/.local/share/applications/seyrix-settings-ipc-probe.desktop && printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Seyrix IPC Change Watch' 'Exec=env XDG_RUNTIME_DIR=/run/user/1000 SEYRIX_SETTINGS_PROBE_LOG=/tmp/seyrix-settings-subscription.log SEYRIX_SETTINGS_PROBE_TRACE=1 /usr/lib/seyrix-tests/settings-endpoint-probe --watch-change' 'TryExec=/usr/lib/seyrix-tests/settings-endpoint-probe' 'Icon=preferences-system' 'Categories=System;' > /home/seyrix/.local/share/applications/seyrix-settings-ipc-watch.desktop && echo SETTINGS_PROBE_APPS=installed}
			run_serial_check $settings_probe_apps_command {SETTINGS_PROBE_APPS=installed} {SETTINGS_PROBE_APPS=failed} "install same-session read-only endpoint probe launchers before shell reinitialization" 10
			set settings_fd_probe_install_command {
mkdir -p /home/seyrix/.local/bin /home/seyrix/.local/share/applications
cat > /home/seyrix/.local/bin/seyrix-settings-endpoint-fd-probe <<'EOF'
#!/usr/bin/env bash
set -u
log=/tmp/seyrix-settings-endpoint-fd-stability.log
exec >"$log" 2>&1
compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1)
settings_pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
compositor_sid=$(ps -o sid= -p "$compositor_pid" 2>/dev/null | tr -d ' ')
probe_sid=$(ps -o sid= -p "$$" 2>/dev/null | tr -d ' ')
probe_uid=$(id -u)
# GTK and shell shared-memory buffers change independently of IPC socket cleanup.
fd_count() { find "/proc/$compositor_pid/fd" -maxdepth 1 -type l -lname 'socket:*' 2>/dev/null | wc -l; }
printf 'SETTINGS_ENDPOINT_FD_SESSION uid=%s sid=%s compositor_sid=%s compositor_pid=%s settings_pid=%s\n' "$probe_uid" "$probe_sid" "$compositor_sid" "$compositor_pid" "$settings_pid"
if [[ "$probe_uid" != 1000 || -z "$compositor_pid" || "$probe_sid" != "$compositor_sid" || -z "$settings_pid" ]]; then echo SETTINGS_ENDPOINT_FD_SESSION=failed; echo SETTINGS_ENDPOINT_FD_STABILITY=failed reason=wrong-session; exit 1; fi
echo SETTINGS_ENDPOINT_FD_SESSION=passed
baseline=$(fd_count)
stable=0
for wait_index in $(seq 1 30); do
  current=$(fd_count)
  if [[ "$current" == "$baseline" ]]; then stable=$((stable + 1)); else baseline=$current; stable=1; fi
  [[ "$stable" -ge 3 ]] && break
  sleep 0.1
done
printf 'SETTINGS_ENDPOINT_FD_BASELINE compositor_pid=%s fds=%s\n' "$compositor_pid" "$baseline"
if [[ "$stable" -lt 3 ]]; then echo SETTINGS_ENDPOINT_FD_STABILITY=failed reason=unstable-baseline; exit 1; fi
failures=0
for cycle in $(seq 1 10); do
  probe_log="/tmp/seyrix-settings-endpoint-fd-$cycle.log"
  probe_stdout="$probe_log.stdout"
  if timeout 20s env XDG_RUNTIME_DIR=/run/user/1000 SEYRIX_SETTINGS_PROBE_TRACE=1 SEYRIX_SETTINGS_PROBE_LOG="$probe_log" /usr/lib/seyrix-tests/settings-endpoint-probe >"$probe_stdout" 2>&1 && grep -Fxq SETTINGS_ENDPOINT_PROBE=passed "$probe_log"; then probe=passed; else probe=failed; failures=$((failures + 1)); cat "$probe_stdout" "$probe_log" 2>/dev/null || true; fi
  stable=0
  after=missing
  mismatch_recorded=0
  samples=""
  for wait_index in $(seq 1 30); do
    after=$(fd_count)
    samples="${samples}${samples:+,}${after}"
    if [[ "$after" == "$baseline" ]]; then stable=$((stable + 1)); else stable=0; fi
    if [[ "$after" != "$baseline" && "$mismatch_recorded" == 0 ]]; then
      mismatch_recorded=1
      printf 'SETTINGS_ENDPOINT_FD_MISMATCH cycle=%s baseline=%s observed=%s socket_descriptors=' "$cycle" "$baseline" "$after"
      find "/proc/$compositor_pid/fd" -maxdepth 1 -type l -lname 'socket:*' -printf '%f=%l,' 2>/dev/null | sort -t= -k1,1n | tr -d '\n'
      printf '\n'
    fi
    [[ "$stable" -ge 3 ]] && break
    sleep 0.1
  done
  printf 'SETTINGS_ENDPOINT_FD_CYCLE=%s probe=%s baseline=%s after=%s stable_samples=%s samples=%s\n' "$cycle" "$probe" "$baseline" "$after" "$stable" "$samples"
  grep -E '^SETTINGS_ENDPOINT_(PROBE|HELLO|SNAPSHOT|SUBSCRIPTION|UNSUBSCRIBE|RECONNECT|RECONNECT_SNAPSHOT)=|^SETTINGS_ENDPOINT_PROBE_DETAIL=' "$probe_log" 2>/dev/null || true
  [[ "$probe" == passed && "$after" == "$baseline" && "$stable" -ge 3 ]] || failures=$((failures + 1))
done
if [[ "$failures" == 0 ]]; then echo SETTINGS_ENDPOINT_FD_STABILITY=passed cycles=10; else echo SETTINGS_ENDPOINT_FD_STABILITY=failed cycles=10 failures="$failures"; exit 1; fi
EOF
chmod 755 /home/seyrix/.local/bin/seyrix-settings-endpoint-fd-probe
printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Seyrix IPC FD Stability' 'Exec=/home/seyrix/.local/bin/seyrix-settings-endpoint-fd-probe' 'TryExec=/home/seyrix/.local/bin/seyrix-settings-endpoint-fd-probe' 'Icon=preferences-system' 'Categories=System;' > /home/seyrix/.local/share/applications/seyrix-settings-endpoint-fd.desktop
if test -x /home/seyrix/.local/bin/seyrix-settings-endpoint-fd-probe && grep -Fxq 'Exec=/home/seyrix/.local/bin/seyrix-settings-endpoint-fd-probe' /home/seyrix/.local/share/applications/seyrix-settings-endpoint-fd.desktop; then echo SETTINGS_ENDPOINT_FD_PROBE_INSTALL=passed; else echo SETTINGS_ENDPOINT_FD_PROBE_INSTALL=failed; fi
}
			run_serial_check $settings_fd_probe_install_command {SETTINGS_ENDPOINT_FD_PROBE_INSTALL=passed} {SETTINGS_ENDPOINT_FD_PROBE_INSTALL=failed} "prepare the compositor-session descriptor probe desktop entry before shell reinitialization" 10
			if {$last_serial_check_result ne "pass"} { exit 1 }
		}
		set shell_startup_failure_command {bash /tmp/seyrix-qemu-guest-helper.sh startup-failure}
		run_serial_check $shell_startup_failure_command {PHASE2D2_SHELL_STARTUP_FAILURE_RECOVERY=passed} {QEMU_GUEST_HELPER=failed reason=[^\r\n]*} "recover from a shell executable startup failure during restart" 90
		if {$settings_ipc_only} {
			set shell_fixture_evidence_command {fixture=/run/user/1000/seyrix-qemu-fail-shell-exec-once; consumed=$(grep -F 'SEYRIX_QEMU_ACCEPTANCE_SHELL_EXEC_FAILURE=consumed' /tmp/seyrix-compositor.log || true); retry1=$(grep -F 'Scheduling isolated shell restart attempt 1 in 1000 ms' /tmp/seyrix-compositor.log || true); retry2=$(grep -F 'Scheduling isolated shell restart attempt 2 in 2000 ms' /tmp/seyrix-compositor.log || true); printf 'SHELL_FAULT_FIXTURE path=%s present_after=%s\n' "$fixture" "$(test -e "$fixture" && echo yes || echo no)"; printf '%s\n%s\n%s\n' "$consumed" "$retry1" "$retry2"; if [[ -n "$consumed" && -n "$retry1" && -n "$retry2" && ! -e "$fixture" ]]; then echo SHELL_FAULT_FIXTURE=passed; else echo SHELL_FAULT_FIXTURE=failed; fi}
			run_serial_check $shell_fixture_evidence_command {SHELL_FAULT_FIXTURE=passed} {SHELL_FAULT_FIXTURE=failed} "confirm the packaged shell fault fixture was consumed and triggered the expected restart retries" 10
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The packaged shell fault-injection fixture was not confirmed as consumed."
				exit 1
			}

			qmp_hmp $qmp "screendump $run_dir/settings-ipc-target-desktop-before.ppm"
			qmp_key_chord $qmp {meta_l} q
			set target_close_terminal_command {for n in $(seq 1 30); do if ! pgrep -u 1000 -x weston-terminal >/dev/null; then break; fi; sleep 0.2; done; if ! pgrep -u 1000 -x weston-terminal >/dev/null && pgrep -u 1000 -x seyrix-shell >/dev/null; then echo SETTINGS_IPC_DESKTOP_READY=passed; else echo SETTINGS_IPC_DESKTOP_READY=failed; fi}
			run_serial_check $target_close_terminal_command {SETTINGS_IPC_DESKTOP_READY=passed} {SETTINGS_IPC_DESKTOP_READY=failed} "expose the desktop before launching the real GTK Settings process" 15
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The shell desktop was not ready for the targeted Settings launch."
				exit 1
			}

			qmp_key_chord $qmp {meta_l} spc
			after 500
			qmp_type_slow $qmp "Settings" 400
			after 500
			qmp_key_chord $qmp {} ret
			set target_settings_launch_command {pid=; mapped=; focused=; for n in $(seq 1 240); do pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); if [[ -n "$pid" ]]; then mapped=$(grep -F "Window mapped: pid=$pid " /tmp/seyrix-compositor.log | grep -F 'app_id=org.seyrix.settings title=System Settings' | tail -n 1); focused=$(grep -F "Window focused: pid=$pid " /tmp/seyrix-compositor.log | grep -F 'app_id=org.seyrix.settings title=System Settings' | tail -n 1); [[ -n "$mapped" && -n "$focused" ]] && break; fi; sleep 0.25; done; manager_file=/run/user/1000/seyrix-settings-supervisor.pid; manager=$(cat "$manager_file" 2>/dev/null || true); parent=$(awk '/^PPid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true); manager_exe=$(readlink -f "/proc/$manager/exe" 2>/dev/null || true); compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1); uid=$(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true); sid=$(ps -o sid= -p "$pid" 2>/dev/null | tr -d ' '); compositor_sid=$(ps -o sid= -p "$compositor_pid" 2>/dev/null | tr -d ' '); socket=/run/user/1000/seyrix/settings-v1.sock; supervisor_socket=/run/user/1000/seyrix-settings-supervisor.sock; printf 'SETTINGS_IPC_GTK_PROCESS pid=%s uid=%s parent=%s manager=%s manager_exe=%s sid=%s compositor_sid=%s mapped=%s settings_socket=%s supervisor_socket=%s\n' "${pid:-missing}" "${uid:-missing}" "${parent:-missing}" "${manager:-missing}" "${manager_exe:-missing}" "${sid:-missing}" "${compositor_sid:-missing}" "${mapped:+yes}" "$(stat -c '%u:%g:%a' "$socket" 2>/dev/null || echo missing)" "$(stat -c '%u:%g:%a' "$supervisor_socket" 2>/dev/null || echo missing)"; if [[ -n "$pid" && "$uid" == 1000 && "$parent" == "$manager" && "$manager_exe" == /usr/bin/seyrix-session-supervisor && -n "$mapped" && -n "$focused" && "$sid" == "$compositor_sid" && -S "$socket" && "$(stat -c '%u:%g:%a' "$supervisor_socket" 2>/dev/null)" == 1000:1000:600 ]]; then echo SETTINGS_IPC_GTK_PROCESS=passed; else echo SETTINGS_IPC_GTK_PROCESS=failed; fi}
			run_serial_check $target_settings_launch_command {SETTINGS_IPC_GTK_PROCESS=passed} {SETTINGS_IPC_GTK_PROCESS=failed} "launch the real GTK Settings application from the Seyrix desktop launcher" 90
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The real GTK Settings process did not become visible in the compositor session."
				exit 1
			}
			qmp_hmp $qmp "screendump $run_dir/settings-ipc-target-before-restart.ppm"

			set settings_ipc_event_command {log=/tmp/seyrix-compositor.log; pid=; for attempt in $(seq 1 60); do pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); frames=$(grep -F "Settings endpoint frame peer_pid=$pid " "$log" 2>/dev/null || true); hello=$(printf '%s\n' "$frames" | grep -Eq 'opcode=1 .*negotiated=0' && echo 1 || echo 0); snapshot=$(printf '%s\n' "$frames" | grep -Eq 'opcode=2 .*negotiated=1' && echo 1 || echo 0); subscribe=$(printf '%s\n' "$frames" | grep -Eq 'opcode=3 .*negotiated=1' && echo 1 || echo 0); [[ "$hello" == 1 && "$snapshot" == 1 && "$subscribe" == 1 ]] && break; sleep 0.25; done; accepted=$(grep -F "Settings endpoint accepted peer uid=1000 pid=$pid " "$log" 2>/dev/null | tail -n 1 || true); frames=$(grep -F "Settings endpoint frame peer_pid=$pid " "$log" 2>/dev/null || true); hello=$(printf '%s\n' "$frames" | grep -Eq 'opcode=1 .*negotiated=0' && echo 1 || echo 0); snapshot_request=$(printf '%s\n' "$frames" | sed -nE 's/.*opcode=2 request=([0-9]+) .*/\1/p' | head -n 1); subscribe_request=$(printf '%s\n' "$frames" | sed -nE 's/.*opcode=3 request=([0-9]+) .*/\1/p' | head -n 1); snapshot_response=$(grep -F "Settings endpoint sent peer_pid=$pid opcode=32768 request=$snapshot_request " "$log" 2>/dev/null | tail -n 1 || true); subscribe_response=$(grep -F "Settings endpoint sent peer_pid=$pid opcode=32768 request=$subscribe_request " "$log" 2>/dev/null | tail -n 1 || true); snapshot_revision=$(printf '%s\n' "$snapshot_response" | sed -nE 's/.*revision=([0-9]+).*/\1/p'); subscribe_revision=$(printf '%s\n' "$subscribe_response" | sed -nE 's/.*revision=([0-9]+).*/\1/p'); snapshot_status=$(printf '%s\n' "$snapshot_response" | sed -nE 's/.*response_status=([0-9]+).*/\1/p'); snapshot_to=$(printf '%s\n' "$snapshot_response" | sed -nE 's/.*response_to=([0-9]+).*/\1/p'); subscribe_status=$(printf '%s\n' "$subscribe_response" | sed -nE 's/.*response_status=([0-9]+).*/\1/p'); subscribe_to=$(printf '%s\n' "$subscribe_response" | sed -nE 's/.*response_to=([0-9]+).*/\1/p'); hello=$(printf '%s\n' "$frames" | grep -Eq 'opcode=1 .*negotiated=0' && echo 1 || echo 0); snapshot=$(printf '%s\n' "$frames" | grep -Eq 'opcode=2 .*negotiated=1' && echo 1 || echo 0); subscribe=$(printf '%s\n' "$frames" | grep -Eq 'opcode=3 .*negotiated=1' && echo 1 || echo 0); uid=$(awk '/^Uid:/ {print $2}' "/proc/$pid/status" 2>/dev/null || true); mapped=$(grep -F "Window mapped: pid=$pid " "$log" | grep -F 'app_id=org.seyrix.settings title=System Settings' | tail -n 1 || true); compositor_pid=$(pgrep -u 1000 -f '^/usr/bin/seyrix-compositor$' | head -n 1); compositor_sid=$(ps -o sid= -p "$compositor_pid" 2>/dev/null | tr -d ' '); sid=$(ps -o sid= -p "$pid" 2>/dev/null | tr -d ' '); result=unconfirmed; if [[ -n "$pid" && -n "$accepted" && "$uid" == 1000 && -n "$mapped" && "$sid" == "$compositor_sid" && "$hello" == 1 && "$snapshot" == 1 && "$subscribe" == 1 && -n "$snapshot_request" && -n "$subscribe_request" && -n "$snapshot_response" && -n "$subscribe_response" && "$snapshot_status" == 0 && "$snapshot_to" == 2 && "$subscribe_status" == 0 && "$subscribe_to" == 3 ]]; then result=passed; fi; printf 'SETTINGS_IPC_DIAGNOSTIC_RESULT=%s pid=%s uid=%s sid=%s compositor_pid=%s hello=%s snapshot=%s snapshot_request=%s snapshot_revision=%s subscribe=%s subscribe_request=%s subscribe_revision=%s\n' "$result" "${pid:-missing}" "${uid:-missing}" "${sid:-missing}" "${compositor_pid:-missing}" "$hello" "$snapshot" "${snapshot_request:-missing}" "${snapshot_revision:-missing}" "$subscribe" "${subscribe_request:-missing}" "${subscribe_revision:-missing}"; grep -E "Settings endpoint (accepted peer uid=1000 pid=$pid |frame peer_pid=$pid |sent peer_pid=$pid )" "$log" || true}
			set initial_ipc_result [run_serial_capture $settings_ipc_event_command {SETTINGS_IPC_DIAGNOSTIC_RESULT=(passed|unconfirmed)} {SETTINGS_IPC_DIAGNOSTIC_RESULT=failed} "record HELLO, snapshot response, and subscription for one live GTK Settings PID" 20]
