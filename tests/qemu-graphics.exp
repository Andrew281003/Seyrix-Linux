if [[ "$wx" =~ ^-?[0-9]+$ && "$wy" =~ ^-?[0-9]+$ && "$bx" =~ ^[-0-9.]+$ && "$by" =~ ^[-0-9.]+$ && "$bw" =~ ^[0-9.]+$ && "$bh" =~ ^[0-9.]+$ ]]; then
