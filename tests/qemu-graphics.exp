				set appearance_focus_check_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; baseline=$(cat /tmp/seyrix-settings-keyboard-setup-baseline); delta=$(tail -n +$((baseline + 1)) "$trace"); selected=$(grep -F "pid=$pid event=gtk_sidebar_row_selected page=appearance " <<< "$delta" | tail -n 1); page=$(grep -F "pid=$pid event=gtk_page_selection page=appearance selected=appearance" <<< "$delta" | tail -n 1); mapped_page=$(grep -F "pid=$pid event=gtk_page_bounds page=appearance " <<< "$delta" | tail -n 1); unmapped_page=$(grep -F "pid=$pid event=gtk_page_unmap page=desktop " <<< "$delta" | tail -n 1); printf 'SETTINGS_KEYBOARD_SETUP_ROW=%s\nSETTINGS_KEYBOARD_SETUP_PAGE=%s\nSETTINGS_KEYBOARD_SETUP_MAPPED_PAGE=%s\nSETTINGS_KEYBOARD_SETUP_OUTGOING_PAGE=%s\n' "${selected:-missing}" "${page:-missing}" "${mapped_page:-missing}" "${unmapped_page:-missing}"; if [[ "$selected" == *category_sync_active=0* && "$selected" == *selected_category=appearance* && -n "$page" && "$mapped_page" == *visible=1* && "$mapped_page" == *mapped=1* && "$mapped_page" == *selected=appearance* && "$unmapped_page" == *page=desktop* ]]; then echo SETTINGS_KEYBOARD_APPEARANCE=verified; else echo SETTINGS_KEYBOARD_APPEARANCE=failed; fi}
				run_serial_check $appearance_focus_check_command {SETTINGS_KEYBOARD_APPEARANCE=verified} {SETTINGS_KEYBOARD_APPEARANCE=failed} "verify the pointer restored Appearance before the keyboard transition" 10
				if {$last_serial_check_result ne "pass"} {
					puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=keyboard-start-page-mismatch"
					exit 1
				}
				set appearance_render_trace_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); trace=/tmp/seyrix-compositor.log; baseline=$(cat /tmp/seyrix-settings-keyboard-setup-baseline); compositor_baseline=$(cat /tmp/seyrix-settings-keyboard-setup-compositor-baseline); delta=$(tail -n +$((baseline + 1)) "$trace"); compositor_delta=$(tail -n +$((compositor_baseline + 1)) /tmp/seyrix-compositor.log); printf 'SETTINGS_APPEARANCE_GTK_EVENTS_BEGIN\n'; grep -F "pid=$pid event=gtk_" <<< "$delta" | tail -n 30 || true; printf 'SETTINGS_APPEARANCE_GTK_EVENTS_END\n'; printf 'SETTINGS_APPEARANCE_WL_SURFACE_BEGIN\n'; grep -E 'wl_surface[@#].*(damage|attach|commit|frame)' <<< "$delta" | tail -n 40 || true; printf 'SETTINGS_APPEARANCE_WL_SURFACE_END\n'; printf 'SETTINGS_APPEARANCE_COMPOSITOR_BEGIN\n'; grep -F "pid=$pid " <<< "$compositor_delta" | grep 'SETTINGS_RENDER_TRACE event=' | tail -n 30 || true; printf 'SETTINGS_APPEARANCE_COMPOSITOR_END\n'; echo SETTINGS_APPEARANCE_TRACE_CAPTURE=complete}
				run_serial_check $appearance_render_trace_command {SETTINGS_APPEARANCE_TRACE_CAPTURE=complete} {SETTINGS_APPEARANCE_TRACE_CAPTURE=failed} "capture GTK, Wayland, and compositor state after returning to Appearance" 15
				if {$last_serial_check_result ne "pass"} {
					puts "STAGE_RESULT name={targeted GTK Wayland surface damage and QMP presentation diagnostic} result=INCOMPLETE reason=appearance-render-trace-failed"
					exit 1
				}
			set appearance_restore_pixel_status [catch {exec python3 $render_helper $run_dir/settings-render-appearance.ppm $run_dir/settings-render-keyboard-before.ppm $output_width} appearance_restore_pixel_result]
			if {!$appearance_restore_pixel_status || [string first {SETTINGS_PAGE_SETTLE=unchanged} $appearance_restore_pixel_result] < 0} {
				puts stderr "Appearance was not visible after restoring the sidebar selection. $appearance_restore_pixel_result"
				puts "SETTINGS_RESTORE_APPEARANCE_PIXELS=INCOMPLETE"
