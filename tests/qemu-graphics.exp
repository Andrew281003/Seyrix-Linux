				exit 1
			}
			set settings_window_x [lindex $settings_stable_geometry 1]
			set settings_window_y [lindex $settings_stable_geometry 2]
			set settings_window_width [lindex $settings_stable_geometry 3]
			set settings_window_height [lindex $settings_stable_geometry 4]
			puts "PHASE2D3B_CATEGORY_GEOMETRY=$settings_window_x,$settings_window_y,${settings_window_width}x$settings_window_height"
			set category_matrix_verified {}
			set previous_category appearance
			foreach {category_index page screenshot} {
				0 appearance phase2d3b-appearance.ppm
				1 desktop phase2d3b-desktop-dock.ppm
				2 windows phase2d3b-window-management.ppm
				3 displays phase2d3b-displays.ppm
				4 input phase2d3b-input.ppm
			5 about phase2d3b-about.ppm
			} {
				set page_trace_baseline_command {wc -l < /tmp/seyrix-compositor.log > /tmp/seyrix-settings-page-trace-baseline; echo SETTINGS_PAGE_TRACE_BASELINE=recorded}
				run_serial_check $page_trace_baseline_command {SETTINGS_PAGE_TRACE_BASELINE=recorded} {SETTINGS_PAGE_TRACE_BASELINE=failed} "record GTK trace position before selecting $page" 10
				set page_input_mode mouse
				if {$settings_window_width < 760} {
					if {$category_index == 0} {
						set page_input_mode initial
					} else {
						set page_input_mode keyboard
						set selector_bounds_command {pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1); line=; bounds=; for attempt in $(seq 1 30); do line=$(grep -F "pid=$pid event=gtk_category_selector_bounds page=category-selector " /tmp/seyrix-compositor.log | tail -n 1); bounds=$(sed -nE 's/.* bounds=([-0-9.]+),([-0-9.]+),([-0-9.]+),([-0-9.]+).*/\1 \2 \3 \4/p' <<< "$line"); [[ -n "$bounds" && "$line" == *visible=1* && "$line" == *mapped=1* ]] && break; sleep 0.1; done; if [[ -n "$pid" && -n "$bounds" && "$line" == *visible=1* && "$line" == *mapped=1* ]]; then printf 'SETTINGS_CATEGORY_SELECTOR_BOUNDS=%s\n' "$bounds"; else printf 'SETTINGS_CATEGORY_SELECTOR_TRACE=%s\n' "${line:-missing}"; echo SETTINGS_CATEGORY_SELECTOR_BOUNDS=missing; fi}
						set selector_bounds [run_serial_capture $selector_bounds_command {SETTINGS_CATEGORY_SELECTOR_BOUNDS=([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)} {SETTINGS_CATEGORY_SELECTOR_BOUNDS=missing} "read the mapped GTK category selector before keyboard navigation to $page" 15]
						if {[lindex $selector_bounds 0] ne "pass"} {
							puts stderr "GTK did not expose the mapped compact category selector."
							puts "PHASE2D3B_PAGE_CAPTURE=$page result=INCOMPLETE reason=category-selector-bounds-missing"
							exit 1
						}
						qmp_mouse_click_pixel $qmp \
							[expr {$settings_window_x + round([lindex $selector_bounds 1] + [lindex $selector_bounds 3] / 2.0)}] \
							[expr {$settings_window_y + round([lindex $selector_bounds 2] + [lindex $selector_bounds 4] / 2.0)}] \
							$output_width $output_height
						qmp_key_chord $qmp {} home
						for {set selector_step 0} {$selector_step < $category_index} {incr selector_step} {
							qmp_key_chord $qmp {} down
						}
						qmp_key_chord $qmp {} ret
					}
				} else {
					# Resolve the target row from the current mapped GTK allocation;
					# fixed row spacing caused stale clicks after responsive relayout.
					set row_bounds_command [string map [list @PAGE@ $page] {
pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
line=$(grep -F "pid=$pid event=gtk_sidebar_row_bounds page=@PAGE@ " /tmp/seyrix-compositor.log | tail -n 1)
bounds=$(sed -nE 's/.* bounds=([-0-9.]+),([-0-9.]+),([-0-9.]+),([-0-9.]+).*/\1 \2 \3 \4/p' <<< "$line")
if [[ -n "$pid" && -n "$bounds" ]]; then printf 'SETTINGS_SIDEBAR_ROW=%s\n' "$bounds"; else echo SETTINGS_SIDEBAR_ROW=missing; fi
}]
					set row_bounds [run_serial_capture $row_bounds_command {SETTINGS_SIDEBAR_ROW=([-0-9.]+) ([-0-9.]+) ([-0-9.]+) ([-0-9.]+)} {SETTINGS_SIDEBAR_ROW=missing} "read the current GTK sidebar bounds for $page" 15]
					if {[lindex $row_bounds 0] ne "pass"} {
						puts stderr "GTK did not expose a current mapped sidebar row for $page."
						puts "PHASE2D3B_PAGE_CAPTURE=$page result=INCOMPLETE reason=sidebar-bounds-missing"
						exit 1
					}
					set row_x [lindex $row_bounds 1]
					set row_y [lindex $row_bounds 2]
					set row_width [lindex $row_bounds 3]
					set row_height [lindex $row_bounds 4]
					qmp_mouse_click_pixel $qmp \
						[expr {$settings_window_x + round($row_x + $row_width / 2.0)}] \
						[expr {$settings_window_y + round($row_y + $row_height / 2.0)}] \
						$output_width $output_height
				}
				qmp_mouse_move_pixel $qmp [expr {$output_width - 20}] [expr {$output_height - 20}] $output_width $output_height
				set page_ready 0
				set page_settle_attempt 0
				for {set page_attempt 0} {$page_attempt < 20 && !$page_ready} {incr page_attempt} {
					after 250
					qmp_hmp $qmp "screendump $page_current_screenshot"
					if {![catch {set page_diff [exec python3 $settings_page_helper $previous_page_screenshot $page_current_screenshot $output_width]} page_error]} {
						set page_ready 1
						set page_settle_attempt [expr {$page_attempt + 1}]
					}
				}
				if {!$page_ready} {
					puts stderr "Settings content did not change after selecting category $page. Last page-diff result: $page_error"
					set page_navigation_diagnostic_command [string map [list @PAGE@ $page] {
pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
baseline=$(cat /tmp/seyrix-settings-page-trace-baseline)
fresh=$(tail -n +$((baseline + 1)) /tmp/seyrix-compositor.log)
printf 'SETTINGS_PAGE_NAV_DIAGNOSTIC pid=%s target=@PAGE@\n' "$pid"
grep -E "pid=$pid event=gtk_(sidebar_row_selected|sidebar_row_selected_suppressed|sidebar_row_activated|page_selection|page_map|page_bounds|page_redraw_after_allocation|input_button_press) " <<< "$fresh" | tail -n 20 || true
echo SETTINGS_PAGE_NAV_DIAGNOSTIC=complete
}]
					run_serial_check $page_navigation_diagnostic_command {SETTINGS_PAGE_NAV_DIAGNOSTIC=complete} {SETTINGS_PAGE_NAV_DIAGNOSTIC=failed} "capture GTK selection and visible-stack events after the $page click" 10
					puts "PHASE2D3B_PAGE_CAPTURE=$page result=INCOMPLETE"
					exit 1
				}
				set page_title [dict get [dict create appearance Appearance desktop {Desktop & Dock} windows {Window Management} displays Displays input Input about {About Seyrix}] $page]
				set page_trace_command [string map [list @PAGE@ $page @TITLE@ $page_title @PREVIOUS@ $previous_category @BASELINE@ /tmp/seyrix-settings-page-trace-baseline @INPUT@ $page_input_mode] {
pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
baseline=$(cat @BASELINE@)
fresh=$(tail -n +$((baseline + 1)) /tmp/seyrix-compositor.log)
trace=$fresh
if [[ "@PAGE@" == appearance ]]; then trace=$(cat /tmp/seyrix-compositor.log); fi
selection=$(grep -F "pid=$pid event=gtk_page_selection page=@PAGE@ selected=@PAGE@ " <<< "$trace" | tail -n 1)
mapped=$(grep -F "pid=$pid event=gtk_page_map page=@PAGE@ selected=@PAGE@ " <<< "$trace" | tail -n 1)
bounds=$(grep -F "pid=$pid event=gtk_page_bounds page=@PAGE@ " <<< "$trace" | tail -n 1)
input=0; selected=0; outgoing=1
if [[ "@INPUT@" == mouse ]]; then
  grep -Fq "pid=$pid event=gtk_input_button_press " <<< "$fresh" && input=1
  if [[ "@PAGE@" == appearance ]]; then selected=1
  else grep -Fq "pid=$pid event=gtk_sidebar_row_selected page=@PAGE@ " <<< "$fresh" && selected=1; fi
elif [[ "@INPUT@" == keyboard ]]; then
  selector=$(grep -F "pid=$pid event=gtk_category_selector_changed page=@PAGE@ " <<< "$fresh" | tail -n 1)
  if [[ "$selector" == *category_sync_active=0* ]]; then input=1; selected=1; fi
else
  input=1; selected=1
fi
if [[ "@PAGE@" != appearance ]]; then
  outgoing_event=$(grep -F "pid=$pid event=gtk_page_unmap page=@PREVIOUS@ selected=@PAGE@ " <<< "$fresh" | tail -n 1)
  [[ "$outgoing_event" == *mapped=0* ]] || outgoing=0
fi
printf 'SETTINGS_GTK_PAGE_EVIDENCE page=@PAGE@ title=@TITLE@ input=@INPUT@ input_seen=%s category_selected=%s selection=%s map=%s bounds=%s outgoing_unmap=%s\n' \
  "$input" "$selected" "${selection:+yes}" "${mapped:+yes}" "${bounds:+yes}" "$outgoing"
if [[ -n "$pid" && -n "$selection" && -n "$mapped" && -n "$bounds" && "$input" == 1 && "$selected" == 1 && "$outgoing" == 1 ]] && \
   grep -Fq 'visible_child_title=@TITLE@' <<< "$bounds" && grep -Fq 'selected=@PAGE@' <<< "$bounds" && \
   grep -Fq 'mapped=1' <<< "$bounds" && grep -Fq 'visible=1' <<< "$bounds" && \
   grep -Fq 'bounds_valid=1' <<< "$bounds"; then
  echo SETTINGS_GTK_PAGE_EVIDENCE=passed
else
  input_event=$(grep -F "pid=$pid event=gtk_input_key_press " <<< "$fresh" | tail -n 1)
  selector_event=$(grep -F "pid=$pid event=gtk_category_selector_changed " <<< "$fresh" | tail -n 1)
  printf 'SETTINGS_GTK_PAGE_DIAGNOSTIC page=@PAGE@ input=%s selector=%s\n' "${input_event:-missing}" "${selector_event:-missing}"
  echo SETTINGS_GTK_PAGE_EVIDENCE=failed
  printf 'SETTINGS_GTK_PAGE_TRACE_BEGIN\n%s\nSETTINGS_GTK_PAGE_TRACE_END\n' "$trace" | tail -n 50
fi
}]
				set page_trace_result [run_serial_capture $page_trace_command {SETTINGS_GTK_PAGE_EVIDENCE=passed} {SETTINGS_GTK_PAGE_EVIDENCE=failed} "verify GTK selection, page identity, mapping, bounds, outgoing unmap, and $page input" 25]
				if {[lindex $page_trace_result 0] ne "pass"} {
					puts stderr "GTK trace did not confirm the selected and mapped $page page."
					puts "PHASE2D3B_PAGE_CAPTURE=$page result=INCOMPLETE reason=gtk-trace-evidence-missing"
					exit 1
				}
				set screenshot_path [file normalize [file join $run_dir $screenshot]]
				file copy -force $page_current_screenshot $screenshot_path
				lappend category_matrix_verified $page
				puts "PHASE2D3B_PAGE_CAPTURE=$page RESOLUTION=${output_width}x${output_height} INPUT=$page_input_mode SETTLE_ATTEMPT=$page_settle_attempt $page_diff"
				set previous_page_screenshot $screenshot_path
				set previous_category $page
				if {$page eq "desktop" || $page eq "about"} {
					qmp_mouse_move_pixel $qmp [expr {$settings_window_x + 520}] [expr {$settings_window_y + 280}] $output_width $output_height
					qmp_mouse_wheel $qmp wheel-down 32
					after 400
					qmp_hmp $qmp "screendump $run_dir/phase2d3b-$page-scrolled.ppm"
					qmp_mouse_wheel $qmp wheel-up 32
					after 400
				}
			}
			if {[llength $category_matrix_verified] != 6} {
				puts stderr "The Settings matrix did not verify all six category identities."
				puts "PHASE2D3B_CATEGORY_MATRIX=INCOMPLETE resolution=${output_width}x${output_height} verified=[llength $category_matrix_verified]"
				exit 1
			}
			puts "PHASE2D3B_CATEGORY_MATRIX=PASS resolution=${output_width}x${output_height} categories=[join $category_matrix_verified ,]"
			set output_profile_command {
expected_output=@EXPECTED_OUTPUT@
output_line=$(grep -E 'Output .* active at [0-9]+x[0-9]+' /tmp/seyrix-compositor.log | tail -n 1)
actual_output=$(sed -nE 's/.* active at ([0-9]+x[0-9]+).*/\1/p' <<< "$output_line")
printf 'PHASE2D3B_OUTPUT_PROFILE_EXPECTED=%s ACTUAL=%s\n' "$expected_output" "$actual_output"
if [[ "$actual_output" == "$expected_output" ]]; then
  echo PHASE2D3B_OUTPUT_PROFILE=passed
else
  echo PHASE2D3B_OUTPUT_PROFILE=failed
fi
}
			set output_profile_command [string map [list @EXPECTED_OUTPUT@ $env(SEYRIX_QEMU_EXPECTED_OUTPUT_SIZE)] $output_profile_command]
			run_serial_check $output_profile_command {PHASE2D3B_OUTPUT_PROFILE=passed} {PHASE2D3B_OUTPUT_PROFILE=failed} "verify the active QEMU resolution profile" 15
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The active QEMU output did not match the requested resolution profile."
				exit 1
			}
			set profile_layout_command {
expected_output=@EXPECTED_OUTPUT@
pid=$(pgrep -u 1000 -x seyrix-settings | head -n 1)
geometry=$(grep -E "GEOMETRY_EVIDENCE event=(map|commit|state) pid=$pid " /tmp/seyrix-compositor.log | tail -n 1)
output_line=$(grep -E 'Output .* active at [0-9]+x[0-9]+' /tmp/seyrix-compositor.log | tail -n 1)
rect=$(sed -nE 's/.* x=(-?[0-9]+) y=(-?[0-9]+) width=([0-9]+) height=([0-9]+).*/\1 \2 \3 \4/p' <<< "$geometry")
read -r x y width height <<< "$rect"
output_width=$(sed -nE 's/.* active at ([0-9]+)x([0-9]+).*/\1/p' <<< "$output_line")
output_height=$(sed -nE 's/.* active at ([0-9]+)x([0-9]+).*/\2/p' <<< "$output_line")
accepted=$(grep -F "Window mapped: pid=$pid " /tmp/seyrix-compositor.log | grep -F 'app_id=org.seyrix.settings title=System Settings' | tail -n 1)
focused=$(grep -F "Window focused: pid=$pid " /tmp/seyrix-compositor.log | grep -F 'app_id=org.seyrix.settings title=System Settings' | tail -n 1)
printf 'SETTINGS_PROFILE_GEOMETRY=%s,%s %sx%s OUTPUT=%sx%s EXPECTED=%s\n' "$x" "$y" "$width" "$height" "$output_width" "$output_height" "$expected_output"
if [[ -n "$pid" && -n "$accepted" && -n "$focused" && "$expected_output" == "$output_width"x"$output_height" && "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ && "$width" =~ ^[0-9]+$ && "$height" =~ ^[0-9]+$ && "$output_width" =~ ^[0-9]+$ && "$output_height" =~ ^[0-9]+$ ]] && (( x >= 0 && y >= 0 && x + width <= output_width && y + height <= output_height && width >= 600 && height >= 400 )); then
  echo PHASE2D3B_PROFILE_LAYOUT=passed
else
  echo PHASE2D3B_PROFILE_LAYOUT=failed
fi
}
			set profile_layout_command [string map [list @EXPECTED_OUTPUT@ $env(SEYRIX_QEMU_EXPECTED_OUTPUT_SIZE)] $profile_layout_command]
			run_serial_check $profile_layout_command {PHASE2D3B_PROFILE_LAYOUT=passed} {PHASE2D3B_PROFILE_LAYOUT=failed} "verify Settings remains visible and focused at the active resolution" 15
			if {$last_serial_check_result ne "pass"} {
				puts stderr "Settings was clipped or lost focus at the active QEMU output resolution."
				exit 1
			}
			qmp_hmp $qmp "screendump $run_dir/phase2d3b-about-profile.ppm"
			set output_profile_stability_command {
expected_output=@EXPECTED_OUTPUT@
output_line=$(grep -E 'Output .* active at [0-9]+x[0-9]+' /tmp/seyrix-compositor.log | tail -n 1)
actual_output=$(sed -nE 's/.* active at ([0-9]+x[0-9]+).*/\1/p' <<< "$output_line")
if [[ "$actual_output" == "$expected_output" ]]; then
  echo PHASE2D3B_OUTPUT_PROFILE_STABLE=passed
else
  echo PHASE2D3B_OUTPUT_PROFILE_STABLE=failed
fi
}
			set output_profile_stability_command [string map [list @EXPECTED_OUTPUT@ $env(SEYRIX_QEMU_EXPECTED_OUTPUT_SIZE)] $output_profile_stability_command]
			run_serial_check $output_profile_stability_command {PHASE2D3B_OUTPUT_PROFILE_STABLE=passed} {PHASE2D3B_OUTPUT_PROFILE_STABLE=failed} "confirm the output profile stayed stable during Settings navigation" 15
			if {$last_serial_check_result ne "pass"} {
				puts stderr "The output resolution changed during Settings navigation."
				exit 1
			}
			qmp_hmp $qmp "screendump $run_dir/phase2d3b-about-after-profile.ppm"
			puts "PHASE2D3B_POINTER_KEYBOARD_NAVIGATION=passed"
			puts "STAGE_RESULT name={Settings category, search, and responsive layout} result=PASS"
